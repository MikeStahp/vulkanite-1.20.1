layout(binding = 1) uniform accelerationStructureEXT acc;
// Opt-in Phase 3 debug traversal. Java binds the procedural TLAS here only
// while a procedural visualization is selected; normal lighting still traces acc.
layout(binding = 32) uniform accelerationStructureEXT proceduralDebugAcc;
// Unified Phase 7 production visibility structure. Material/reflection rays keep using acc.
layout(binding = 34) uniform accelerationStructureEXT hybridShadowAcc;

// Phase 4 debug-only counters. The buffer is cleared when comparison mode is
// entered and then accumulates until the mode, world, or pipeline changes.
layout(binding = 33, std430) buffer HybridShadowComparisonBuffer {
    uint shadowComparisonWords[];
};

// Block textures
layout(binding = 3) uniform sampler2D blockTex;
layout(binding = 4) uniform sampler2D blockTexNormal;
layout(binding = 5) uniform sampler2D blockTexSpecular;

layout(set = 1, binding = 0, std430) readonly buffer Quads {
    Quad quads[];
} geometryBuffers[];

// ReSTIR reservoir images are declared by Vulkanite's injected library.

// Final output image - RGBA16F for DLSS HDR compatibility
// DLSS Ray Reconstruction expects floating-point input when IsHDR flag is set
layout(binding = 12, rgba16f) uniform image2D outputImage;
layout(binding = 21, rgba16f) uniform image2D blocklightDetailImage;

struct GpuSectionLight {
    ivec4 posRadiusFlags;
    uvec4 colorEmission;
};

layout(binding = 22, std430) readonly buffer SectionLightTableBuffer {
    uvec4 sectionLightHeader; // x=light count, y=active sections, z=version, w=section-grid records
    GpuSectionLight sectionLightRecords[];
};

layout(binding = 23, std430) readonly buffer SectionLightProbeBuffer {
    ivec4 sectionLightProbeHeader; // x=active pages, y=slot limit, z=version, w=dirty pages at upload
    ivec4 sectionLightProbeRecords[]; // directory records first, then RGB9E5 radiance and R8 confidence pages
};

struct SectionLightProbeRtCacheCell {
    uvec4 packedRadiance0123;
    uvec4 packedRadiance45State;
};

#define SECTION_LIGHT_PROBE_RT_CACHE_EMPTY 0u
#define SECTION_LIGHT_PROBE_RT_CACHE_REVISION 14u
#define SECTION_LIGHT_PROBE_RT_CACHE_ALL_FACE_READY_MASK ((1u << uint(SECTION_LIGHT_PROBE_FACE_COUNT)) - 1u)

layout(binding = 24, std430) coherent buffer SectionLightProbeRtCacheBuffer {
    uvec4 sectionLightProbeRtCacheHeader; // x=active pages, y=slot limit, z=probe version, w=cell count
    SectionLightProbeRtCacheCell sectionLightProbeRtCacheCells[];
};

layout(binding = 25, std430) readonly buffer SectionLightProbeFillRequestBuffer {
    uvec4 sectionLightProbeFillRequestHeader; // x=request count, y=probe version, z=capacity
    ivec4 sectionLightProbeFillRequests[]; // xyz=section origin, w=probe index
};

struct DiffuseRadianceCacheEntry {
    ivec4 key; // xyz=two-block world cell, w=dominant normal axis
    uvec4 payload; // x=RGB9E5 incident radiance, y=state, z=sample count, w=hit distance
};

layout(binding = 26, std430) coherent buffer DiffuseRadianceCacheBuffer {
    uvec4 diffuseRadianceCacheHeader; // x=entry count, y=generation, z=hash probes
    DiffuseRadianceCacheEntry diffuseRadianceCacheEntries[];
};

struct DiffuseRadianceFillRequest {
    ivec4 key;
    vec4 rayOrigin;
};

layout(binding = 27, std430) readonly buffer DiffuseRadianceFillRequestBuffer {
    uvec4 diffuseRadianceFillRequestHeader; // x=request count, y=generation, z=capacity
    DiffuseRadianceFillRequest diffuseRadianceFillRequests[];
};

struct SpecularTransportCacheEntry {
    ivec4 key; // xyz=one-block world cell, w=packed normal/roughness/material buckets
    uvec4 metadata; // x=family (0 reflection, 1 refraction), y=direction/medium detail, w=state
    uvec4 payload; // xy=reflected/refracted RGB9E5, zw=their continuation hit distances
};

layout(binding = 28, std430) coherent buffer SpecularTransportCacheBuffer {
    uvec4 specularTransportCacheHeader; // x=entry count, y=generation, z=hash probes
    SpecularTransportCacheEntry specularTransportCacheEntries[];
};

struct SpecularTransportFillRequest {
    ivec4 key;
    ivec4 metadata;
    vec4 rayOrigin;
};

layout(binding = 29, std430) readonly buffer SpecularTransportFillRequestBuffer {
    uvec4 specularTransportFillRequestHeader; // x=request count, y=generation, z=capacity
    SpecularTransportFillRequest specularTransportFillRequests[];
};

struct SurfaceDirectLightCacheEntry {
    ivec4 key; // xyz=block cell, w=dominant geometric face
    uvec4 metadata; // x=covered lights, y=state, z=last use, w=coverage cursor
    // Three uints per light: stable relative position/emission/radius, RGB,
    // then a 4x4 grid of 2-bit face-sample visibilities. No reorderable table indices.
    uvec4 lightRecords[72];
    // x=four R8 sun visibility samples, y=state, z=direction signature, w=last use
    uvec4 directionalVisibility;
    // x/y=radius-2 geometry/light group versions for the owning section
    uvec4 dependencyVersion;
};

layout(binding = 30, std430) coherent buffer SurfaceDirectLightCacheBuffer {
    uvec4 surfaceDirectLightCacheHeader; // x=entry count, y=generation, z=hash probes
    SurfaceDirectLightCacheEntry surfaceDirectLightCacheEntries[];
};

struct SurfaceDirectLightFillRequest {
    ivec4 key;
    vec4 surfacePosition;
};

layout(binding = 31, std430) readonly buffer SurfaceDirectLightFillRequestBuffer {
    uvec4 surfaceDirectLightFillRequestHeader; // x=request count, y=generation, z=capacity
    SurfaceDirectLightFillRequest surfaceDirectLightFillRequests[];
};

