const uint REFLECTION_COMPARISON_EMISSION = 16u;
const uint REFLECTION_COMPARISON_PBR = 32u;

uint comparisonPixelFlags;
uint reflectionComparisonFlags;
bool reflectionComparisonSampled;
vec3 reflectionComparisonTint;
#endif

void resetMaterialPayload() {
    payload.hitData = vec4(0.0, 0.0, 0.0, -1.0);
    payload.geometryNormal = vec3(0.0);
    payload.shadowTransmission = vec3(1.0);
    payload.ignore_block_id = i16vec2(0);
    payload.material.albedo = vec3(0.0);
    payload.material.F0 = vec3(0.04);
    payload.material.metallic = 0.0;
    payload.material.roughness = 1.0;
    payload.material.subsurface_scattering = 0.0;
    payload.material.emission = vec3(0.0);
    payload.material.normal = vec3(0.0, 1.0, 0.0);
    payload.material.ambientOcclusion = 1.0;
    payload.material.translucent = 1.0;
    payload.material.block_id = i16vec2(0);
    payload.material.light_texture = vec3(0.0);
    payload.wetStrength_global = 0.0;
    payload.wetness_global = 0.0;
    payload.inside_block = false;
    payload.prev_distance = 0.0;
}

#if VULKANITE_COMPILE_DIAGNOSTICS
bool shouldCompareReflectionPrimary() {
    if (pc.debugMode != 11) {
        return false;
    }
    uint sampleLimit = uint(clamp(pc.shadowComparisonSamplingPermille, 1, 1000));
    uint seed = uint(gl_LaunchIDEXT.x)
        ^ (uint(gl_LaunchIDEXT.y) * 0x9e3779b9u)
        ^ (cam.frameId * 0x85ebca6bu);
    seed ^= seed >> 16u;
    seed *= 0x7feb352du;
    seed ^= seed >> 15u;
    return seed % 1000u < sampleLimit;
}

vec3 proceduralIdColor(uint value) {
    vec3 seed = vec3(float(value), float(value ^ 0x9e37u), float(value ^ 0x79b9u));
    return fract(sin(seed * vec3(12.9898, 78.233, 37.719)) * 43758.5453);
}

vec3 proceduralDistanceColor(float distance) {
    float normalized = 1.0 - exp(-max(distance, 0.0) * (1.0 / 32.0));
    return clamp(vec3(
        1.5 - abs(4.0 * normalized - 3.0),
        1.5 - abs(4.0 * normalized - 2.0),
        1.5 - abs(4.0 * normalized - 1.0)), 0.0, 1.0);
}

bool traceProceduralHit(
    vec3 origin,
    vec3 direction,
    float rayMinimum,
    float rayMaximum,
    out float hitDistance,
    out uint brickSize,
    out bool originInsideBrick,
    out bool originInsideSolid,
    out ivec3 sectionCoordinate
) {
    proceduralDebugPayload.worldHitAndDistance = vec4(0.0, 0.0, 0.0, -1.0);
    proceduralDebugPayload.normalAndIds = vec4(0.0);
    proceduralDebugPayload.blockLocalPosition = vec4(0.0);
    traceRayEXT(
        proceduralDebugAcc,
        gl_RayFlagsOpaqueEXT,
        0x02,
        0,
        0,
        2,
        origin,
        rayMinimum,
        direction,
        rayMaximum,
        2);

    hitDistance = proceduralDebugPayload.worldHitAndDistance.w;
    uint metadata = floatBitsToUint(proceduralDebugPayload.blockLocalPosition.w);
    brickSize = metadata & 0xffu;
    originInsideBrick = (metadata & 0x100u) != 0u;
    originInsideSolid = (metadata & 0x200u) != 0u;
    sectionCoordinate = ivec3(floor(proceduralDebugPayload.worldHitAndDistance.xyz / 16.0));
    return hitDistance >= 0.0;
}

float traceProceduralShadowReference(
    vec3 origin,
    vec3 direction,
    float rayMinimum,
    float rayMaximum
) {
    // The standalone procedural TLAS stores record 2 on its instances. The
    // trace-time offset of 3 therefore selects production shadow record 5.
    // Keep this binary path identical to the pre-hybrid Phase 5 shadow leg:
    // assume occlusion, let miss record 1 publish visibility, and never run a
    // closest-hit shader after the exact procedural intersection accepts a hit.
    shadowPayload = 0.0;
    traceRayEXT(
        proceduralDebugAcc,
        gl_RayFlagsOpaqueEXT
            | gl_RayFlagsTerminateOnFirstHitEXT
            | gl_RayFlagsSkipClosestHitShaderEXT,
        0x02,
        3,
        0,
        1,
        origin,
        rayMinimum,
        direction,
        rayMaximum,
        1);
    return shadowPayload;
}

vec3 decodeTerrainPosition(Vertex vertex) {
    return vec3(vertex.position.xyz) * (32.0 / 65536.0) - 8.0;
}

bool reconstructTriangleOwnerCell(
    Quad quad,
    mat4x3 objectToWorld,
    out ivec3 worldCell
) {
    vec3 objectCenter = vec3(0.0);
    bool hasMidBlock = false;
    for (int vertexIndex = 0; vertexIndex < 4; vertexIndex++) {
        ivec3 midBlock = ivec3(quad.vertices[vertexIndex].mid_block);
        hasMidBlock = hasMidBlock || any(notEqual(midBlock, ivec3(0)));
        objectCenter += decodeTerrainPosition(quad.vertices[vertexIndex])
            + vec3(midBlock) * (1.0 / 64.0);
    }
    if (!hasMidBlock) {
        worldCell = ivec3(0);
        return false;
    }

    // Iris stores mid_block as (owning block center - vertex) * 64. Averaging
    // the four independently reconstructed centers removes quantization noise.
    vec3 worldCenter = objectToWorld * vec4(objectCenter * 0.25, 1.0);
    worldCell = ivec3(floor(worldCenter));
    return true;
}

bool proceduralOwnsCell(ivec3 worldCell) {
    float ignoredDistance;
    uint ignoredBrickSize;
    bool ignoredInside;
    bool ignoredInsideSolid;
    ivec3 ignoredSection;
    // The quarter-block ray cannot leave the cell. Starting at its center makes
    // this an occupancy/ownership probe, independent of the original grazing ray.
    return traceProceduralHit(
        vec3(worldCell) + vec3(0.5),
        vec3(1.0, 0.0, 0.0),
        0.001,
        0.25,
        ignoredDistance,
        ignoredBrickSize,
        ignoredInside,
        ignoredInsideSolid,
        ignoredSection);
}

vec3 traceProceduralDebug(vec3 origin, vec3 direction, int debugMode) {
    float ignoredDistance;
    uint ignoredBrickSize;
    bool ignoredInside;
    bool ignoredInsideSolid;
    ivec3 ignoredSection;
    if (!traceProceduralHit(origin, direction, 0.001, 10000.0,
            ignoredDistance, ignoredBrickSize, ignoredInside, ignoredInsideSolid, ignoredSection)) {
        return vec3(0.01, 0.015, 0.025);
    }
    if (debugMode == 3) {
        return proceduralDistanceColor(proceduralDebugPayload.worldHitAndDistance.w);
    }
    if (debugMode == 4) {
        return normalize(proceduralDebugPayload.normalAndIds.xyz) * 0.5 + 0.5;
    }

    uint packedIds = floatBitsToUint(proceduralDebugPayload.normalAndIds.w);
    uint brickId = packedIds & 0xffffu;
    uint localCellId = packedIds >> 16u;
    return proceduralIdColor(debugMode == 5 ? brickId : localCellId);
}

void atomicSaturatingAddComparison(uint word, uint value) {
    uint previous = atomicAdd(shadowComparisonWords[word], value);
    if (previous > 0xffffffffu - value) {
        // Keep the common path at one atomic operation. Overflow is exceptional;
        // racing overflow writers all converge back to the saturated value.
        atomicMax(shadowComparisonWords[word], 0xffffffffu);
        atomicAdd(shadowComparisonWords[COMPARISON_COUNTER_SATURATIONS], 1u);
    }
}

void recordComparisonSection(ivec3 sectionCoordinate) {
    uint hash = uint(sectionCoordinate.x) * 0x8da6b343u
        ^ uint(sectionCoordinate.y) * 0xd8163841u
        ^ uint(sectionCoordinate.z) * 0xcb1ab31fu;
    hash ^= hash >> 16u;
    uint key = hash | 1u;
    for (uint probe = 0u; probe < COMPARISON_SECTION_RECORD_COUNT; probe++) {
        uint slot = (hash + probe) & (COMPARISON_SECTION_RECORD_COUNT - 1u);
        uint base = COMPARISON_SECTION_BASE + slot * COMPARISON_SECTION_RECORD_WORDS;
        uint state = atomicAdd(shadowComparisonWords[base], 0u);
        if (state == key) {
            atomicSaturatingAddComparison(base + 4u, 1u);
            return;
        }
        if (state == 0u && atomicCompSwap(shadowComparisonWords[base], 0u, key) == 0u) {
            shadowComparisonWords[base + 1u] = uint(sectionCoordinate.x);
            shadowComparisonWords[base + 2u] = uint(sectionCoordinate.y);
            shadowComparisonWords[base + 3u] = uint(sectionCoordinate.z);
            shadowComparisonWords[base + 4u] = 1u;
            return;
        }
    }
    atomicSaturatingAddComparison(COMPARISON_SECTION_OVERFLOW, 1u);
}

void recordDistanceMismatchBucket(float difference) {
    uint bucket = difference <= 0.02 ? 0u
        : (difference <= 0.05 ? 1u
        : (difference <= 0.1 ? 2u
        : (difference <= 0.5 ? 3u
        : (difference <= 1.0 ? 4u
        : (difference <= 2.0 ? 5u
        : (difference <= 16.0 ? 6u : 7u))))));
    atomicSaturatingAddComparison(COMPARISON_DISTANCE_BUCKET_BASE + bucket, 1u);
}

bool shouldCompareShadowRay(vec3 rayOrigin, vec3 rayDirection) {
    if (pc.debugMode < 7 || pc.debugMode > 9) {
        return false;
    }
    uint sampleLimit = uint(clamp(pc.shadowComparisonSamplingPermille, 1, 1000));
    uint seed = floatBitsToUint(rayOrigin.x) ^ (floatBitsToUint(rayOrigin.y) * 0x9e3779b9u)
        ^ (floatBitsToUint(rayOrigin.z) * 0x85ebca6bu)
        ^ (floatBitsToUint(rayDirection.x) * 0xc2b2ae35u)
        ^ (floatBitsToUint(rayDirection.y) * 0x27d4eb2du)
        ^ (floatBitsToUint(rayDirection.z) * 0x165667b1u)
        ^ uint(gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x)
        ^ cam.frameId;
    seed ^= seed >> 16u;
    seed *= 0x7feb352du;
    seed ^= seed >> 15u;
    return seed % 1000u < sampleLimit;
}

void recordShadowComparison(
    bool triangleHit,
    float triangleDistance,
    uint materialClass,
    uint triangleOwnershipClass,
    ivec3 triangleOwnerCell,
    vec3 rayOrigin,
    vec3 rayDirection,
    float rayMinimum,
    float rayMaximum
) {
    if (!shouldCompareShadowRay(rayOrigin, rayDirection)) {
        return;
    }

    float proceduralDistance;
    uint brickSize;
    bool originInsideBrick;
    bool originInsideSolid;
    ivec3 proceduralSection;
    bool proceduralHit = traceProceduralHit(
        rayOrigin, rayDirection, rayMinimum, rayMaximum,
        proceduralDistance, brickSize, originInsideBrick, originInsideSolid, proceduralSection);
    vec3 proceduralHitPosition = proceduralDebugPayload.worldHitAndDistance.xyz;
    vec3 proceduralHitNormal = normalize(proceduralDebugPayload.normalAndIds.xyz);
    ivec3 proceduralHitCell = ivec3(floor(
        proceduralHitPosition - proceduralHitNormal * 2.0e-5));

    atomicSaturatingAddComparison(COMPARISON_TOTAL, 1u);
    bool mismatch = false;
    if (triangleHit && proceduralHit) {
        atomicSaturatingAddComparison(COMPARISON_BOTH_HIT, 1u);
        float difference = abs(triangleDistance - proceduralDistance);
        if (originInsideSolid) {
            atomicSaturatingAddComparison(COMPARISON_SOLID_INTERIOR_START, 1u);
            return;
        }
        atomicMax(shadowComparisonWords[COMPARISON_DISTANCE_MAX_BITS], floatBitsToUint(difference));
        atomicSaturatingAddComparison(
            COMPARISON_DISTANCE_SUM_FIXED,
            uint(clamp(round(difference * 64.0), 0.0, 4194303.0)));
        atomicSaturatingAddComparison(COMPARISON_DISTANCE_SAMPLES, 1u);
        if (difference <= pc.shadowComparisonDistanceTolerance) {
            atomicSaturatingAddComparison(COMPARISON_DISTANCE_AGREE, 1u);
        } else {
            atomicSaturatingAddComparison(COMPARISON_DISTANCE_MISMATCH, 1u);
            recordDistanceMismatchBucket(difference);
            comparisonPixelFlags |= COMPARISON_FLAG_DISTANCE_MISMATCH;
            mismatch = true;
        }
    } else if (triangleHit) {
        atomicSaturatingAddComparison(COMPARISON_DANGEROUS_MISS, 1u);
        comparisonPixelFlags |= COMPARISON_FLAG_DANGEROUS_MISS;
        mismatch = true;
    } else if (proceduralHit) {
        atomicSaturatingAddComparison(COMPARISON_EXTRA_HIT, 1u);
        comparisonPixelFlags |= COMPARISON_FLAG_EXTRA_HIT;
        materialClass = 4u;
        mismatch = true;
    } else {
        atomicSaturatingAddComparison(COMPARISON_BOTH_MISS, 1u);
    }

    if (!mismatch) {
        return;
    }

    if (triangleHit) {
        uint ownershipBucket = 2u;
        if (triangleOwnershipClass == 1u) {
            ownershipBucket = 1u;
        } else if (triangleOwnershipClass == 2u) {
            bool owned = proceduralOwnsCell(triangleOwnerCell);
            ownershipBucket = owned ? 0u : 1u;
            if (proceduralHit && owned && any(notEqual(triangleOwnerCell, proceduralHitCell))) {
                // Both are valid solid occluders, but the two paths selected a
                // different caster. This is not a same-surface distance error.
                ownershipBucket = 3u;
            }
        }
        uint mismatchKindOffset = proceduralHit ? 3u : 0u;
        atomicSaturatingAddComparison(
            COMPARISON_OWNERSHIP_BUCKET_BASE + mismatchKindOffset + ownershipBucket,
            1u);
    }

    uint brickBucket = brickSize == 4u ? 0u : (brickSize == 8u ? 1u : (brickSize == 16u ? 2u : 3u));
    atomicSaturatingAddComparison(COMPARISON_BRICK_SIZE_BASE + brickBucket, 1u);
    uint octant = (rayDirection.x < 0.0 ? 1u : 0u)
        | (rayDirection.y < 0.0 ? 2u : 0u)
        | (rayDirection.z < 0.0 ? 4u : 0u);
    atomicSaturatingAddComparison(COMPARISON_OCTANT_BASE + octant, 1u);
    if (originInsideBrick) {
        atomicSaturatingAddComparison(COMPARISON_INSIDE_START, 1u);
    }
    atomicSaturatingAddComparison(COMPARISON_MATERIAL_BASE + min(materialClass, 4u), 1u);
    vec3 mismatchPosition = proceduralHit
        ? proceduralHitPosition
        : rayOrigin + rayDirection * triangleDistance;
    recordComparisonSection(ivec3(floor(mismatchPosition / 16.0)));
}
#endif

bool finiteVec4(vec4 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

bool validHybridSample(vec4 gPos, vec4 gNormalRaw, vec4 gAlbedoRaw, vec4 gMaterialRaw, vec4 gExtraRaw) {
    if (!finiteVec4(gPos) || !finiteVec4(gNormalRaw) || !finiteVec4(gAlbedoRaw) ||
        !finiteVec4(gMaterialRaw) || !finiteVec4(gExtraRaw)) {
        return false;
    }

    float normalLen2 = dot(gNormalRaw.xyz, gNormalRaw.xyz);
    bool hasPosition = gPos.w > 0.0 || dot(gPos.xyz, gPos.xyz) > 0.000001;
    bool hasNormal = normalLen2 > 0.25 && normalLen2 < 4.0;
    bool hasMaterial = gMaterialRaw.a >= 0.0 && gMaterialRaw.a <= 1.5;
    return hasPosition && hasNormal && hasMaterial;
}

vec2 queryFragmentUv(Quad quad, uint primitiveIndex, vec2 barycentrics) {
    bool sideA = (primitiveIndex & 1u) == 0u;
    vec3 bary = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics);
    vec2 uv0 = vec2(quad.vertices[0].block_texture);
    vec2 uv1 = vec2(sideA ? quad.vertices[1].block_texture : quad.vertices[2].block_texture);
    vec2 uv2 = vec2(sideA ? quad.vertices[2].block_texture : quad.vertices[3].block_texture);
    return (uv0 * bary.x + uv1 * bary.y + uv2 * bary.z)
        * (ATLAS_SCALE / 65536.0);
}

float alphaAwareVisibility(vec3 rayOrigin, vec3 rayDirection, float rayDistance) {
#if VULKANITE_COMPILE_DIAGNOSTICS
    bool comparisonPath = pc.debugMode >= 7 && pc.debugMode <= 9;
    bool doubleTraceReferencePath = pc.debugMode == 10;
#else
    const bool comparisonPath = false;
    const bool doubleTraceReferencePath = false;
#endif

    // Inline ray queries expose procedural AABBs only as candidates; they do
    // not execute the SBT intersection shader. Use a pipeline trace for the
    // unified TLAS so record 5 runs the exact brick-local DDA before accepting
    // an opaque voxel hit. Records 3 and 4 retain terrain/entity alpha tests;
    // closest-hit shading is skipped because binary visibility needs only the
    // initial occluded value or miss record 1's visible value.
#if VULKANITE_HYBRID_SHADOW_PIPELINE
    if (!comparisonPath && !doubleTraceReferencePath && pc.hybridShadowEnabled != 0) {
        shadowPayload = 0.0;
        traceRayEXT(
            hybridShadowAcc,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
            0x07,
            0,
            0,
            1,
            rayOrigin,
            0.001,
            rayDirection,
            rayDistance,
            1);
        return shadowPayload;
    }
#endif

    // Triangle-only fallback and comparison reference path. Keeping this on
    // the material TLAS preserves unsupported/disabled-device behavior.
    rayQueryEXT query;
    rayQueryInitializeEXT(query, acc, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
        rayOrigin, 0.001, rayDirection, rayDistance);

    while (rayQueryProceedEXT(query)) {
        uint sbtOffset = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(query, false);
        if (sbtOffset != 0u) {
            rayQueryConfirmIntersectionEXT(query);
            continue;
        }

        uint geometryIndex = nonuniformEXT(
            rayQueryGetIntersectionInstanceCustomIndexEXT(query, false)
            + rayQueryGetIntersectionGeometryIndexEXT(query, false));
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
        Quad quad = geometryBuffers[geometryIndex].quads[primitiveIndex >> 1u];
        float blockId = float(quad.vertices[0].block_id.x);

        if (isWaterMaterial(blockId) || isGlassMaterial(blockId) || isIceMaterial(blockId)) {
            continue;
        }

        vec2 uv = queryFragmentUv(
            quad,
            primitiveIndex,
            rayQueryGetIntersectionBarycentricsEXT(query, false));
        float alpha = textureLod(blockTex, uv, 0.0).a;
        float threshold = isFoliageMaterial(blockId) ? 0.5 : 0.1;
        if (alpha >= threshold) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }

    bool triangleHit = rayQueryGetIntersectionTypeEXT(query, true) != 0u;

#if VULKANITE_COMPILE_DIAGNOSTICS
    // Phase 5 reference path: preserve the old two-trace contract without
    // comparison overlays or readback. A shadow is blocked when either the
    // material triangle TLAS or the procedural TLAS reports an opaque hit.
    if (doubleTraceReferencePath) {
        float proceduralVisibility = traceProceduralShadowReference(
            rayOrigin,
            rayDirection,
            0.001,
            rayDistance);
        bool proceduralHit = proceduralVisibility <= 0.0;
        return triangleHit || proceduralHit ? 0.0 : 1.0;
    }

    float triangleDistance = triangleHit
        ? rayQueryGetIntersectionTEXT(query, true)
        : rayDistance;
    uint materialClass = 4u;
    uint triangleOwnershipClass = 0u; // unknown, known triangle-only, terrain cell to probe
    ivec3 triangleOwnerCell = ivec3(0);
    if (triangleHit) {
        uint sbtOffset = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(query, true);
        if (sbtOffset != 0u) {
            materialClass = 3u;
            triangleOwnershipClass = 1u;
        } else {
            uint geometryIndex = nonuniformEXT(
                rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)
                + rayQueryGetIntersectionGeometryIndexEXT(query, true));
            uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            Quad quad = geometryBuffers[geometryIndex].quads[primitiveIndex >> 1u];
            float blockId = float(quad.vertices[0].block_id.x);
            materialClass = isFoliageMaterial(blockId)
                ? 1u
                : ((isWaterMaterial(blockId) || isGlassMaterial(blockId) || isIceMaterial(blockId)) ? 2u : 0u);
            if (reconstructTriangleOwnerCell(
                    quad,
                    rayQueryGetIntersectionObjectToWorldEXT(query, true),
                    triangleOwnerCell)) {
                triangleOwnershipClass = 2u;
            }
        }
    }

    recordShadowComparison(
        triangleHit, triangleDistance, materialClass,
        triangleOwnershipClass, triangleOwnerCell,
        rayOrigin, rayDirection, 0.001, rayDistance);
#endif
    return triangleHit ? 0.0 : 1.0;
}

vec3 applyLinearColorGrade(vec3 color) {
    color = max(color, vec3(0.0)) * HDR_EXPOSURE;
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    color = mix(vec3(luma), color, COLOR_SATURATION);
    color = (color - vec3(0.18)) * COLOR_CONTRAST + vec3(0.18);
    return max(color, vec3(0.0));
}

float radicalInverse(uint bits) {
    return float(bitfieldReverse(bits)) * 2.3283064365386963e-10;
}

vec2 deterministicSunDiskOffset(uint pixelSeed, uint frameId, float radius) {
    uint sampleSeed = hashUint(pixelSeed, frameId ^ 0xa511e9b3u);
    float u = radicalInverse(sampleSeed);
    float v = radicalInverse(hashUint(sampleSeed, 0x7f4a7c15u));
    float r = radius * sqrt(clamp(u, 0.0, 1.0));
    float theta = TWO_PI * v;
    return r * vec2(cos(theta), sin(theta));
}

vec3 stratifiedCosineHemisphere(vec3 normal, int sampleIndex, int sampleCount, uint seed) {
    float u = (float(sampleIndex) + 0.5) / max(float(sampleCount), 1.0);
    float rotation = float(seed & 0x00ffffffu) * (1.0 / 16777216.0);
    float v = fract(radicalInverse(uint(sampleIndex)) + rotation);
    float radius = sqrt(u);
    float angle = TWO_PI * v;

    vec3 tangent;
    vec3 bitangent;
    createOrthonormalBasis(normal, tangent, bitangent);
    return normalize(
        tangent * (radius * cos(angle))
        + bitangent * (radius * sin(angle))
        + normal * sqrt(max(1.0 - u, 0.0)));
}

float volumetricPhase(float cosTheta) {
    float g = clamp(VOLUMETRIC_ANISOTROPY, 0.0, 0.95);
    float g2 = g * g;
    float denominator = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denominator * sqrt(denominator));
}

vec4 integrateVolumetrics(
    vec3 rayOrigin,
    vec3 rayDirection,
    float rayDistance,
    vec3 sunDirection,
    vec3 sunRadiance,
    uint seed
) {
#if VOLUMETRICS_ENABLED == 0
    return vec4(0.0, 0.0, 0.0, 1.0);
#else
    float marchDistance = min(max(rayDistance, 0.0), VOLUMETRIC_DISTANCE);
    if (marchDistance <= 0.001 || VOLUMETRIC_DENSITY <= 0.0 || VOLUMETRIC_INTENSITY <= 0.0) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }

    float stepLength = marchDistance / float(VOLUMETRIC_SAMPLES);
    float jitter = float(hashUint(seed, 0x68bc21ebu) & 0x00ffffffu) * (1.0 / 16777216.0);
    float stepTransmittance = exp(-VOLUMETRIC_DENSITY * stepLength);
    float transmittance = 1.0;
    float phase = volumetricPhase(dot(rayDirection, sunDirection));
    vec3 ambientScatter = mix(vec3(0.025, 0.035, 0.055), sunRadiance * 0.06,
        smoothstep(-0.1, 0.4, sunDirection.y));
    bool hasSunContribution = dot(sunRadiance, vec3(0.2126, 0.7152, 0.0722)) > 0.0001;
    vec3 scattering = vec3(0.0);

    for (int i = 0; i < VOLUMETRIC_SAMPLES; i++) {
        float distanceAlongRay = (float(i) + jitter) * stepLength;
        vec3 samplePosition = rayOrigin + rayDirection * distanceAlongRay;
        float sunVisibility = 1.0;

#if VOLUMETRIC_SHADOWS == 1
        if (hasSunContribution) {
            sunVisibility = alphaAwareVisibility(samplePosition, sunDirection, 10000.0);
        }
#endif

        vec3 incident = ambientScatter + sunRadiance * sunVisibility * phase;
        scattering += transmittance * (1.0 - stepTransmittance)
            * incident * VOLUMETRIC_INTENSITY;
        transmittance *= stepTransmittance;
    }

    return vec4(max(scattering, vec3(0.0)), clamp(transmittance, 0.0, 1.0));
#endif
}

// ============================================================================
// RT Blocklight Sampling Function
// Samples nearby emissive blocks (torches, lanterns, lava, etc.) via ray tracing
// Based on dirtrtold implementation with full PBR BRDF evaluation
// ============================================================================

vec3 sampleBlockLightRT(vec3 ro, vec3 normal, vec3 albedo, vec3 F0, 
                        float roughness, float metallic, vec3 viewDir, 
                        float specularIntensity, int sampleCount, inout uint seed) {
    vec3 rayOrigin = ro + normal * 0.02;
    vec3 totalContrib = vec3(0.0);
    int clampedSampleCount = clamp(sampleCount, 0, BLOCKLIGHT_SAMPLES);
    
    float NdotV = max(dot(normal, viewDir), 0.001);
    
    for (int i = 0; i < BLOCKLIGHT_SAMPLES; i++) {
        if (i >= clampedSampleCount) {
            break;
        }
        // Keep local-light samples stable in world space. Frame-varying samples
        // made stationary emissive lighting crawl and forced RR to blur block edges.
        vec3 sampleDir = stratifiedCosineHemisphere(normal, i, clampedSampleCount, seed);

        rayQueryEXT query;
        rayQueryInitializeEXT(
            query,
            acc,
            gl_RayFlagsNoneEXT,
            0xFF,
            rayOrigin,
            0.001,
            sampleDir,
            BLOCKLIGHT_MAX_DISTANCE);

        while (rayQueryProceedEXT(query)) {
            uint sbtOffset = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(query, false);
            if (sbtOffset != 0u) {
                continue;
            }

            uint geometryIndex = nonuniformEXT(
                rayQueryGetIntersectionInstanceCustomIndexEXT(query, false)
                + rayQueryGetIntersectionGeometryIndexEXT(query, false));
            uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
            Quad quad = geometryBuffers[geometryIndex].quads[primitiveIndex >> 1u];
            float blockId = float(quad.vertices[0].block_id.x);

            if (isWaterMaterial(blockId) || isGlassMaterial(blockId) || isIceMaterial(blockId)) {
                continue;
            }

            vec2 uv = queryFragmentUv(
                quad,
                primitiveIndex,
                rayQueryGetIntersectionBarycentricsEXT(query, false));
            float alpha = textureLod(blockTex, uv, 0.0).a;
            float threshold = isFoliageMaterial(blockId) ? 0.5 : 0.1;
            if (alpha >= threshold) {
                rayQueryConfirmIntersectionEXT(query);
            }
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) == 0u) continue;

        uint geometryIndex = nonuniformEXT(
            rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)
            + rayQueryGetIntersectionGeometryIndexEXT(query, true));
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        Quad quad = geometryBuffers[geometryIndex].quads[primitiveIndex >> 1u];
        float blockId = float(quad.vertices[0].block_id.x);
        vec2 uv = queryFragmentUv(
            quad,
            primitiveIndex,
            rayQueryGetIntersectionBarycentricsEXT(query, true));

        float hitDistance = rayQueryGetIntersectionTEXT(query, true);
        if (hitDistance > BLOCKLIGHT_MAX_DISTANCE) continue;

        vec4 shadeColor = quad.vertices[0].color * (1.0 / 255.0);
        vec4 hitAlbedo = textureLod(blockTex, uv, 0.0);
        vec4 hitSpecular = sanitizeLabPbrSpecular(samplePbrTexel(blockTexSpecular, uv));
        hitAlbedo.rgb = pow(hitAlbedo.rgb * shadeColor.rgb, vec3(2.2));

        bool hasHitLabPbrEmission = hasExplicitLabPbrEmission(hitSpecular.a);
        float labPbrEmission = decodeLabPbrEmission(hitSpecular.a);
        vec3 hitEmission = hasHitLabPbrEmission
            ? hitAlbedo.rgb * labPbrEmission * EMISSION_INTENSITY * EMISSIVE_SURFACE_INTENSITY
            : vec3(0.0);
        float emissionLuma = dot(hitEmission, vec3(0.299, 0.587, 0.114));
        if (emissionLuma < 0.001) continue;
        
        // Physical attenuation (inverse square law)
        float dist2 = hitDistance * hitDistance;
        float attenuation = 1.0 / (1.0 + dist2 * BLOCKLIGHT_FALLOFF);
        
        // BRDF evaluation for blocklight contribution
        vec3 L = sampleDir;
        vec3 H = normalize(viewDir + L);
        float NdotL = max(dot(normal, L), 0.0);
        float NdotH = max(dot(normal, H), 0.0);
        float HdotV = max(dot(H, viewDir), 0.0);
        
        // Diffuse (Lambert) - only for non-metals
        vec3 diffuse = (1.0 - metallic) * albedo * INV_PI;
        
        // Specular (GGX) - for surfaces with specular
        vec3 specular = vec3(0.0);
        if (specularIntensity > 0.001 && NdotL > 0.0) {
            float clampedRoughness = max(roughness, 0.04);
            float D = distributionGGX(NdotH, clampedRoughness);
            float G = geometrySmith(NdotV, NdotL, clampedRoughness);
            vec3 F = fresnelSchlick(HdotV, F0);
            specular = F * D * G / (4.0 * NdotV * NdotL + 0.001);
        }
        
        vec3 brdf = diffuse + specular * specularIntensity;
        
        // Unbiased estimate using cosine-weighted importance sampling
        // PDF for cosine-weighted hemisphere = NdotL / PI
        // Contribution = (BRDF * L * NdotL * Atten) / PDF = BRDF * L * PI * Atten
        vec3 sampleContrib = brdf * hitEmission * PI * attenuation * BLOCKLIGHT_EMISSION_SCALE;
        
        totalContrib += sampleContrib;
    }
    
	// Return average contribution from all samples
	return clampedSampleCount > 0 ? max(vec3(0.0), totalContrib / float(clampedSampleCount)) : vec3(0.0);
}

uint sectionLightCandidateSeed(vec3 worldPos, vec3 normal) {
    ivec3 cell = ivec3(floor(worldPos * 0.25));
    uint seed = hashUint(uint(cell.x) ^ 0x9e3779b9u, uint(cell.y) ^ 0x85ebca6bu);
    seed = hashUint(seed ^ uint(cell.z), sectionLightHeader.z ^ 0x27d4eb2du);
    seed = hashUint(seed, floatBitsToUint(dot(normal, vec3(0.25, 0.5, 1.0))));
    return seed;
}

int sectionLightCandidateIndex(int sampleIndex, int totalLightCount, int sampleCount, uint seed) {
#if SECTION_LIGHT_TABLE_STOCHASTIC_SAMPLING == 0
    return sampleIndex;
#else
    if (totalLightCount <= sampleCount || totalLightCount <= 0) {
        return sampleIndex;
    }

    uint total = uint(totalLightCount);
    uint samples = uint(max(sampleCount, 1));
    uint binStart = (uint(sampleIndex) * total) / samples;
    uint binEnd = (uint(sampleIndex + 1) * total) / samples;
    uint binSize = max(binEnd - binStart, 1u);
    uint jitter = hashUint(seed ^ (uint(sampleIndex) * 0x9e3779b9u), uint(sampleIndex) ^ 0x7f4a7c15u);
    return int(min(binStart + (jitter % binSize), total - 1u));
#endif
}

int sectionLightRangeCandidateIndex(int sampleIndex, int rangeStart, int rangeCount, int sampleCount, uint seed) {
#if SECTION_LIGHT_TABLE_STOCHASTIC_SAMPLING == 0
    return rangeStart + sampleIndex;
#else
    if (rangeCount <= sampleCount || rangeCount <= 0) {
        return rangeStart + sampleIndex;
    }

    uint total = uint(rangeCount);
    uint samples = uint(max(sampleCount, 1));
    uint binStart = (uint(sampleIndex) * total) / samples;
    uint binEnd = (uint(sampleIndex + 1) * total) / samples;
    uint binSize = max(binEnd - binStart, 1u);
    uint jitter = hashUint(seed ^ (uint(sampleIndex) * 0x85ebca6bu), uint(sampleIndex) ^ 0xc2b2ae35u);
    return rangeStart + int(min(binStart + (jitter % binSize), total - 1u));
#endif
}

uint sectionLightGridHash(ivec3 sectionCoord) {
    uint hash = uint(sectionCoord.x) * 0x8da6b343u
        ^ uint(sectionCoord.y) * 0xd8163841u
        ^ uint(sectionCoord.z) * 0xcb1ab31fu;
    hash ^= hash >> 16u;
    hash *= 0x7feb352du;
    hash ^= hash >> 15u;
    return hash;
}

bool findSectionLightGridRange(ivec3 sectionOrigin, out int firstLight, out int lightCount) {
    firstLight = 0;
    lightCount = 0;
#if SECTION_LIGHT_GRID_ENABLE == 0
    return false;
#else
    int gridRecordCount = int(sectionLightHeader.w);
    if (gridRecordCount <= 0) {
        return false;
    }

    ivec3 sectionCoord = sectionOrigin / 16;
    uint directoryMask = uint(gridRecordCount - 1);
    uint hash = sectionLightGridHash(sectionCoord);
    int probeLimit = min(SECTION_LIGHT_GRID_HASH_PROBES, gridRecordCount);
    int directoryBase = int(sectionLightHeader.x);
    for (int probe = 0; probe < probeLimit; probe++) {
        int directoryIndex = int((hash + uint(probe)) & directoryMask);
        GpuSectionLight record = sectionLightRecords[directoryBase + directoryIndex];
        if (record.colorEmission.w == 0u) {
            return false;
        }
        if (all(equal(record.posRadiusFlags.xyz, sectionOrigin))) {
            firstLight = record.posRadiusFlags.w;
            lightCount = int(record.colorEmission.x);
            return lightCount > 0;
        }
    }

    return false;
#endif
}

bool findSurfaceDependencyVersion(vec3 worldPos, out uvec2 version) {
    version = uvec2(0u);
    int gridRecordCount = int(sectionLightHeader.w);
    if (gridRecordCount <= 0) return false;
    ivec3 sectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
    ivec3 sectionCoord = sectionOrigin / 16;
    uint directoryMask = uint(gridRecordCount - 1);
    uint hash = sectionLightGridHash(sectionCoord);
    int directoryBase = int(sectionLightHeader.x);
    int probeLimit = min(SECTION_LIGHT_GRID_HASH_PROBES, gridRecordCount);
    for (int probe = 0; probe < probeLimit; probe++) {
        int directoryIndex = int((hash + uint(probe)) & directoryMask);
        GpuSectionLight record = sectionLightRecords[directoryBase + directoryIndex];
        if (record.colorEmission.w == 0u) return false;
        if (all(equal(record.posRadiusFlags.xyz, sectionOrigin))) {
            version = record.colorEmission.yz;
            return true;
        }
    }
    return false;
}

float sectionLightBlocklightMaxDistance(float radius) {
    // IRLights point emitters have a finite physical radius. Do not expand the
    // light range with probe-cascade tuning: that makes unrelated emitters
    // overlap and gives surfaces an apparently incorrect light direction.
    return max(radius, 1.0);
}

float sectionLightNormalizedEmission(GpuSectionLight light) {
    return clamp(float(light.colorEmission.a) * (1.0 / 15.0), 0.0, 1.0);
}

float sectionLightDistanceAttenuation(float distance, float maxDistance) {
    // IRLights/Frostbite radial window: (1 - (distance / radius)^4)^2.
    float normalizedDistance = clamp(distance / max(maxDistance, 0.001), 0.0, 1.0);
    float distance2 = normalizedDistance * normalizedDistance;
    float distance4 = distance2 * distance2;
    float falloff = max(1.0 - distance4, 0.0);
    return falloff * falloff;
}

vec3 evaluateSectionLightRecord(
    GpuSectionLight light,
    vec3 worldPos,
    vec3 normal,
    vec3 diffuseAlbedo,
    vec3 F0,
    float roughness,
    float metallic,
    vec3 viewDir,
    float specularIntensity
) {
    float emission = sectionLightNormalizedEmission(light);
    vec3 lightColor = vec3(light.colorEmission.rgb) * (1.0 / 255.0);
    if (emission <= 0.0
            || dot(lightColor, vec3(0.2126, 0.7152, 0.0722)) <= 0.0001) {
        return vec3(0.0);
    }

    float radius = max(float(light.posRadiusFlags.w & 0xFFFF), 1.0);
    vec3 lightPos = vec3(light.posRadiusFlags.xyz) + vec3(0.5);
    vec3 toLight = lightPos - worldPos;
    float dist2 = dot(toLight, toLight);
    float maxDistance = sectionLightBlocklightMaxDistance(radius);
    if (dist2 <= 0.0001 || dist2 > maxDistance * maxDistance) {
        return vec3(0.0);
    }

    float distance = sqrt(dist2);
    vec3 lightDir = toLight / distance;
    float attenuation = sectionLightDistanceAttenuation(distance, maxDistance);

    vec3 radiance = lightColor * emission * attenuation * BLOCKLIGHT_EMISSION_SCALE;

    vec3 diffuseTerm;
    vec3 specularTerm;
    evaluatePBRSplit(
        diffuseAlbedo,
        normal,
        viewDir,
        lightDir,
        radiance,
        F0,
        roughness,
        metallic,
        specularIntensity,
        diffuseTerm,
        specularTerm);
    return diffuseTerm + specularTerm;
}

void insertSectionLightSparseCandidate(
    float score,
    vec3 lightDir,
    float distance,
    vec3 incidentRadiance,
    inout float candidateScore[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT],
    inout vec3 candidateDir[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT],
    inout float candidateDistance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT],
    inout vec3 candidateRadiance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT]
) {
    for (int candidate = 0; candidate < SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT; candidate++) {
        if (score <= candidateScore[candidate]) {
            continue;
        }

        for (int shift = SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT - 1; shift > candidate; shift--) {
            candidateScore[shift] = candidateScore[shift - 1];
            candidateDir[shift] = candidateDir[shift - 1];
            candidateDistance[shift] = candidateDistance[shift - 1];
            candidateRadiance[shift] = candidateRadiance[shift - 1];
        }

        candidateScore[candidate] = score;
        candidateDir[candidate] = lightDir;
        candidateDistance[candidate] = distance;
        candidateRadiance[candidate] = incidentRadiance;
        break;
    }
}

void considerSectionLightSparseCandidate(
    GpuSectionLight light,
    vec3 worldPos,
    vec3 normal,
    inout float candidateScore[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT],
    inout vec3 candidateDir[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT],
    inout float candidateDistance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT],
    inout vec3 candidateRadiance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT]
) {
    vec3 lightColor = vec3(light.colorEmission.rgb) * (1.0 / 255.0);
    float emission = sectionLightNormalizedEmission(light);
    float lightLuma = dot(lightColor, vec3(0.2126, 0.7152, 0.0722)) * emission;
    if (lightLuma <= 0.0001) {
        return;
    }

    float radius = max(float(light.posRadiusFlags.w & 0xFFFF), 1.0);
    vec3 lightPos = vec3(light.posRadiusFlags.xyz) + vec3(0.5);
    vec3 toLight = lightPos - worldPos;
    float dist2 = dot(toLight, toLight);
    float maxDistance = sectionLightBlocklightMaxDistance(radius);
    if (dist2 <= 0.0001 || dist2 > maxDistance * maxDistance) {
        return;
    }

    float distance = sqrt(dist2);
    vec3 lightDir = toLight / distance;
    float normalWeight = dot(normal, normal) > 0.5
        ? max(dot(normal, lightDir), 0.0)
        : 1.0;
    if (normalWeight <= 0.0001) {
        return;
    }

    float attenuation = sectionLightDistanceAttenuation(distance, maxDistance);
    float brightness = emission * attenuation;
    if (brightness < max(SECTION_LIGHT_PROBE_MIN_BRIGHTNESS, 0.0)) {
        return;
    }
    vec3 incidentRadiance = lightColor * brightness;
    float score = dot(incidentRadiance, vec3(0.2126, 0.7152, 0.0722)) * normalWeight;
    insertSectionLightSparseCandidate(
        score,
        lightDir,
        distance,
        incidentRadiance,
        candidateScore,
        candidateDir,
        candidateDistance,
        candidateRadiance);
}

float sectionLightSourceShapeContribution(GpuSectionLight light, vec3 worldPos) {
    float radius = max(float(light.posRadiusFlags.w & 0xFFFF), 1.0);
    vec3 lightPos = vec3(light.posRadiusFlags.xyz) + vec3(0.5);
    vec3 toLight = lightPos - worldPos;
    float dist2 = dot(toLight, toLight);
    float maxDistance = sectionLightBlocklightMaxDistance(radius);
    if (dist2 <= 0.0001 || dist2 > maxDistance * maxDistance) {
        return 0.0;
    }

    float distance = sqrt(dist2);
    float attenuation = sectionLightDistanceAttenuation(distance, maxDistance);
    float emission = sectionLightNormalizedEmission(light);
    if (emission <= 0.0 || attenuation <= 0.0) {
        return 0.0;
    }

    vec3 radiance = vec3(light.colorEmission.rgb) * (1.0 / 255.0) * emission * attenuation;
    float peakRadiance = max(radiance.r, max(radiance.g, radiance.b));
    if (peakRadiance <= 0.0001) {
        return 0.0;
    }
    float compression = 3.0 * log(peakRadiance / 3.0 + 1.0) / peakRadiance;
    return dot(radiance * compression, vec3(0.2126, 0.7152, 0.0722));
}

float sampleSectionLightSourceShapeGuide(vec3 worldPos) {
#if SECTION_LIGHT_TABLE_ENABLE == 0
    return 0.0;
#else
    int totalLightCount = int(sectionLightHeader.x);
    int count = min(totalLightCount, SECTION_LIGHT_SAMPLE_LIMIT);
    uint candidateSeed = sectionLightCandidateSeed(worldPos, vec3(0.0));
    float sourceGuide = 0.0;

#if SECTION_LIGHT_GRID_ENABLE != 0
    bool foundLocalRange = false;
    if (sectionLightHeader.w > 0u) {
        ivec3 baseSectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
        int evaluated = 0;

        for (int manhattan = 0; manhattan <= SECTION_LIGHT_GRID_SEARCH_RADIUS * 3; manhattan++) {
            for (int dz = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dz <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dz++) {
                for (int dy = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dy <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dy++) {
                    for (int dx = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dx <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dx++) {
                        if (abs(dx) + abs(dy) + abs(dz) != manhattan
                                || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                            continue;
                        }

                        int firstLight;
                        int rangeCount;
                        if (!findSectionLightGridRange(
                                baseSectionOrigin + ivec3(dx, dy, dz) * 16,
                                firstLight,
                                rangeCount)) {
                            continue;
                        }

                        foundLocalRange = true;
                        int remainingBudget = SECTION_LIGHT_SAMPLE_LIMIT - evaluated;
                        int sectionSampleCount = min(
                            rangeCount,
                            min(SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT, remainingBudget));
                        uint rangeSeed = hashUint(
                            candidateSeed ^ uint((dx + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 151
                                + (dy + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 283
                                + (dz + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 457),
                            uint(manhattan) ^ 0x7f4a7c15u);

                        for (int sampleIndex = 0; sampleIndex < SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT; sampleIndex++) {
                            if (sampleIndex >= sectionSampleCount || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                                break;
                            }
                            int lightIndex = sectionLightRangeCandidateIndex(
                                sampleIndex,
                                firstLight,
                                rangeCount,
                                sectionSampleCount,
                                rangeSeed);
                            sourceGuide += sectionLightSourceShapeContribution(
                                sectionLightRecords[lightIndex],
                                worldPos);
                            evaluated++;
                        }
                    }
                }
            }
        }
    }

    if (!foundLocalRange)
#endif
    {
        for (int i = 0; i < count; i++) {
            GpuSectionLight light = sectionLightRecords[
                sectionLightCandidateIndex(i, totalLightCount, count, candidateSeed)];
            sourceGuide += sectionLightSourceShapeContribution(light, worldPos);
        }
    }

    return sourceGuide;
#endif
}

vec3 clampSectionLightToSourceShape(vec3 worldPos, vec3 lighting) {
#if SECTION_LIGHT_PROBE_SOURCE_SHAPE_CLAMP == 0 || SECTION_LIGHT_TABLE_ENABLE == 0
    return lighting;
#else
    float sourceShapeGuideLuma = sampleSectionLightSourceShapeGuide(worldPos)
        * SECTION_LIGHT_PROBE_INTENSITY;
    float lightingLuma = dot(lighting, vec3(0.2126, 0.7152, 0.0722));
    float sourceShapeRatio = clamp(float(SECTION_LIGHT_PROBE_SOURCE_SHAPE_RATIO), 1.0, 6.0);
    float sourceShapeFloor = max(float(SECTION_LIGHT_PROBE_MIN_BRIGHTNESS) * 4.0, 0.0025);
    float maxSourceShapeLuma = max(sourceShapeGuideLuma * sourceShapeRatio, sourceShapeFloor);
    if (lightingLuma > maxSourceShapeLuma && lightingLuma > 0.0001) {
        lighting *= maxSourceShapeLuma / lightingLuma;
    }
    return lighting;
#endif
}

vec3 sampleSectionLightTable(
    vec3 worldPos,
    vec3 normal,
    vec3 diffuseAlbedo,
    vec3 F0,
    float roughness,
    float metallic,
    vec3 viewDir,
    float specularIntensity
) {
#if SECTION_LIGHT_TABLE_ENABLE == 0
    return vec3(0.0);
#else
    int totalLightCount = int(sectionLightHeader.x);
    int count = min(totalLightCount, SECTION_LIGHT_SAMPLE_LIMIT);
    uint candidateSeed = sectionLightCandidateSeed(worldPos, normal);
    vec3 total = vec3(0.0);

#if SECTION_LIGHT_GRID_ENABLE != 0
    if (sectionLightHeader.w > 0u) {
        ivec3 baseSectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
        int evaluated = 0;
        bool foundLocalRange = false;

        for (int manhattan = 0; manhattan <= SECTION_LIGHT_GRID_SEARCH_RADIUS * 3; manhattan++) {
            for (int dz = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dz <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dz++) {
                for (int dy = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dy <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dy++) {
                    for (int dx = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dx <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dx++) {
                        if (abs(dx) + abs(dy) + abs(dz) != manhattan
                                || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                            continue;
                        }

                        int firstLight;
                        int rangeCount;
                        if (!findSectionLightGridRange(
                                baseSectionOrigin + ivec3(dx, dy, dz) * 16,
                                firstLight,
                                rangeCount)) {
                            continue;
                        }

                        foundLocalRange = true;
                        int remainingBudget = SECTION_LIGHT_SAMPLE_LIMIT - evaluated;
                        int sectionSampleCount = min(
                            rangeCount,
                            min(SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT, remainingBudget));
                        uint rangeSeed = hashUint(
                            candidateSeed ^ uint((dx + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 73
                                + (dy + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 193
                                + (dz + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 389),
                            uint(manhattan) ^ 0x6d2b79f5u);

                        for (int sampleIndex = 0; sampleIndex < SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT; sampleIndex++) {
                            if (sampleIndex >= sectionSampleCount || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                                break;
                            }
                            int lightIndex = sectionLightRangeCandidateIndex(
                                sampleIndex,
                                firstLight,
                                rangeCount,
                                sectionSampleCount,
                                rangeSeed);
                            total += evaluateSectionLightRecord(
                                sectionLightRecords[lightIndex],
                                worldPos,
                                normal,
                                diffuseAlbedo,
                                F0,
                                roughness,
                                metallic,
                                viewDir,
                                specularIntensity);
                            evaluated++;
                        }
                    }
                }
            }
        }

        if (foundLocalRange) {
            return max(total, vec3(0.0));
        }
    }
#endif

    for (int i = 0; i < count; i++) {
        GpuSectionLight light = sectionLightRecords[
            sectionLightCandidateIndex(i, totalLightCount, count, candidateSeed)];
        total += evaluateSectionLightRecord(
            light,
            worldPos,
            normal,
            diffuseAlbedo,
            F0,
            roughness,
            metallic,
            viewDir,
            specularIntensity);
    }

    return max(total, vec3(0.0));
#endif
}

vec3 compressSectionLightRtRadiance(vec3 directionalRadiance, vec3 totalRadiance) {
    directionalRadiance = max(directionalRadiance, vec3(0.0));
    totalRadiance = max(totalRadiance, vec3(0.0));
    float peakRadiance = max(totalRadiance.r, max(totalRadiance.g, totalRadiance.b));
    if (peakRadiance <= 0.0001) {
        return vec3(0.0);
    }
    float scale = 3.0 * log(peakRadiance / 3.0 + 1.0) / peakRadiance;
    return directionalRadiance * scale;
}

float sectionLightVisibilityDistanceToSource(float centerDistance, vec3 lightDir) {
    float dominantAxis = max(abs(lightDir.x), max(abs(lightDir.y), abs(lightDir.z)));
    float distanceFromCenterToBlockEntry = 0.51 / max(dominantAxis, 0.0001);
    return max(centerDistance - distanceFromCenterToBlockEntry, 0.01);
}

float sampleSectionLightSparseRt(
    vec3 worldPos,
    vec3 normal,
    out vec3 visibleIncidentRadiance
) {
    visibleIncidentRadiance = vec3(0.0);
#if SECTION_LIGHT_TABLE_ENABLE == 0
    return -1.0;
#else
    int totalLightCount = int(sectionLightHeader.x);
    int count = min(totalLightCount, SECTION_LIGHT_SAMPLE_LIMIT);
#if SECTION_LIGHT_PROBE_RT_SURFACE_CACHE != 0
    uint candidateSeed = hashUint(sectionLightHeader.z, 0x51ed270bu);
#else
    uint candidateSeed = sectionLightCandidateSeed(worldPos, normal);
#endif
    int sampleBudget = clamp(SECTION_LIGHT_SPARSE_RT_SAMPLES, 1, SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT);
    float candidateScore[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];
    vec3 candidateDir[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];
    float candidateDistance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];
    vec3 candidateRadiance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];

    for (int i = 0; i < SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT; i++) {
        candidateScore[i] = 0.0;
        candidateDir[i] = vec3(0.0, 1.0, 0.0);
        candidateDistance[i] = 0.0;
        candidateRadiance[i] = vec3(0.0);
    }

#if SECTION_LIGHT_GRID_ENABLE != 0
    bool foundLocalRange = false;
    if (sectionLightHeader.w > 0u) {
        ivec3 baseSectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
        int evaluated = 0;

        for (int manhattan = 0; manhattan <= SECTION_LIGHT_GRID_SEARCH_RADIUS * 3; manhattan++) {
            for (int dz = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dz <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dz++) {
                for (int dy = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dy <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dy++) {
                    for (int dx = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dx <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dx++) {
                        if (abs(dx) + abs(dy) + abs(dz) != manhattan
                                || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                            continue;
                        }

                        int firstLight;
                        int rangeCount;
                        ivec3 rangeSectionOrigin = baseSectionOrigin + ivec3(dx, dy, dz) * 16;
                        if (!findSectionLightGridRange(
                                rangeSectionOrigin,
                                firstLight,
                                rangeCount)) {
                            continue;
                        }

                        foundLocalRange = true;
                        int remainingBudget = SECTION_LIGHT_SAMPLE_LIMIT - evaluated;
                        int sectionSampleCount = min(
                            rangeCount,
                            min(SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT, remainingBudget));
#if SECTION_LIGHT_PROBE_RT_SURFACE_CACHE != 0
                        uint rangeSeed = hashUint(
                            sectionLightGridHash(rangeSectionOrigin),
                            sectionLightHeader.z ^ 0x94d049bbu);
#else
                        uint rangeSeed = hashUint(
                            candidateSeed ^ uint((dx + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 109
                                + (dy + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 251
                                + (dz + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 467),
                            uint(manhattan) ^ 0x94d049bbu);
#endif

                        for (int sampleIndex = 0; sampleIndex < SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT; sampleIndex++) {
                            if (sampleIndex >= sectionSampleCount || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                                break;
                            }
                            int lightIndex = sectionLightRangeCandidateIndex(
                                sampleIndex,
                                firstLight,
                                rangeCount,
                                sectionSampleCount,
                                rangeSeed);
                            considerSectionLightSparseCandidate(
                                sectionLightRecords[lightIndex],
                                worldPos,
                                normal,
                                candidateScore,
                                candidateDir,
                                candidateDistance,
                                candidateRadiance);
                            evaluated++;
                        }
                    }
                }
            }
        }
    }

    if (!foundLocalRange)
#endif
    {
        for (int i = 0; i < count; i++) {
            GpuSectionLight light = sectionLightRecords[
                sectionLightCandidateIndex(i, totalLightCount, count, candidateSeed)];
            considerSectionLightSparseCandidate(
                light,
                worldPos,
                normal,
                candidateScore,
                candidateDir,
                candidateDistance,
                candidateRadiance);
        }
    }

    float totalScore = 0.0;
    float visibleScore = 0.0;
    vec3 rayOrigin = worldPos + normal * 0.025;
    for (int candidate = 0; candidate < SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT; candidate++) {
        if (candidate >= sampleBudget || candidateScore[candidate] <= 0.0) {
            break;
        }

        vec3 lightCenter = worldPos
            + candidateDir[candidate] * candidateDistance[candidate];
        vec3 rayToLight = lightCenter - rayOrigin;
        float rayCenterDistance = length(rayToLight);
        vec3 visibilityDir = rayCenterDistance > 0.0001
            ? rayToLight / rayCenterDistance
            : candidateDir[candidate];
        float visibility = rayCenterDistance > 0.0001
            ? alphaAwareVisibility(
                rayOrigin,
                visibilityDir,
                sectionLightVisibilityDistanceToSource(
                    rayCenterDistance,
                    visibilityDir))
            : 1.0;
        totalScore += candidateScore[candidate];
        visibleScore += candidateScore[candidate] * visibility;
        vec3 visibleRadiance = candidateRadiance[candidate] * visibility;
        vec3 compressedVisibleRadiance = compressSectionLightRtRadiance(
            visibleRadiance,
            visibleRadiance);
        visibleIncidentRadiance += compressedVisibleRadiance
            * max(dot(normal, candidateDir[candidate]), 0.0);
    }

    return totalScore > 0.0001 ? clamp(visibleScore / totalScore, 0.0, 1.0) : -1.0;
#endif
}

float sampleSectionLightSparseVisibilityRatio(vec3 worldPos, vec3 normal) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    return -1.0;
#else
    vec3 ignoredRadiance;
    return sampleSectionLightSparseRt(worldPos, normal, ignoredRadiance);
#endif
}

float sectionLightProbeAxisWeight(vec3 direction, int axis) {
    float directionLength = length(direction);
    return directionLength > 0.0001 ? abs(direction[axis]) / directionLength : 1.0;
}

void sectionLightProbeAxisWeights(
    vec3 toLight,
    int axis,
    out float negativeWeight,
    out float positiveWeight
) {
    negativeWeight = 0.0;
    positiveWeight = 0.0;
    vec3 axisVector = vec3(0.0);
    axisVector[axis] = 1.0;
    float axisDistance = toLight[axis];
    if (abs(axisDistance) > 0.5) {
        float axisSign = axisDistance > 0.0 ? 1.0 : -1.0;
        float weight = sectionLightProbeAxisWeight(
            toLight - axisVector * (0.5 * axisSign),
            axis);
        if (axisDistance > 0.0) {
            positiveWeight = weight;
        } else {
            negativeWeight = weight;
        }
        return;
    }

    negativeWeight = sectionLightProbeAxisWeight(toLight - axisVector * 0.5, axis);
    positiveWeight = sectionLightProbeAxisWeight(toLight + axisVector * 0.5, axis);
}

void sampleSectionLightProbeRtCell(
    vec3 worldPos,
    out vec3 face0,
    out vec3 face1,
    out vec3 face2,
    out vec3 face3,
    out vec3 face4,
    out vec3 face5
) {
    face0 = vec3(0.0);
    face1 = vec3(0.0);
    face2 = vec3(0.0);
    face3 = vec3(0.0);
    face4 = vec3(0.0);
    face5 = vec3(0.0);
#if SECTION_LIGHT_TABLE_ENABLE != 0
    int totalLightCount = int(sectionLightHeader.x);
    if (totalLightCount <= 0 || SECTION_LIGHT_PROBE_INTENSITY <= 0.0) {
        return;
    }
    int count = min(totalLightCount, SECTION_LIGHT_SAMPLE_LIMIT);
    uint candidateSeed = sectionLightCandidateSeed(worldPos, vec3(0.0));
    int sampleBudget = clamp(
        SECTION_LIGHT_SPARSE_RT_SAMPLES,
        1,
        SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT);
    float candidateScore[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];
    vec3 candidateDir[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];
    float candidateDistance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];
    vec3 candidateRadiance[SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT];

    for (int i = 0; i < SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT; i++) {
        candidateScore[i] = 0.0;
        candidateDir[i] = vec3(0.0, 1.0, 0.0);
        candidateDistance[i] = 0.0;
        candidateRadiance[i] = vec3(0.0);
    }

#if SECTION_LIGHT_GRID_ENABLE != 0
    bool foundLocalRange = false;
    if (sectionLightHeader.w > 0u) {
        ivec3 baseSectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
        int evaluated = 0;

        for (int manhattan = 0; manhattan <= SECTION_LIGHT_GRID_SEARCH_RADIUS * 3; manhattan++) {
            for (int dz = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dz <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dz++) {
                for (int dy = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dy <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dy++) {
                    for (int dx = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dx <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dx++) {
                        if (abs(dx) + abs(dy) + abs(dz) != manhattan
                                || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                            continue;
                        }

                        int firstLight;
                        int rangeCount;
                        if (!findSectionLightGridRange(
                                baseSectionOrigin + ivec3(dx, dy, dz) * 16,
                                firstLight,
                                rangeCount)) {
                            continue;
                        }

                        foundLocalRange = true;
                        int remainingBudget = SECTION_LIGHT_SAMPLE_LIMIT - evaluated;
                        int sectionSampleCount = min(
                            rangeCount,
                            min(SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT, remainingBudget));
                        uint rangeSeed = hashUint(
                            candidateSeed ^ uint((dx + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 109
                                + (dy + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 251
                                + (dz + SECTION_LIGHT_GRID_SEARCH_RADIUS) * 467),
                            uint(manhattan) ^ 0x94d049bbu);

                        for (int sampleIndex = 0; sampleIndex < SECTION_LIGHT_GRID_SECTION_SAMPLE_LIMIT; sampleIndex++) {
                            if (sampleIndex >= sectionSampleCount || evaluated >= SECTION_LIGHT_SAMPLE_LIMIT) {
                                break;
                            }
                            int lightIndex = sectionLightRangeCandidateIndex(
                                sampleIndex,
                                firstLight,
                                rangeCount,
                                sectionSampleCount,
                                rangeSeed);
                            considerSectionLightSparseCandidate(
                                sectionLightRecords[lightIndex],
                                worldPos,
                                vec3(0.0),
                                candidateScore,
                                candidateDir,
                                candidateDistance,
                                candidateRadiance);
                            evaluated++;
                        }
                    }
                }
            }
        }
    }

    if (!foundLocalRange)
#endif
    {
        for (int i = 0; i < count; i++) {
            GpuSectionLight light = sectionLightRecords[
                sectionLightCandidateIndex(i, totalLightCount, count, candidateSeed)];
            considerSectionLightSparseCandidate(
                light,
                worldPos,
                vec3(0.0),
                candidateScore,
                candidateDir,
                candidateDistance,
                candidateRadiance);
        }
    }

    for (int candidate = 0; candidate < SECTION_LIGHT_SPARSE_RT_CANDIDATE_LIMIT; candidate++) {
        if (candidate >= sampleBudget || candidateScore[candidate] <= 0.0) {
            break;
        }

        vec3 lightDir = candidateDir[candidate];
        float biasedCenterDistance = max(candidateDistance[candidate] - 0.025, 0.0001);
        float visibility = alphaAwareVisibility(
            worldPos + lightDir * 0.025,
            lightDir,
            sectionLightVisibilityDistanceToSource(
                biasedCenterDistance,
                lightDir));
        vec3 visibleRadiance = candidateRadiance[candidate] * visibility;
        vec3 compressedVisibleRadiance = compressSectionLightRtRadiance(
            visibleRadiance,
            visibleRadiance);

        vec3 toLight = lightDir * candidateDistance[candidate];
        float negativeWeight;
        float positiveWeight;
        sectionLightProbeAxisWeights(toLight, 0, negativeWeight, positiveWeight);
        face0 += compressedVisibleRadiance * positiveWeight;
        face1 += compressedVisibleRadiance * negativeWeight;
        sectionLightProbeAxisWeights(toLight, 1, negativeWeight, positiveWeight);
        face2 += compressedVisibleRadiance * positiveWeight;
        face3 += compressedVisibleRadiance * negativeWeight;
        sectionLightProbeAxisWeights(toLight, 2, negativeWeight, positiveWeight);
        face4 += compressedVisibleRadiance * positiveWeight;
        face5 += compressedVisibleRadiance * negativeWeight;
    }
#endif
}

vec3 sectionLightProbeFaceDirection(int face) {
    if (face == 0) {
        return vec3(1.0, 0.0, 0.0);
    }
    if (face == 1) {
        return vec3(-1.0, 0.0, 0.0);
    }
    if (face == 2) {
        return vec3(0.0, 1.0, 0.0);
    }
    if (face == 3) {
        return vec3(0.0, -1.0, 0.0);
    }
    if (face == 4) {
        return vec3(0.0, 0.0, 1.0);
    }
    return vec3(0.0, 0.0, -1.0);
}

int sectionLightProbeDominantNormalFace(vec3 normal) {
    vec3 axisWeight = abs(normal);
    if (axisWeight.x >= axisWeight.y && axisWeight.x >= axisWeight.z) {
        return normal.x >= 0.0 ? 0 : 1;
    }
    if (axisWeight.y >= axisWeight.z) {
        return normal.y >= 0.0 ? 2 : 3;
    }
    return normal.z >= 0.0 ? 4 : 5;
}

vec3 normalizeSectionLightProbeNormal(vec3 normal) {
    if (any(isnan(normal)) || any(isinf(normal)) || dot(normal, normal) <= 0.000001) {
        return vec3(0.0, 1.0, 0.0);
    }
    return normalize(normal);
}

vec3 stabilizeSectionLightProbeNormal(vec3 normal) {
    vec3 n = normalizeSectionLightProbeNormal(normal);
    return sectionLightProbeFaceDirection(sectionLightProbeDominantNormalFace(n));
}

int findSectionLightProbeSlotByOrigin(ivec3 sectionOrigin) {
    if (sectionLightProbeHeader.x <= 0) {
        return -1;
    }

    ivec3 sectionCoord = sectionOrigin / 16;
    uint hash = uint(sectionCoord.x) * 0x8da6b343u
        ^ uint(sectionCoord.y) * 0xd8163841u
        ^ uint(sectionCoord.z) * 0xcb1ab31fu;
    hash ^= hash >> 16u;
    hash *= 0x7feb352du;
    hash ^= hash >> 15u;

    uint directoryMask = uint(SECTION_LIGHT_PROBE_DIRECTORY_RECORDS - 1);
    int probeLimit = min(SECTION_LIGHT_PROBE_HASH_PROBES, SECTION_LIGHT_PROBE_DIRECTORY_RECORDS);
    for (int probe = 0; probe < probeLimit; probe++) {
        int directoryIndex = int((hash + uint(probe)) & directoryMask);
        ivec4 record = sectionLightProbeRecords[directoryIndex];
        if (record.w == 0) {
            return -1;
        }
        if (record.x == sectionOrigin.x && record.y == sectionOrigin.y && record.z == sectionOrigin.z) {
            int slot = record.w - 1;
            int slotLimit = min(sectionLightProbeHeader.y, SECTION_LIGHT_PROBE_MAX_PAGES);
            return (slot >= 0 && slot < slotLimit) ? slot : -1;
        }
    }

    return -1;
}

int findSectionLightProbeSlot(vec3 worldPos, out ivec3 sectionOrigin) {
    sectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
    return findSectionLightProbeSlotByOrigin(sectionOrigin);
}

vec3 unpackSectionLightProbeRgb9E5(uint packed) {
    if (packed == 0u) {
        return vec3(0.0);
    }
    uint r = packed & 511u;
    uint g = (packed >> 9u) & 511u;
    uint b = (packed >> 18u) & 511u;
    uint e = (packed >> 27u) & 31u;
    float scale = exp2(float(e) - 15.0 - 9.0);
    return vec3(float(r), float(g), float(b)) * scale;
}

uint packSectionLightProbeRgb9E5(vec3 radiance) {
    vec3 clampedRadiance = clamp(max(radiance, vec3(0.0)), vec3(0.0), vec3(65408.0));
    float peakRadiance = max(clampedRadiance.r, max(clampedRadiance.g, clampedRadiance.b));
    if (peakRadiance <= 0.0) {
        return 0u;
    }

    int exponent = clamp(int(ceil(log2(peakRadiance / 511.0))) + 24, 0, 31);
    uvec3 mantissa = uvec3(0u);
    for (int attempt = 0; attempt < 2; attempt++) {
        float scale = exp2(float(exponent) - 24.0);
        mantissa = uvec3(round(clampedRadiance / scale));
        if (any(greaterThan(mantissa, uvec3(511u))) && exponent < 31) {
            exponent++;
            continue;
        }
        break;
    }

    mantissa = min(mantissa, uvec3(511u));
    if ((mantissa.r | mantissa.g | mantissa.b) == 0u) {
        return 0u;
    }
    return mantissa.r
        | (mantissa.g << 9u)
        | (mantissa.b << 18u)
        | (uint(exponent) << 27u);
}

int sectionLightProbeRtCacheCellIndex(int slot, int probeIndex) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return -1;
#else
    int slotLimit = min(int(sectionLightProbeRtCacheHeader.y), SECTION_LIGHT_PROBE_MAX_PAGES);
    if (sectionLightProbeRtCacheHeader.x <= 0u
            || sectionLightProbeRtCacheHeader.w <= 0u
            || slot < 0 || slot >= slotLimit
            || probeIndex < 0 || probeIndex >= SECTION_LIGHT_PROBE_CELL_COUNT) {
        return -1;
    }
    int cellIndex = slot * SECTION_LIGHT_PROBE_CELL_COUNT + probeIndex;
    return cellIndex < int(sectionLightProbeRtCacheHeader.w) ? cellIndex : -1;
#endif
}

uint sectionLightProbeRtCacheReadyState() {
    uint configHash = floatBitsToUint(float(SECTION_LIGHT_PROBE_MIN_BRIGHTNESS));
    configHash ^= uint(SECTION_LIGHT_SPARSE_RT_SAMPLES) * 0x9e3779b9u;
    configHash ^= floatBitsToUint(float(SECTION_LIGHT_PROBE_CASCADE_DISTANCE_SCALE)) * 0x27d4eb2du;
    configHash ^= uint(SECTION_LIGHT_GRID_SEARCH_RADIUS) * 0x165667b1u;
    configHash ^= uint(SECTION_LIGHT_PROBE_RT_CACHE_ONLY) * 0x1b873593u;
    configHash ^= uint(SECTION_LIGHT_PROBE_RT_SURFACE_CACHE) * 0x7f4a7c15u;
    configHash ^= floatBitsToUint(float(SECTION_LIGHT_PROBE_SURFACE_CACHE_OFFSET)) * 0x94d049bbu;
    configHash ^= uint(SECTION_LIGHT_PROBE_RT_REQUIRE_CORNERS) * 0x85ebca77u;
    configHash ^= SECTION_LIGHT_PROBE_RT_CACHE_REVISION * 0x85ebca6bu;
    return 0x80000000u | (configHash & 0x7fffffffu);
}

uint sectionLightProbeRtCacheInFlightState() {
    return sectionLightProbeRtCacheReadyState() ^ 0x40000000u;
}

uint readSectionLightProbeRtCacheState(int cellIndex) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return SECTION_LIGHT_PROBE_RT_CACHE_EMPTY;
#else
    return cellIndex >= 0
        ? atomicAdd(sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.z, 0u)
        : SECTION_LIGHT_PROBE_RT_CACHE_EMPTY;
#endif
}

uint sectionLightProbeRtCacheFaceReadyBit(int face) {
    return 1u << uint(clamp(face, 0, SECTION_LIGHT_PROBE_FACE_COUNT - 1));
}

uint sectionLightProbeRtCacheFaceInFlightBit(int face) {
    return 1u << (uint(clamp(face, 0, SECTION_LIGHT_PROBE_FACE_COUNT - 1)) + 8u);
}

bool sectionLightProbeRtCacheFaceReady(int cellIndex, int face) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return false;
#else
    if (cellIndex < 0
            || readSectionLightProbeRtCacheState(cellIndex) != sectionLightProbeRtCacheReadyState()) {
        return false;
    }
    uint faceMask = atomicAdd(sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.w, 0u);
    return (faceMask & sectionLightProbeRtCacheFaceReadyBit(face)) != 0u;
#endif
}

bool readSectionLightProbeRtCacheFaceRadiance(int cellIndex, int face, out vec3 radiance) {
    radiance = vec3(0.0);
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return false;
#else
    if (!sectionLightProbeRtCacheFaceReady(cellIndex, face)) {
        return false;
    }

    memoryBarrierBuffer();
    uvec4 packedRadiance0123 = sectionLightProbeRtCacheCells[cellIndex].packedRadiance0123;
    uvec4 packedRadiance45State = sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State;
    uint packedRadiance = 0u;
    if (face == 0) {
        packedRadiance = packedRadiance0123.x;
    } else if (face == 1) {
        packedRadiance = packedRadiance0123.y;
    } else if (face == 2) {
        packedRadiance = packedRadiance0123.z;
    } else if (face == 3) {
        packedRadiance = packedRadiance0123.w;
    } else if (face == 4) {
        packedRadiance = packedRadiance45State.x;
    } else {
        packedRadiance = packedRadiance45State.y;
    }
    radiance = unpackSectionLightProbeRgb9E5(packedRadiance);
    return true;
#endif
}

bool readSectionLightProbeRtCacheRadiance(int slot, int faceValueIndex, out vec3 radiance) {
    radiance = vec3(0.0);
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return false;
#else
    if (faceValueIndex < 0 || faceValueIndex >= SECTION_LIGHT_PROBE_FACE_VALUE_COUNT) {
        return false;
    }
    int probeIndex = faceValueIndex / SECTION_LIGHT_PROBE_FACE_COUNT;
    int face = faceValueIndex - probeIndex * SECTION_LIGHT_PROBE_FACE_COUNT;
    int cellIndex = sectionLightProbeRtCacheCellIndex(slot, probeIndex);
    return readSectionLightProbeRtCacheFaceRadiance(cellIndex, face, radiance);
#endif
}

bool readSectionLightProbeRtCacheCellRadiance(
    int slot,
    int probeIndex,
    out vec3 face0,
    out vec3 face1,
    out vec3 face2,
    out vec3 face3,
    out vec3 face4,
    out vec3 face5
) {
    face0 = vec3(0.0);
    face1 = vec3(0.0);
    face2 = vec3(0.0);
    face3 = vec3(0.0);
    face4 = vec3(0.0);
    face5 = vec3(0.0);
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return false;
#else
    int cellIndex = sectionLightProbeRtCacheCellIndex(slot, probeIndex);
    if (cellIndex < 0 || readSectionLightProbeRtCacheState(cellIndex) != sectionLightProbeRtCacheReadyState()) {
        return false;
    }
    uint faceMask = atomicAdd(sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.w, 0u);
    if ((faceMask & SECTION_LIGHT_PROBE_RT_CACHE_ALL_FACE_READY_MASK)
            != SECTION_LIGHT_PROBE_RT_CACHE_ALL_FACE_READY_MASK) {
        return false;
    }

    memoryBarrierBuffer();
    uvec4 packedRadiance0123 = sectionLightProbeRtCacheCells[cellIndex].packedRadiance0123;
    uvec4 packedRadiance45State = sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State;
    face0 = unpackSectionLightProbeRgb9E5(packedRadiance0123.x);
    face1 = unpackSectionLightProbeRgb9E5(packedRadiance0123.y);
    face2 = unpackSectionLightProbeRgb9E5(packedRadiance0123.z);
    face3 = unpackSectionLightProbeRgb9E5(packedRadiance0123.w);
    face4 = unpackSectionLightProbeRgb9E5(packedRadiance45State.x);
    face5 = unpackSectionLightProbeRgb9E5(packedRadiance45State.y);
    return true;
#endif
}

float unpackSectionLightProbeRawConfidence(uint packedConfidence) {
    if (packedConfidence == 0u) {
        return 0.0;
    }
    return float(packedConfidence) * (1.0 / 255.0);
}

float sectionLightProbeEffectiveConfidence(float rawConfidence) {
    if (rawConfidence <= 0.0) {
        return 0.0;
    }
    float floorValue = min(clamp(SECTION_LIGHT_PROBE_CONFIDENCE_FLOOR, 0.0, 1.0), 0.02);
    return max(rawConfidence, floorValue);
}

float unpackSectionLightProbeConfidence(uint packedConfidence) {
    return sectionLightProbeEffectiveConfidence(unpackSectionLightProbeRawConfidence(packedConfidence));
}

uvec4 readPackedSectionLightProbeRecord(int slot, int recordIndex) {
    int dataRecordIndex = SECTION_LIGHT_PROBE_DIRECTORY_RECORDS
        + slot * SECTION_LIGHT_PROBE_RECORDS_PER_PAGE
        + recordIndex;
    return uvec4(sectionLightProbeRecords[dataRecordIndex]);
}

uint readPackedSectionLightProbeRecordComponent(int slot, int recordIndex, int component) {
    return readPackedSectionLightProbeRecord(slot, recordIndex)[component];
}

uint readPackedSectionLightProbeFace(int slot, int faceValueIndex) {
    int recordIndex = faceValueIndex / SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD;
    int component = faceValueIndex - recordIndex * SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD;
    return readPackedSectionLightProbeRecordComponent(slot, recordIndex, component);
}

uint readPackedSectionLightProbeConfidence(int slot, int faceValueIndex) {
    int confidenceWordIndex = faceValueIndex / SECTION_LIGHT_PROBE_CONFIDENCE_VALUES_PER_WORD;
    int recordIndex = SECTION_LIGHT_PROBE_CONFIDENCE_RECORD_OFFSET
        + confidenceWordIndex / SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD;
    int component = confidenceWordIndex - (confidenceWordIndex / SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD)
        * SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD;
    uint packedWord = readPackedSectionLightProbeRecordComponent(slot, recordIndex, component);
    int byteShift = (faceValueIndex - confidenceWordIndex * SECTION_LIGHT_PROBE_CONFIDENCE_VALUES_PER_WORD) * 8;
    return (packedWord >> uint(byteShift)) & 255u;
}

uint readPackedSectionLightProbeConfidenceWord(int slot, int confidenceWordIndex) {
    int recordIndex = SECTION_LIGHT_PROBE_CONFIDENCE_RECORD_OFFSET
        + confidenceWordIndex / SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD;
    int component = confidenceWordIndex - (confidenceWordIndex / SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD)
        * SECTION_LIGHT_PROBE_PACKED_VALUES_PER_RECORD;
    return readPackedSectionLightProbeRecordComponent(slot, recordIndex, component);
}

uint sectionLightProbeConfidenceByte(uint word0, uint word1, int byteOffset) {
    if (byteOffset < SECTION_LIGHT_PROBE_CONFIDENCE_VALUES_PER_WORD) {
        return (word0 >> uint(byteOffset * 8)) & 255u;
    }
    return (word1 >> uint((byteOffset - SECTION_LIGHT_PROBE_CONFIDENCE_VALUES_PER_WORD) * 8)) & 255u;
}

float sectionLightProbeCoveredCornerWeight(float confidence, float interpolationWeight) {
    return confidence > 0.0001 ? interpolationWeight : 0.0;
}

vec3 decodeSectionLightProbeFace(int slot, int faceValueIndex, uint packedRadiance) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    vec3 rtRadiance;
    if (readSectionLightProbeRtCacheRadiance(slot, faceValueIndex, rtRadiance)) {
        return rtRadiance;
    }
#endif
    return unpackSectionLightProbeRgb9E5(packedRadiance)
        * unpackSectionLightProbeConfidence(readPackedSectionLightProbeConfidence(slot, faceValueIndex));
}

vec3 decodeSectionLightProbeFaceWithConfidence(
    int slot,
    int faceValueIndex,
    uint packedRadiance,
    uint packedConfidence
) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    vec3 rtRadiance;
    if (readSectionLightProbeRtCacheRadiance(slot, faceValueIndex, rtRadiance)) {
        return rtRadiance;
    }
#endif
    return unpackSectionLightProbeRgb9E5(packedRadiance)
        * unpackSectionLightProbeConfidence(packedConfidence);
}

float decodeSectionLightProbeRawFaceConfidence(int slot, int faceValueIndex) {
    return unpackSectionLightProbeRawConfidence(readPackedSectionLightProbeConfidence(slot, faceValueIndex));
}

void sampleSectionLightProbeFacesAtCoord(
    int slot,
    ivec3 probeCoord,
    out vec3 face0,
    out vec3 face1,
    out vec3 face2,
    out vec3 face3,
    out vec3 face4,
    out vec3 face5
) {
    probeCoord = clamp(probeCoord, ivec3(0), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    int probeIndex = (probeCoord.z * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.y)
        * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.x;
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    if (readSectionLightProbeRtCacheCellRadiance(
            slot,
            probeIndex,
            face0,
            face1,
            face2,
            face3,
            face4,
            face5)) {
        return;
    }
#endif
    int firstRecordIndex = probeIndex + (probeIndex >> 1);
    uvec4 record0 = readPackedSectionLightProbeRecord(slot, firstRecordIndex);
    uvec4 record1 = readPackedSectionLightProbeRecord(slot, firstRecordIndex + 1);

    if ((probeIndex & 1) == 0) {
        int firstFaceValueIndex = probeIndex * SECTION_LIGHT_PROBE_FACE_COUNT;
        face0 = decodeSectionLightProbeFace(slot, firstFaceValueIndex, record0.x);
        face1 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 1, record0.y);
        face2 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 2, record0.z);
        face3 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 3, record0.w);
        face4 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 4, record1.x);
        face5 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 5, record1.y);
        return;
    }

    int firstFaceValueIndex = probeIndex * SECTION_LIGHT_PROBE_FACE_COUNT;
    face0 = decodeSectionLightProbeFace(slot, firstFaceValueIndex, record0.z);
    face1 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 1, record0.w);
    face2 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 2, record1.x);
    face3 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 3, record1.y);
    face4 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 4, record1.z);
    face5 = decodeSectionLightProbeFace(slot, firstFaceValueIndex + 5, record1.w);
}

void sampleSectionLightProbeFacesNearest(
    int slot,
    vec3 probeCoord,
    out vec3 face0,
    out vec3 face1,
    out vec3 face2,
    out vec3 face3,
    out vec3 face4,
    out vec3 face5
) {
    sampleSectionLightProbeFacesAtCoord(
        slot,
        ivec3(floor(probeCoord + vec3(0.5))),
        face0,
        face1,
        face2,
        face3,
        face4,
        face5);
}

vec3 sectionLightProbeDiffuseResponse(vec3 diffuseAlbedo, vec3 F0, float metallic) {
    vec3 dielectricDiffuse = max(vec3(0.0), vec3(1.0) - clamp(F0, vec3(0.0), vec3(1.0)));
    return diffuseAlbedo * dielectricDiffuse * (1.0 - clamp(metallic, 0.0, 1.0));
}

float sectionLightProbeDirectionalWeight(vec3 normal, vec3 faceDirection) {
    float weight = max(dot(normal, faceDirection), 0.0);
    if (weight <= 0.0001) {
        return 0.0;
    }
    return pow(weight, clamp(float(SECTION_LIGHT_PROBE_DIRECTIONAL_SHARPNESS), 1.0, 2.0));
}

void accumulateSectionLightProbeDirection(
    inout vec3 incidentRadiance,
    inout float weightSum,
    vec3 faceRadiance,
    vec3 faceDirection,
    vec3 normal
) {
    if (dot(faceRadiance, faceRadiance) <= 0.0000001) {
        return;
    }

    float weight = sectionLightProbeDirectionalWeight(normal, faceDirection);
    if (weight <= 0.0001) {
        return;
    }
    incidentRadiance += faceRadiance * weight;
    weightSum += weight;
}

void accumulateSectionLightProbeFace(
    inout vec3 incidentRadiance,
    inout float weightSum,
    int face,
    vec3 faceRadiance,
    vec3 normal
) {
    accumulateSectionLightProbeDirection(
        incidentRadiance,
        weightSum,
        faceRadiance,
        sectionLightProbeFaceDirection(face),
        normal);
}

vec3 sectionLightProbeIncidentFromFaces(
    vec3 face0,
    vec3 face1,
    vec3 face2,
    vec3 face3,
    vec3 face4,
    vec3 face5,
    vec3 normal
) {
    vec3 incidentRadiance = vec3(0.0);
    float weightSum = 0.0;
    accumulateSectionLightProbeDirection(
        incidentRadiance, weightSum, face0 * SECTION_LIGHT_PROBE_INTENSITY, vec3(1.0, 0.0, 0.0), normal);
    accumulateSectionLightProbeDirection(
        incidentRadiance, weightSum, face1 * SECTION_LIGHT_PROBE_INTENSITY, vec3(-1.0, 0.0, 0.0), normal);
    accumulateSectionLightProbeDirection(
        incidentRadiance, weightSum, face2 * SECTION_LIGHT_PROBE_INTENSITY, vec3(0.0, 1.0, 0.0), normal);
    accumulateSectionLightProbeDirection(
        incidentRadiance, weightSum, face3 * SECTION_LIGHT_PROBE_INTENSITY, vec3(0.0, -1.0, 0.0), normal);
    accumulateSectionLightProbeDirection(
        incidentRadiance, weightSum, face4 * SECTION_LIGHT_PROBE_INTENSITY, vec3(0.0, 0.0, 1.0), normal);
    accumulateSectionLightProbeDirection(
        incidentRadiance, weightSum, face5 * SECTION_LIGHT_PROBE_INTENSITY, vec3(0.0, 0.0, -1.0), normal);
    if (weightSum > 0.0001) {
        incidentRadiance /= weightSum;
    }
    vec3 averageRadiance = (face0 + face1 + face2 + face3 + face4 + face5)
        * (SECTION_LIGHT_PROBE_INTENSITY * (1.0 / float(SECTION_LIGHT_PROBE_FACE_COUNT)));
    float shapeSmoothing = clamp(float(SECTION_LIGHT_PROBE_SHAPE_SMOOTHING), 0.0, 0.35);
    if (weightSum > 0.0001) {
        incidentRadiance = mix(incidentRadiance, averageRadiance, shapeSmoothing);
    }
    float isotropicFill = min(clamp(SECTION_LIGHT_PROBE_ISOTROPIC_FILL, 0.0, 1.0), 0.04);
    incidentRadiance += averageRadiance * isotropicFill;
    return incidentRadiance;
}

vec3 sampleSectionLightProbeIncidentAtCoord(int slot, ivec3 probeCoord, vec3 normal) {
    vec3 face0;
    vec3 face1;
    vec3 face2;
    vec3 face3;
    vec3 face4;
    vec3 face5;
    sampleSectionLightProbeFacesAtCoord(slot, probeCoord, face0, face1, face2, face3, face4, face5);
    return sectionLightProbeIncidentFromFaces(face0, face1, face2, face3, face4, face5, normal);
}

ivec3 sectionLightProbeWrappedOrigin(ivec3 sectionOrigin, inout ivec3 probeCoord) {
    ivec3 sectionDelta = ivec3(0);
    if (probeCoord.x < 0) {
        probeCoord.x += SECTION_LIGHT_PROBE_GRID_SIZE;
        sectionDelta.x = -1;
    } else if (probeCoord.x >= SECTION_LIGHT_PROBE_GRID_SIZE) {
        probeCoord.x -= SECTION_LIGHT_PROBE_GRID_SIZE;
        sectionDelta.x = 1;
    }
    if (probeCoord.y < 0) {
        probeCoord.y += SECTION_LIGHT_PROBE_GRID_SIZE;
        sectionDelta.y = -1;
    } else if (probeCoord.y >= SECTION_LIGHT_PROBE_GRID_SIZE) {
        probeCoord.y -= SECTION_LIGHT_PROBE_GRID_SIZE;
        sectionDelta.y = 1;
    }
    if (probeCoord.z < 0) {
        probeCoord.z += SECTION_LIGHT_PROBE_GRID_SIZE;
        sectionDelta.z = -1;
    } else if (probeCoord.z >= SECTION_LIGHT_PROBE_GRID_SIZE) {
        probeCoord.z -= SECTION_LIGHT_PROBE_GRID_SIZE;
        sectionDelta.z = 1;
    }
    return sectionOrigin + sectionDelta * 16;
}

vec3 sampleSectionLightProbeIncidentAtSectionCoord(ivec3 sectionOrigin, ivec3 probeCoord, vec3 normal) {
    ivec3 sampleCoord = probeCoord;
    ivec3 sampleSectionOrigin = sectionLightProbeWrappedOrigin(sectionOrigin, sampleCoord);
    int sampleSlot = findSectionLightProbeSlotByOrigin(sampleSectionOrigin);
    if (sampleSlot < 0) {
        return vec3(0.0);
    }
    return sampleSectionLightProbeIncidentAtCoord(sampleSlot, sampleCoord, normal);
}

void accumulateSectionLightProbeConfidenceDirection(
    inout float confidence,
    inout float weightSum,
    float faceConfidence,
    vec3 faceDirection,
    vec3 normal
) {
    float weight = sectionLightProbeDirectionalWeight(normal, faceDirection);
    if (weight <= 0.0001) {
        return;
    }
    confidence += faceConfidence * weight;
    weightSum += weight;
}

float sectionLightProbeConfidenceFromFaces(
    float face0,
    float face1,
    float face2,
    float face3,
    float face4,
    float face5,
    vec3 normal
) {
    float confidence = 0.0;
    float weightSum = 0.0;
    accumulateSectionLightProbeConfidenceDirection(
        confidence, weightSum, face0, vec3(1.0, 0.0, 0.0), normal);
    accumulateSectionLightProbeConfidenceDirection(
        confidence, weightSum, face1, vec3(-1.0, 0.0, 0.0), normal);
    accumulateSectionLightProbeConfidenceDirection(
        confidence, weightSum, face2, vec3(0.0, 1.0, 0.0), normal);
    accumulateSectionLightProbeConfidenceDirection(
        confidence, weightSum, face3, vec3(0.0, -1.0, 0.0), normal);
    accumulateSectionLightProbeConfidenceDirection(
        confidence, weightSum, face4, vec3(0.0, 0.0, 1.0), normal);
    accumulateSectionLightProbeConfidenceDirection(
        confidence, weightSum, face5, vec3(0.0, 0.0, -1.0), normal);

    float averageConfidence = (face0 + face1 + face2 + face3 + face4 + face5)
        * (1.0 / float(SECTION_LIGHT_PROBE_FACE_COUNT));
    float directionalConfidence = weightSum > 0.0001 ? confidence / weightSum : 0.0;
    float shapeSmoothing = clamp(float(SECTION_LIGHT_PROBE_SHAPE_SMOOTHING), 0.0, 0.35);
    if (weightSum > 0.0001) {
        directionalConfidence = mix(directionalConfidence, averageConfidence, shapeSmoothing);
    }
    float fill = min(clamp(SECTION_LIGHT_PROBE_ISOTROPIC_FILL, 0.0, 1.0), 0.04);
    return clamp((directionalConfidence * weightSum + averageConfidence * fill)
        / max(weightSum + fill, 0.0001), 0.0, 1.0);
}

float sampleSectionLightProbeFaceConfidenceNearest(int slot, ivec3 probeCoord, int face) {
    probeCoord = clamp(probeCoord, ivec3(0), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    int probeIndex = (probeCoord.z * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.y)
        * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.x;
    int faceValueIndex = probeIndex * SECTION_LIGHT_PROBE_FACE_COUNT + face;
    return decodeSectionLightProbeRawFaceConfidence(slot, faceValueIndex);
}

int sectionLightProbeIndexFromCoord(ivec3 probeCoord) {
    probeCoord = clamp(probeCoord, ivec3(0), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    return (probeCoord.z * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.y)
        * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.x;
}

int sectionLightProbeFaceValueIndex(ivec3 probeCoord, int face) {
    return sectionLightProbeIndexFromCoord(probeCoord) * SECTION_LIGHT_PROBE_FACE_COUNT
        + clamp(face, 0, SECTION_LIGHT_PROBE_FACE_COUNT - 1);
}

ivec3 sectionLightProbeNearestCoordForWorld(ivec3 sectionOrigin, vec3 worldPos) {
    vec3 sectionLocal = clamp(worldPos - vec3(sectionOrigin), vec3(0.0), vec3(15.999));
    return clamp(
        ivec3(floor(sectionLocal * (float(SECTION_LIGHT_PROBE_GRID_SIZE) / 16.0))),
        ivec3(0),
        ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
}

int sectionLightProbeRtCacheCellIndexForSectionCoord(
    ivec3 sectionOrigin,
    ivec3 probeCoord,
    out vec3 probeCenter
) {
    probeCenter = vec3(sectionOrigin);
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return -1;
#else
    ivec3 sampleCoord = probeCoord;
    ivec3 sampleSectionOrigin = sectionLightProbeWrappedOrigin(sectionOrigin, sampleCoord);
    int slot = findSectionLightProbeSlotByOrigin(sampleSectionOrigin);
    if (slot < 0) {
        return -1;
    }

    int slotLimit = min(int(sectionLightProbeRtCacheHeader.y), SECTION_LIGHT_PROBE_MAX_PAGES);
    if (slot >= slotLimit) {
        return -1;
    }

    float probeSpacing = 16.0 / float(SECTION_LIGHT_PROBE_GRID_SIZE);
    probeCenter = vec3(sampleSectionOrigin)
        + (vec3(sampleCoord) + vec3(0.5)) * probeSpacing;
    return sectionLightProbeRtCacheCellIndex(slot, sectionLightProbeIndexFromCoord(sampleCoord));
#endif
}

bool claimSectionLightProbeRtCacheCell(int cellIndex) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return false;
#else
    if (cellIndex < 0) {
        return false;
    }
    uint readyState = sectionLightProbeRtCacheReadyState();
    uint inFlightState = sectionLightProbeRtCacheInFlightState();
    uint currentState = atomicAdd(sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.z, 0u);
    if (currentState == readyState || currentState == inFlightState) {
        return false;
    }
    if (currentState != SECTION_LIGHT_PROBE_RT_CACHE_EMPTY) {
        atomicCompSwap(
            sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.z,
            currentState,
            SECTION_LIGHT_PROBE_RT_CACHE_EMPTY);
    }
    return atomicCompSwap(
        sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.z,
        SECTION_LIGHT_PROBE_RT_CACHE_EMPTY,
        inFlightState) == SECTION_LIGHT_PROBE_RT_CACHE_EMPTY;
#endif
}

void completeSectionLightProbeRtCacheCell(
    int cellIndex,
    vec3 face0,
    vec3 face1,
    vec3 face2,
    vec3 face3,
    vec3 face4,
    vec3 face5
) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    if (cellIndex >= 0 && cellIndex < int(sectionLightProbeRtCacheHeader.w)) {
        sectionLightProbeRtCacheCells[cellIndex].packedRadiance0123 = uvec4(
            packSectionLightProbeRgb9E5(face0),
            packSectionLightProbeRgb9E5(face1),
            packSectionLightProbeRgb9E5(face2),
            packSectionLightProbeRgb9E5(face3));
        sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.x = packSectionLightProbeRgb9E5(face4);
        sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.y = packSectionLightProbeRgb9E5(face5);
        sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.w =
            SECTION_LIGHT_PROBE_RT_CACHE_ALL_FACE_READY_MASK;
        memoryBarrierBuffer();
        atomicExchange(
            sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.z,
            sectionLightProbeRtCacheReadyState());
    }
#endif
}

bool sectionLightSurfaceRtCacheAddress(
    vec3 worldPos,
    vec3 normal,
    out int cellIndex,
    out int face
) {
    cellIndex = -1;
    face = sectionLightProbeDominantNormalFace(normal);
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return false;
#else
    ivec3 sectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
    ivec3 probeCoord = sectionLightProbeNearestCoordForWorld(sectionOrigin, worldPos);
    vec3 ignoredProbeCenter;
    cellIndex = sectionLightProbeRtCacheCellIndexForSectionCoord(
        sectionOrigin,
        probeCoord,
        ignoredProbeCenter);
    return cellIndex >= 0;
#endif
}

bool sampleSectionLightSurfaceRt(
    vec3 shadingWorldPos,
    vec3 normal,
    out vec3 incidentRadiance
) {
    incidentRadiance = vec3(0.0);
#if SECTION_LIGHT_TABLE_ENABLE == 0 || SECTION_LIGHT_SPARSE_RT_SAMPLES <= 0
    return false;
#else
    vec3 resolvedIncidentRadiance;
    float visibilityRatio = sampleSectionLightSparseRt(
        shadingWorldPos,
        normal,
        resolvedIncidentRadiance);
    incidentRadiance = max(resolvedIncidentRadiance, vec3(0.0))
        * max(float(SECTION_LIGHT_PROBE_INTENSITY), 0.0);
    return visibilityRatio >= 0.0;
#endif
}

void populateSectionLightProbeRtCacheCell(ivec3 sectionOrigin, ivec3 probeCoord) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    vec3 probeCenter;
    int cellIndex = sectionLightProbeRtCacheCellIndexForSectionCoord(
        sectionOrigin,
        probeCoord,
        probeCenter);
    if (!claimSectionLightProbeRtCacheCell(cellIndex)) {
        return;
    }

    vec3 face0;
    vec3 face1;
    vec3 face2;
    vec3 face3;
    vec3 face4;
    vec3 face5;
    sampleSectionLightProbeRtCell(
        probeCenter,
        face0,
        face1,
        face2,
        face3,
        face4,
        face5);
    completeSectionLightProbeRtCacheCell(
        cellIndex,
        face0,
        face1,
        face2,
        face3,
        face4,
        face5);
#endif
}

void populateRequestedSectionLightProbeRtCacheCell() {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    uint requestIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    uint requestCount = min(
        sectionLightProbeFillRequestHeader.x,
        sectionLightProbeFillRequestHeader.z);
    if (sectionLightProbeFillRequestHeader.y != sectionLightProbeRtCacheHeader.z
            || requestIndex >= requestCount) {
        return;
    }

    ivec4 request = sectionLightProbeFillRequests[requestIndex];
    int probeIndex = request.w;
    if (probeIndex < 0 || probeIndex >= SECTION_LIGHT_PROBE_CELL_COUNT) {
        return;
    }
    int probeX = probeIndex % SECTION_LIGHT_PROBE_GRID_SIZE;
    int probeY = (probeIndex / SECTION_LIGHT_PROBE_GRID_SIZE) % SECTION_LIGHT_PROBE_GRID_SIZE;
    int probeZ = probeIndex
        / (SECTION_LIGHT_PROBE_GRID_SIZE * SECTION_LIGHT_PROBE_GRID_SIZE);
    populateSectionLightProbeRtCacheCell(
        request.xyz,
        ivec3(probeX, probeY, probeZ));
#endif
}

void populateSectionLightProbeRtCacheCorners(vec3 worldPos) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    ivec3 sectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
    vec3 sectionLocal = clamp(worldPos - vec3(sectionOrigin), vec3(0.0), vec3(15.999));
    vec3 probeCoord = sectionLocal
        * (float(SECTION_LIGHT_PROBE_GRID_SIZE) / 16.0)
        - vec3(0.5);
    vec3 unclampedCoord = clamp(
        probeCoord,
        vec3(-1.0),
        vec3(float(SECTION_LIGHT_PROBE_GRID_SIZE)));
    ivec3 baseCoord = ivec3(floor(unclampedCoord));
    ivec3 nextCoord = baseCoord + ivec3(1);

    populateSectionLightProbeRtCacheCell(sectionOrigin, baseCoord);
    populateSectionLightProbeRtCacheCell(
        sectionOrigin,
        ivec3(nextCoord.x, baseCoord.y, baseCoord.z));
    populateSectionLightProbeRtCacheCell(
        sectionOrigin,
        ivec3(baseCoord.x, nextCoord.y, baseCoord.z));
    populateSectionLightProbeRtCacheCell(
        sectionOrigin,
        ivec3(nextCoord.x, nextCoord.y, baseCoord.z));
    populateSectionLightProbeRtCacheCell(
        sectionOrigin,
        ivec3(baseCoord.x, baseCoord.y, nextCoord.z));
    populateSectionLightProbeRtCacheCell(
        sectionOrigin,
        ivec3(nextCoord.x, baseCoord.y, nextCoord.z));
    populateSectionLightProbeRtCacheCell(
        sectionOrigin,
        ivec3(baseCoord.x, nextCoord.y, nextCoord.z));
    populateSectionLightProbeRtCacheCell(sectionOrigin, nextCoord);
#endif
}

bool sectionLightProbeRtCacheCellReady(ivec3 sectionOrigin, ivec3 probeCoord) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return true;
#else
    vec3 ignoredProbeCenter;
    int cellIndex = sectionLightProbeRtCacheCellIndexForSectionCoord(
        sectionOrigin,
        probeCoord,
        ignoredProbeCenter);
    return cellIndex < 0
        || readSectionLightProbeRtCacheState(cellIndex)
            == sectionLightProbeRtCacheReadyState();
#endif
}

bool sectionLightProbeRtCacheCornersReady(vec3 worldPos) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    return true;
#else
    ivec3 sectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
    vec3 sectionLocal = clamp(worldPos - vec3(sectionOrigin), vec3(0.0), vec3(15.999));
    vec3 probeCoord = sectionLocal
        * (float(SECTION_LIGHT_PROBE_GRID_SIZE) / 16.0)
        - vec3(0.5);
    vec3 unclampedCoord = clamp(
        probeCoord,
        vec3(-1.0),
        vec3(float(SECTION_LIGHT_PROBE_GRID_SIZE)));
    ivec3 baseCoord = ivec3(floor(unclampedCoord));
    ivec3 nextCoord = baseCoord + ivec3(1);

    return sectionLightProbeRtCacheCellReady(sectionOrigin, baseCoord)
        && sectionLightProbeRtCacheCellReady(
            sectionOrigin,
            ivec3(nextCoord.x, baseCoord.y, baseCoord.z))
        && sectionLightProbeRtCacheCellReady(
            sectionOrigin,
            ivec3(baseCoord.x, nextCoord.y, baseCoord.z))
        && sectionLightProbeRtCacheCellReady(
            sectionOrigin,
            ivec3(nextCoord.x, nextCoord.y, baseCoord.z))
        && sectionLightProbeRtCacheCellReady(
            sectionOrigin,
            ivec3(baseCoord.x, baseCoord.y, nextCoord.z))
        && sectionLightProbeRtCacheCellReady(
            sectionOrigin,
            ivec3(nextCoord.x, baseCoord.y, nextCoord.z))
        && sectionLightProbeRtCacheCellReady(
            sectionOrigin,
            ivec3(baseCoord.x, nextCoord.y, nextCoord.z))
        && sectionLightProbeRtCacheCellReady(sectionOrigin, nextCoord);
#endif
}

float sampleSectionLightProbeConfidenceAtCoord(int slot, ivec3 probeCoord, vec3 normal) {
    probeCoord = clamp(probeCoord, ivec3(0), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    int probeIndex = (probeCoord.z * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.y)
        * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.x;
    int firstFaceValueIndex = probeIndex * SECTION_LIGHT_PROBE_FACE_COUNT;
    return sectionLightProbeConfidenceFromFaces(
        decodeSectionLightProbeRawFaceConfidence(slot, firstFaceValueIndex),
        decodeSectionLightProbeRawFaceConfidence(slot, firstFaceValueIndex + 1),
        decodeSectionLightProbeRawFaceConfidence(slot, firstFaceValueIndex + 2),
        decodeSectionLightProbeRawFaceConfidence(slot, firstFaceValueIndex + 3),
        decodeSectionLightProbeRawFaceConfidence(slot, firstFaceValueIndex + 4),
        decodeSectionLightProbeRawFaceConfidence(slot, firstFaceValueIndex + 5),
        normal);
}

float sampleSectionLightProbeConfidenceAtSectionCoord(ivec3 sectionOrigin, ivec3 probeCoord, vec3 normal) {
    ivec3 sampleCoord = probeCoord;
    ivec3 sampleSectionOrigin = sectionLightProbeWrappedOrigin(sectionOrigin, sampleCoord);
    int sampleSlot = findSectionLightProbeSlotByOrigin(sampleSectionOrigin);
    if (sampleSlot < 0) {
        return 0.0;
    }
    return sampleSectionLightProbeConfidenceAtCoord(sampleSlot, sampleCoord, normal);
}

void sampleSectionLightProbeDataAtCoord(
    int slot,
    ivec3 probeCoord,
    vec3 normal,
    out vec3 incidentRadiance,
    out float confidence
) {
    probeCoord = clamp(probeCoord, ivec3(0), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    int probeIndex = (probeCoord.z * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.y)
        * SECTION_LIGHT_PROBE_GRID_SIZE + probeCoord.x;
    vec3 face0;
    vec3 face1;
    vec3 face2;
    vec3 face3;
    vec3 face4;
    vec3 face5;
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    if (readSectionLightProbeRtCacheCellRadiance(
            slot,
            probeIndex,
            face0,
            face1,
            face2,
            face3,
            face4,
            face5)) {
        incidentRadiance = sectionLightProbeIncidentFromFaces(face0, face1, face2, face3, face4, face5, normal);
        confidence = 1.0;
        return;
    }
#if SECTION_LIGHT_PROBE_RT_CACHE_ONLY != 0
    incidentRadiance = vec3(0.0);
    confidence = 0.0;
    return;
#endif
#endif

    int firstRecordIndex = probeIndex + (probeIndex >> 1);
    uvec4 record0 = readPackedSectionLightProbeRecord(slot, firstRecordIndex);
    uvec4 record1 = readPackedSectionLightProbeRecord(slot, firstRecordIndex + 1);

    int firstFaceValueIndex = probeIndex * SECTION_LIGHT_PROBE_FACE_COUNT;
    int firstConfidenceWordIndex = firstFaceValueIndex / SECTION_LIGHT_PROBE_CONFIDENCE_VALUES_PER_WORD;
    int firstConfidenceByteOffset = firstFaceValueIndex - firstConfidenceWordIndex * SECTION_LIGHT_PROBE_CONFIDENCE_VALUES_PER_WORD;
    uint confidenceWord0 = readPackedSectionLightProbeConfidenceWord(slot, firstConfidenceWordIndex);
    uint confidenceWord1 = readPackedSectionLightProbeConfidenceWord(slot, firstConfidenceWordIndex + 1);
    uint confidence0 = sectionLightProbeConfidenceByte(confidenceWord0, confidenceWord1, firstConfidenceByteOffset);
    uint confidence1 = sectionLightProbeConfidenceByte(confidenceWord0, confidenceWord1, firstConfidenceByteOffset + 1);
    uint confidence2 = sectionLightProbeConfidenceByte(confidenceWord0, confidenceWord1, firstConfidenceByteOffset + 2);
    uint confidence3 = sectionLightProbeConfidenceByte(confidenceWord0, confidenceWord1, firstConfidenceByteOffset + 3);
    uint confidence4 = sectionLightProbeConfidenceByte(confidenceWord0, confidenceWord1, firstConfidenceByteOffset + 4);
    uint confidence5 = sectionLightProbeConfidenceByte(confidenceWord0, confidenceWord1, firstConfidenceByteOffset + 5);

    if ((probeIndex & 1) == 0) {
        face0 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex, record0.x, confidence0);
        face1 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 1, record0.y, confidence1);
        face2 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 2, record0.z, confidence2);
        face3 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 3, record0.w, confidence3);
        face4 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 4, record1.x, confidence4);
        face5 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 5, record1.y, confidence5);
    } else {
        face0 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex, record0.z, confidence0);
        face1 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 1, record0.w, confidence1);
        face2 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 2, record1.x, confidence2);
        face3 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 3, record1.y, confidence3);
        face4 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 4, record1.z, confidence4);
        face5 = decodeSectionLightProbeFaceWithConfidence(slot, firstFaceValueIndex + 5, record1.w, confidence5);
    }

    incidentRadiance = sectionLightProbeIncidentFromFaces(face0, face1, face2, face3, face4, face5, normal);
    confidence = sectionLightProbeConfidenceFromFaces(
        unpackSectionLightProbeRawConfidence(confidence0),
        unpackSectionLightProbeRawConfidence(confidence1),
        unpackSectionLightProbeRawConfidence(confidence2),
        unpackSectionLightProbeRawConfidence(confidence3),
        unpackSectionLightProbeRawConfidence(confidence4),
        unpackSectionLightProbeRawConfidence(confidence5),
        normal);
}

void sampleSectionLightProbeDataAtSectionCoord(
    ivec3 sectionOrigin,
    ivec3 probeCoord,
    vec3 normal,
    out vec3 incidentRadiance,
    out float confidence
) {
    ivec3 sampleCoord = probeCoord;
    ivec3 sampleSectionOrigin = sectionLightProbeWrappedOrigin(sectionOrigin, sampleCoord);
    int sampleSlot = findSectionLightProbeSlotByOrigin(sampleSectionOrigin);
    if (sampleSlot < 0) {
        incidentRadiance = vec3(0.0);
        confidence = 0.0;
        return;
    }
    sampleSectionLightProbeDataAtCoord(sampleSlot, sampleCoord, normal, incidentRadiance, confidence);
}

void sampleSectionLightProbeVolumeData(
    vec3 worldPos,
    vec3 normal,
    out vec3 incidentRadiance,
    out float confidence
) {
#if SECTION_LIGHT_PROBE_VOLUME_ENABLE == 0
    incidentRadiance = vec3(0.0);
    confidence = 0.0;
#else
    ivec3 sectionOrigin = ivec3(floor(worldPos / 16.0)) * 16;
    vec3 sectionLocal = clamp(worldPos - vec3(sectionOrigin), vec3(0.0), vec3(15.999));
    vec3 probeCoord = sectionLocal * (float(SECTION_LIGHT_PROBE_GRID_SIZE) / 16.0) - vec3(0.5);

#if SECTION_LIGHT_PROBE_TRILINEAR == 0
    int slot = findSectionLightProbeSlotByOrigin(sectionOrigin);
    if (slot < 0) {
        incidentRadiance = vec3(0.0);
        confidence = 0.0;
        return;
    }
    sampleSectionLightProbeDataAtCoord(
        slot,
        ivec3(floor(probeCoord + vec3(0.5))),
        normal,
        incidentRadiance,
        confidence);
#else
    vec3 unclampedCoord = clamp(
        probeCoord,
        vec3(-1.0),
        vec3(float(SECTION_LIGHT_PROBE_GRID_SIZE)));
    ivec3 baseCoord = ivec3(floor(unclampedCoord));
    ivec3 nextCoord = baseCoord + ivec3(1);
    vec3 blend = unclampedCoord - vec3(baseCoord);

#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0 && SECTION_LIGHT_PROBE_RT_CACHE_ONLY != 0 && SECTION_LIGHT_PROBE_RT_REQUIRE_CORNERS != 0
    if (!sectionLightProbeRtCacheCornersReady(worldPos)) {
        incidentRadiance = vec3(0.0);
        confidence = 0.0;
        return;
    }
#endif

    vec3 i000;
    vec3 i100;
    vec3 i010;
    vec3 i110;
    vec3 i001;
    vec3 i101;
    vec3 i011;
    vec3 i111;
    float c000;
    float c100;
    float c010;
    float c110;
    float c001;
    float c101;
    float c011;
    float c111;

    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, baseCoord, normal, i000, c000);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, ivec3(nextCoord.x, baseCoord.y, baseCoord.z), normal, i100, c100);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, ivec3(baseCoord.x, nextCoord.y, baseCoord.z), normal, i010, c010);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, ivec3(nextCoord.x, nextCoord.y, baseCoord.z), normal, i110, c110);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, ivec3(baseCoord.x, baseCoord.y, nextCoord.z), normal, i001, c001);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, ivec3(nextCoord.x, baseCoord.y, nextCoord.z), normal, i101, c101);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, ivec3(baseCoord.x, nextCoord.y, nextCoord.z), normal, i011, c011);
    sampleSectionLightProbeDataAtSectionCoord(sectionOrigin, nextCoord, normal, i111, c111);

    vec3 inverseBlend = vec3(1.0) - blend;
    float w000 = inverseBlend.x * inverseBlend.y * inverseBlend.z;
    float w100 = blend.x * inverseBlend.y * inverseBlend.z;
    float w010 = inverseBlend.x * blend.y * inverseBlend.z;
    float w110 = blend.x * blend.y * inverseBlend.z;
    float w001 = inverseBlend.x * inverseBlend.y * blend.z;
    float w101 = blend.x * inverseBlend.y * blend.z;
    float w011 = inverseBlend.x * blend.y * blend.z;
    float w111 = blend.x * blend.y * blend.z;

#if SECTION_LIGHT_PROBE_COVERAGE_NORMALIZATION != 0 && SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    float coverageWeight =
        sectionLightProbeCoveredCornerWeight(c000, w000)
        + sectionLightProbeCoveredCornerWeight(c100, w100)
        + sectionLightProbeCoveredCornerWeight(c010, w010)
        + sectionLightProbeCoveredCornerWeight(c110, w110)
        + sectionLightProbeCoveredCornerWeight(c001, w001)
        + sectionLightProbeCoveredCornerWeight(c101, w101)
        + sectionLightProbeCoveredCornerWeight(c011, w011)
        + sectionLightProbeCoveredCornerWeight(c111, w111);

    if (coverageWeight > 0.0001) {
        incidentRadiance = (
            i000 * w000
            + i100 * w100
            + i010 * w010
            + i110 * w110
            + i001 * w001
            + i101 * w101
            + i011 * w011
            + i111 * w111) / coverageWeight;
        confidence = clamp((
            c000 * w000
            + c100 * w100
            + c010 * w010
            + c110 * w110
            + c001 * w001
            + c101 * w101
            + c011 * w011
            + c111 * w111) / coverageWeight, 0.0, 1.0)
            * clamp(coverageWeight, 0.0, 1.0);
    } else {
        incidentRadiance = vec3(0.0);
        confidence = 0.0;
    }
#else
    incidentRadiance =
        i000 * w000
        + i100 * w100
        + i010 * w010
        + i110 * w110
        + i001 * w001
        + i101 * w101
        + i011 * w011
        + i111 * w111;
    confidence = clamp(
        c000 * w000
        + c100 * w100
        + c010 * w010
        + c110 * w110
        + c001 * w001
        + c101 * w101
        + c011 * w011
        + c111 * w111,
        0.0,
        1.0);
#endif
#endif

#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0 && SECTION_LIGHT_PROBE_RT_LEAK_CLAMP != 0 && SECTION_LIGHT_PROBE_TRILINEAR != 0
    vec3 nearestIncidentRadiance;
    float nearestConfidence;
    sampleSectionLightProbeDataAtSectionCoord(
        sectionOrigin,
        ivec3(floor(probeCoord + vec3(0.5))),
        normal,
        nearestIncidentRadiance,
        nearestConfidence);
    float trilinearLuma = dot(incidentRadiance, vec3(0.2126, 0.7152, 0.0722));
    float nearestLuma = dot(max(nearestIncidentRadiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
    float leakClampRatio = clamp(float(SECTION_LIGHT_PROBE_RT_LEAK_CLAMP_RATIO), 1.0, 4.0);
    float leakClampFloor = max(float(SECTION_LIGHT_PROBE_MIN_BRIGHTNESS) * 4.0, 0.0025);
    float maxLeakLuma = max(nearestLuma * leakClampRatio, leakClampFloor);
    if (nearestConfidence > 0.5 && trilinearLuma > maxLeakLuma && trilinearLuma > 0.0001) {
        incidentRadiance *= maxLeakLuma / trilinearLuma;
    }
#endif

    incidentRadiance = clampSectionLightToSourceShape(worldPos, incidentRadiance);

    incidentRadiance = max(incidentRadiance, vec3(0.0));
#endif
}

vec3 sampleSectionLightProbeFaceNearest(int slot, ivec3 probeCoord, int face) {
    int faceValueIndex = sectionLightProbeFaceValueIndex(probeCoord, face);
    return decodeSectionLightProbeFace(slot, faceValueIndex, readPackedSectionLightProbeFace(slot, faceValueIndex));
}

vec3 sampleSectionLightProbeFace(int slot, vec3 probeCoord, int face) {
#if SECTION_LIGHT_PROBE_TRILINEAR == 0
    return sampleSectionLightProbeFaceNearest(slot, ivec3(floor(probeCoord + vec3(0.5))), face);
#else
    vec3 clampedCoord = clamp(
        probeCoord,
        vec3(0.0),
        vec3(float(SECTION_LIGHT_PROBE_GRID_SIZE - 1)));
    ivec3 baseCoord = ivec3(floor(clampedCoord));
    ivec3 nextCoord = min(baseCoord + ivec3(1), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    vec3 blend = clampedCoord - vec3(baseCoord);

    vec3 c000 = sampleSectionLightProbeFaceNearest(slot, baseCoord, face);
    vec3 c100 = sampleSectionLightProbeFaceNearest(slot, ivec3(nextCoord.x, baseCoord.y, baseCoord.z), face);
    vec3 c010 = sampleSectionLightProbeFaceNearest(slot, ivec3(baseCoord.x, nextCoord.y, baseCoord.z), face);
    vec3 c110 = sampleSectionLightProbeFaceNearest(slot, ivec3(nextCoord.x, nextCoord.y, baseCoord.z), face);
    vec3 c001 = sampleSectionLightProbeFaceNearest(slot, ivec3(baseCoord.x, baseCoord.y, nextCoord.z), face);
    vec3 c101 = sampleSectionLightProbeFaceNearest(slot, ivec3(nextCoord.x, baseCoord.y, nextCoord.z), face);
    vec3 c011 = sampleSectionLightProbeFaceNearest(slot, ivec3(baseCoord.x, nextCoord.y, nextCoord.z), face);
    vec3 c111 = sampleSectionLightProbeFaceNearest(slot, nextCoord, face);

    vec3 cx00 = mix(c000, c100, blend.x);
    vec3 cx10 = mix(c010, c110, blend.x);
    vec3 cx01 = mix(c001, c101, blend.x);
    vec3 cx11 = mix(c011, c111, blend.x);
    vec3 cxy0 = mix(cx00, cx10, blend.y);
    vec3 cxy1 = mix(cx01, cx11, blend.y);
    return mix(cxy0, cxy1, blend.z);
#endif
}

float sampleSectionLightProbeFaceConfidence(int slot, vec3 probeCoord, int face) {
#if SECTION_LIGHT_PROBE_TRILINEAR == 0
    return sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(floor(probeCoord + vec3(0.5))), face);
#else
    vec3 clampedCoord = clamp(
        probeCoord,
        vec3(0.0),
        vec3(float(SECTION_LIGHT_PROBE_GRID_SIZE - 1)));
    ivec3 baseCoord = ivec3(floor(clampedCoord));
    ivec3 nextCoord = min(baseCoord + ivec3(1), ivec3(SECTION_LIGHT_PROBE_GRID_SIZE - 1));
    vec3 blend = clampedCoord - vec3(baseCoord);

    float c000 = sampleSectionLightProbeFaceConfidenceNearest(slot, baseCoord, face);
    float c100 = sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(nextCoord.x, baseCoord.y, baseCoord.z), face);
    float c010 = sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(baseCoord.x, nextCoord.y, baseCoord.z), face);
    float c110 = sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(nextCoord.x, nextCoord.y, baseCoord.z), face);
    float c001 = sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(baseCoord.x, baseCoord.y, nextCoord.z), face);
    float c101 = sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(nextCoord.x, baseCoord.y, nextCoord.z), face);
    float c011 = sampleSectionLightProbeFaceConfidenceNearest(slot, ivec3(baseCoord.x, nextCoord.y, nextCoord.z), face);
    float c111 = sampleSectionLightProbeFaceConfidenceNearest(slot, nextCoord, face);

    float cx00 = mix(c000, c100, blend.x);
    float cx10 = mix(c010, c110, blend.x);
    float cx01 = mix(c001, c101, blend.x);
    float cx11 = mix(c011, c111, blend.x);
    float cxy0 = mix(cx00, cx10, blend.y);
    float cxy1 = mix(cx01, cx11, blend.y);
    return mix(cxy0, cxy1, blend.z);
#endif
}

float sampleSectionLightProbeConfidenceVolume(
    vec3 worldPos,
    vec3 normal
) {
    vec3 incidentRadiance;
    float confidence;
    sampleSectionLightProbeVolumeData(worldPos, normal, incidentRadiance, confidence);
    return confidence;
}

vec3 sampleSectionLightProbeIncidentVolume(
    vec3 worldPos,
    vec3 normal
) {
    vec3 incidentRadiance = vec3(0.0);
    float confidence;
    sampleSectionLightProbeVolumeData(worldPos, normal, incidentRadiance, confidence);
    return incidentRadiance;
}

vec3 sampleSectionLightProbeVolume(
    vec3 worldPos,
    vec3 normal,
    vec3 diffuseAlbedo,
    vec3 F0,
    float metallic
) {
    vec3 incidentRadiance = sampleSectionLightProbeIncidentVolume(worldPos, normal);
    vec3 diffuseResponse = sectionLightProbeDiffuseResponse(diffuseAlbedo, F0, metallic);
    return max(incidentRadiance * diffuseResponse, vec3(0.0));
}

#if SECTION_LIGHT_PROBE_DEBUG_MODE != 0
vec3 debugSectionLightProbeRtCacheState(vec3 worldPos, vec3 normal) {
    int cellIndex;
    int face;
    if (!sectionLightSurfaceRtCacheAddress(worldPos, normal, cellIndex, face)) {
        return vec3(1.0, 0.24, 0.02);
    }

    uint state = readSectionLightProbeRtCacheState(cellIndex);
    uint faceMask = atomicAdd(
        sectionLightProbeRtCacheCells[cellIndex].packedRadiance45State.w,
        0u);
    if (state == sectionLightProbeRtCacheInFlightState()
            || (faceMask & sectionLightProbeRtCacheFaceInFlightBit(face)) != 0u) {
        return vec3(1.0, 0.82, 0.05);
    }
    if (state == sectionLightProbeRtCacheReadyState()) {
        if ((faceMask & sectionLightProbeRtCacheFaceReadyBit(face)) != 0u) {
            return vec3(0.05, 0.95, 0.28);
        }
        return vec3(0.08, 0.38, 1.0);
    }
    if (state == SECTION_LIGHT_PROBE_RT_CACHE_EMPTY) {
        return vec3(1.0, 0.24, 0.02);
    }
    return vec3(0.95, 0.02, 0.82);
}

vec3 sectionLightProbeDebugMissingPage(vec3 worldPos) {
    float checker = mod(floor(worldPos.x) + floor(worldPos.y) + floor(worldPos.z), 2.0);
    return mix(vec3(0.08, 0.0, 0.12), vec3(1.0, 0.0, 0.85), checker);
}

vec3 sectionLightProbeDebugPageColor(ivec3 sectionOrigin, int slot) {
    uint h = hashUint(
        hashUint(uint(sectionOrigin.x) ^ 0x9e3779b9u, uint(sectionOrigin.y) ^ 0x85ebca6bu),
        uint(sectionOrigin.z) ^ 0xc2b2ae35u);
    vec3 color = vec3(
        float(h & 255u),
        float((h >> 8u) & 255u),
        float((h >> 16u) & 255u)) * (1.0 / 255.0);
    float slotShade = 0.68 + 0.32 * fract(float(slot) * 0.61803398875);
    return mix(vec3(0.08, 0.18, 0.12), color, 0.78) * slotShade + vec3(0.04);
}

float sectionLightProbeDebugLattice(vec3 sectionLocal) {
    vec3 probeCell = sectionLocal * (float(SECTION_LIGHT_PROBE_GRID_SIZE) / 16.0);
    vec3 cellFrac = fract(probeCell);
    vec3 edgeDist = min(cellFrac, vec3(1.0) - cellFrac);
    float nearestEdge = min(edgeDist.x, min(edgeDist.y, edgeDist.z));
    return 1.0 - smoothstep(0.025, 0.075, nearestEdge);
}

vec3 sectionLightProbeDebugFaceColor(int face) {
    if (face == 0) {
        return vec3(1.0, 0.08, 0.02);
    }
    if (face == 1) {
        return vec3(0.0, 0.95, 1.0);
    }
    if (face == 2) {
        return vec3(0.15, 1.0, 0.05);
    }
    if (face == 3) {
        return vec3(1.0, 0.0, 0.9);
    }
    if (face == 4) {
        return vec3(0.12, 0.25, 1.0);
    }
    return vec3(1.0, 0.82, 0.0);
}

float sectionLightProbeDebugLuma(vec3 radiance) {
    return dot(max(radiance, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

float sectionLightProbeDebugPeak(vec3 radiance) {
    vec3 safeRadiance = max(radiance, vec3(0.0));
    return max(max(safeRadiance.r, safeRadiance.g), safeRadiance.b);
}

vec3 sectionLightProbeDebugChroma(vec3 radiance, vec3 fallbackColor) {
    vec3 safeRadiance = max(radiance, vec3(0.0));
    float peak = sectionLightProbeDebugPeak(safeRadiance);
    if (peak <= 0.0001) {
        return fallbackColor;
    }

    return mix(fallbackColor, safeRadiance / peak, 0.94);
}

vec3 sectionLightProbeDebugRadianceColor(vec3 radiance, vec3 dominantRadiance) {
    vec3 safeRadiance = max(radiance, vec3(0.0));
    float peak = sectionLightProbeDebugPeak(safeRadiance);
    if (peak < 0.003) {
        return vec3(0.018, 0.022, 0.03);
    }

    // Use the strongest normal-facing face's source color for hue while
    // compressing the summed weighted brightness enough to keep
    // blue/red/green/yellow emitters readable instead of washing out toward
    // white.
    vec3 chroma = sectionLightProbeDebugChroma(
        dominantRadiance,
        sectionLightProbeDebugChroma(safeRadiance, vec3(1.0, 0.82, 0.52)));
    float brightness = clamp((1.0 - exp(-peak * 0.16)) * 0.72 + 0.028, 0.04, 0.76);
    return chroma * brightness;
}

vec3 sectionLightProbeDebugCategoryColor(vec3 categoryColor, float lattice) {
    return clamp(
        mix(categoryColor, vec3(0.92), clamp(lattice * 0.12, 0.0, 0.12)),
        vec3(0.0),
        vec3(1.0));
}

vec3 sectionLightDebugSourceMarker(vec3 worldPos, float lattice) {
#if SECTION_LIGHT_TABLE_ENABLE == 0
    return sectionLightProbeDebugCategoryColor(vec3(0.015, 0.018, 0.024), lattice);
#else
    int count = int(min(sectionLightHeader.x, uint(SECTION_LIGHT_SAMPLE_LIMIT)));
    vec3 markerColor = vec3(0.012, 0.014, 0.02);
    float markerStrength = 0.0;

    for (int i = 0; i < count; i++) {
        GpuSectionLight light = sectionLightRecords[i];
        vec3 lightPos = vec3(light.posRadiusFlags.xyz) + vec3(0.5);
        float distanceToLight = length(worldPos - lightPos);
        float core = 1.0 - smoothstep(0.15, 0.85, distanceToLight);
        float halo = (1.0 - smoothstep(0.85, 2.2, distanceToLight)) * 0.35;
        float marker = max(core, halo);
        if (marker <= 0.0) {
            continue;
        }

        vec3 lightColor = vec3(light.colorEmission.rgb) * (1.0 / 255.0);
        float emission = clamp(float(light.colorEmission.a) / 15.0, 0.0, 1.0);
        markerColor = max(markerColor, lightColor * marker * (0.3 + 0.9 * emission));
        markerStrength = max(markerStrength, marker);
    }

    vec3 crossAxis = abs(fract(worldPos + vec3(0.5)) - vec3(0.5));
    float blockGrid = 1.0 - smoothstep(0.015, 0.055, min(crossAxis.x, min(crossAxis.y, crossAxis.z)));
    vec3 sourceColor = mix(vec3(0.02, 0.025, 0.035), markerColor, clamp(markerStrength, 0.0, 1.0));
    sourceColor += vec3(0.15, 0.18, 0.22) * blockGrid * 0.12;
    return sectionLightProbeDebugCategoryColor(sourceColor, lattice);
#endif
}

vec3 sectionLightProbeDebugCompare(
    vec3 probeLighting,
    vec3 tableLighting,
    float lattice,
    float blocklightRaw
) {
    float probeLuma = sectionLightProbeDebugLuma(probeLighting);
    float tableLuma = sectionLightProbeDebugLuma(tableLighting);
    float darkThreshold = 0.004;
    float weakReferenceThreshold = 0.025;
    float strongestLocal = max(probeLuma, tableLuma);
    vec3 darkColor = vec3(0.018, 0.022, 0.03);
    vec3 probeOnlyColor = vec3(1.0, 0.72, 0.0);
    vec3 underLitColor = vec3(0.0, 0.78, 1.0);
    vec3 overBrightColor = vec3(1.0, 0.04, 0.0);
    vec3 matchedColor = vec3(0.08, 0.9, 0.22);

    if (strongestLocal < darkThreshold) {
        return mix(darkColor, vec3(0.11, 0.12, 0.13), lattice * 0.4);
    }

    float lightmapDark = 1.0 - smoothstep(0.035, 0.16, clamp(blocklightRaw, 0.0, 1.0));
    float leakSuspicion = smoothstep(0.008, 0.05, probeLuma) * lightmapDark;
    if (leakSuspicion > 0.06) {
        vec3 leakColor = mix(vec3(0.55, 0.0, 0.0), overBrightColor, clamp(leakSuspicion * 1.35, 0.0, 1.0));
        return sectionLightProbeDebugCategoryColor(leakColor, lattice);
    }

    float probeOnly = smoothstep(weakReferenceThreshold, weakReferenceThreshold * 10.0, probeLuma);
    if (tableLuma < weakReferenceThreshold) {
        return sectionLightProbeDebugCategoryColor(
            mix(vec3(0.32, 0.22, 0.0), probeOnlyColor, probeOnly),
            lattice);
    }

    float tableOnly = smoothstep(weakReferenceThreshold, weakReferenceThreshold * 10.0, tableLuma);
    if (probeLuma < weakReferenceThreshold) {
        return sectionLightProbeDebugCategoryColor(
            mix(vec3(0.015, 0.07, 0.24), underLitColor, tableOnly),
            lattice);
    }

    float signedLogRatio = log2((probeLuma + 0.0001) / (tableLuma + 0.0001));
    float mismatch = smoothstep(0.22, 0.9, abs(signedLogRatio));
    float relativeError = clamp(length(probeLighting - tableLighting)
        / max(length(probeLighting) + length(tableLighting), 0.02), 0.0, 1.0);

    vec3 matched = mix(vec3(0.025, 0.12, 0.045), matchedColor,
        clamp(strongestLocal * 1.6, 0.0, 1.0));
    vec3 underLit = mix(vec3(0.015, 0.07, 0.24), underLitColor,
        relativeError);
    vec3 overBright = mix(vec3(0.36, 0.0, 0.0), overBrightColor,
        relativeError);
    vec3 errorColor = signedLogRatio < 0.0 ? underLit : overBright;
    vec3 compareColor = mix(matched, errorColor, mismatch);

    return sectionLightProbeDebugCategoryColor(compareColor, lattice);
}

vec3 debugSectionLightProbeVolume(
    vec3 worldPos,
    vec3 normal,
    vec3 diffuseAlbedo,
    vec3 F0,
    float roughness,
    float metallic,
    vec3 viewDir,
    float specularIntensity,
    float blocklightRaw
) {
    ivec3 sectionOrigin;
    int slot = findSectionLightProbeSlot(worldPos, sectionOrigin);
    if (slot < 0) {
#if SECTION_LIGHT_PROBE_DEBUG_MODE == 5
        return sectionLightDebugSourceMarker(worldPos, 0.0);
#elif SECTION_LIGHT_PROBE_DEBUG_MODE == 6
        return vec3(1.0, 0.24, 0.02);
#else
        return sectionLightProbeDebugMissingPage(worldPos);
#endif
    }

    vec3 sectionLocal = clamp(worldPos - vec3(sectionOrigin), vec3(0.0), vec3(15.999));
    vec3 probeCoord = sectionLocal * (float(SECTION_LIGHT_PROBE_GRID_SIZE) / 16.0) - vec3(0.5);
    float lattice = sectionLightProbeDebugLattice(sectionLocal);

#if SECTION_LIGHT_PROBE_DEBUG_MODE == 1
    vec3 pageColor = sectionLightProbeDebugPageColor(sectionOrigin, slot);
    return mix(pageColor, vec3(0.88), lattice * 0.18);
#elif SECTION_LIGHT_PROBE_DEBUG_MODE == 2
    vec3 radiance = vec3(0.0);
    vec3 dominantRadiance = vec3(0.0);
    float dominantWeight = -1.0;
    for (int face = 0; face < SECTION_LIGHT_PROBE_FACE_COUNT; face++) {
        vec3 faceDir = sectionLightProbeFaceDirection(face);
        float weight = max(dot(normal, faceDir), 0.0);
        weight *= weight;
        vec3 faceRadiance = sampleSectionLightProbeFace(slot, probeCoord, face)
            * SECTION_LIGHT_PROBE_INTENSITY;
        vec3 weightedFaceRadiance = faceRadiance * weight;
        radiance += weightedFaceRadiance;
        float faceWeight = sectionLightProbeDebugPeak(weightedFaceRadiance);
        if (faceWeight > dominantWeight) {
            dominantWeight = faceWeight;
            dominantRadiance = faceRadiance;
        }
    }
    return mix(sectionLightProbeDebugRadianceColor(radiance, dominantRadiance), vec3(0.9), lattice * 0.12);
#elif SECTION_LIGHT_PROBE_DEBUG_MODE == 3
    float normalConfidence = sampleSectionLightProbeConfidenceVolume(worldPos, normal);
    float strongestFaceConfidence = 0.0;
    int strongestFace = 0;
    for (int face = 0; face < SECTION_LIGHT_PROBE_FACE_COUNT; face++) {
        float faceConfidence = sampleSectionLightProbeFaceConfidence(slot, probeCoord, face);
        if (faceConfidence > strongestFaceConfidence) {
            strongestFaceConfidence = faceConfidence;
            strongestFace = face;
        }
    }

    vec3 lowConfidence = vec3(0.55, 0.02, 0.0);
    vec3 midConfidence = vec3(1.0, 0.62, 0.08);
    vec3 highConfidence = vec3(0.04, 0.88, 0.26);
    vec3 confidenceColor = normalConfidence < 0.5
        ? mix(lowConfidence, midConfidence, smoothstep(0.0, 0.5, normalConfidence))
        : mix(midConfidence, highConfidence, smoothstep(0.5, 1.0, normalConfidence));
    vec3 faceHint = sectionLightProbeDebugFaceColor(strongestFace)
        * (0.12 + 0.28 * strongestFaceConfidence);
    return sectionLightProbeDebugCategoryColor(confidenceColor + faceHint, lattice);
#elif SECTION_LIGHT_PROBE_DEBUG_MODE == 4
    // Binding 22 is an unoccluded, globally limited emitter reference, not
    // ground truth. This view is a leak/under-lighting heuristic that helps
    // find candidates for sparse RT validation.
    vec3 debugDiffuseAlbedo = vec3(1.0);
    vec3 debugF0 = vec3(0.0);
    float debugRoughness = 1.0;
    float debugMetallic = 0.0;
    float debugSpecularIntensity = 0.0;
    vec3 probeLighting = sampleSectionLightProbeVolume(
        worldPos,
        normal,
        debugDiffuseAlbedo,
        debugF0,
        debugMetallic);
    vec3 tableLighting = sampleSectionLightTable(
        worldPos,
        normal,
        debugDiffuseAlbedo,
        debugF0,
        debugRoughness,
        debugMetallic,
        viewDir,
        debugSpecularIntensity);
    return sectionLightProbeDebugCompare(probeLighting, tableLighting, lattice, blocklightRaw);
#elif SECTION_LIGHT_PROBE_DEBUG_MODE == 5
    return sectionLightDebugSourceMarker(worldPos, lattice);
#elif SECTION_LIGHT_PROBE_DEBUG_MODE == 6
    return mix(
        debugSectionLightProbeRtCacheState(worldPos, normal),
        vec3(0.92),
        lattice * 0.14);
#else
    return vec3(1.0, 0.0, 1.0);
#endif
}
#endif

vec3 traceSimpleRadiance(
    vec3 rayOrigin,
    vec3 rayDirection,
    vec3 sunDirection,
    vec3 sunRadiance,
    float ignoredBlockId,
    bool diffuseIncidentContract,
    out float hitDistance
) {
    payload.hitData = vec4(0.0, 0.0, 0.0, -1.0);
    payload.material.albedo = vec3(0.0);
    payload.material.emission = vec3(0.0);
    payload.material.F0 = vec3(0.04);
    payload.material.metallic = 0.0;
    payload.material.roughness = 1.0;
    payload.material.normal = vec3(0.0, 1.0, 0.0);
    payload.material.ambientOcclusion = 1.0;
    payload.material.block_id = i16vec2(0);
    payload.ignore_block_id = i16vec2(int(ignoredBlockId), 0);
    payload.inside_block = false;
    payload.prev_distance = 0.0;

    traceRayEXT(
        acc,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        0,
        0,
        rayOrigin,
        0.001,
        rayDirection,
        diffuseIncidentContract ? 100.0 : REFLECTION_RAY_DISTANCE,
        0);

    if (payload.hitData.w < 0.0) {
        hitDistance = 10000.0;
        return max(payload.hitData.xyz, vec3(0.0));
    }

    hitDistance = payload.hitData.w;
    vec3 hitNormal = normalize(payload.material.normal);
    float nDotL = max(dot(hitNormal, sunDirection), 0.0);
    float sunLuma = dot(sunRadiance, vec3(0.2126, 0.7152, 0.0722));
    float visibility = nDotL > 0.0 && sunLuma > 0.0001
        ? alphaAwareVisibility(payload.hitData.xyz + hitNormal * 0.02, sunDirection, 10000.0)
        : 0.0;
    vec3 hitAlbedo = max(payload.material.albedo, vec3(0.0));
    float hitAo = clamp(payload.material.ambientOcclusion, 0.0, 1.0);
    vec3 surfaceColor = diffuseIncidentContract
        ? hitAlbedo
        : mix(
            hitAlbedo,
            payload.material.F0,
            clamp(payload.material.metallic, 0.0, 1.0));
    // Diffuse cache entries use the exact first-bounce incident-radiance
    // publication contract. Reflection/refraction transport preserves its
    // brighter simple-environment approximation.
    vec3 ambient = diffuseIncidentContract
        ? hitAlbedo
            * (vec3(0.025, 0.03, 0.04) + sunRadiance * 0.018)
            * AMBIENT_FACTOR
            * (0.12 + 0.38 * hitAo)
        : surfaceColor * (0.025 + 0.04 * hitAo);
    float directScale = diffuseIncidentContract ? 1.0 : 0.55;
    return max(
        payload.material.emission
        + surfaceColor * sunRadiance * nDotL * visibility * directScale
        + ambient,
        vec3(0.0));
}

uint diffuseRadianceHashMix(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

uint diffuseRadianceCacheHash(ivec4 key) {
    uint value = uint(key.x) * 0x9e3779b9u;
    value ^= uint(key.y) * 0x85ebca6bu;
    value ^= uint(key.z) * 0xc2b2ae35u;
    value ^= uint(key.w) * 0x27d4eb2du;
    return diffuseRadianceHashMix(value);
}

vec3 diffuseRadianceNormal(int bucket) {
    if (bucket == 0) return vec3(1.0, 0.0, 0.0);
    if (bucket == 1) return vec3(-1.0, 0.0, 0.0);
    if (bucket == 2) return vec3(0.0, 1.0, 0.0);
    if (bucket == 3) return vec3(0.0, -1.0, 0.0);
    if (bucket == 4) return vec3(0.0, 0.0, 1.0);
    return vec3(0.0, 0.0, -1.0);
}

int diffuseRadianceNormalBucket(vec3 normal) {
    vec3 axis = abs(normal);
    if (axis.x >= axis.y && axis.x >= axis.z) return normal.x >= 0.0 ? 0 : 1;
    if (axis.y >= axis.z) return normal.y >= 0.0 ? 2 : 3;
    return normal.z >= 0.0 ? 4 : 5;
}

int claimDiffuseRadianceCacheEntry(ivec4 key) {
    uint entryCount = diffuseRadianceCacheHeader.x;
    uint probeCount = min(diffuseRadianceCacheHeader.z, 8u);
    if (entryCount == 0u || probeCount == 0u) {
        return -1;
    }

    uint readyState = 0x80000000u | (diffuseRadianceCacheHeader.y & 0x3fffffffu);
    uint fillState = 0x40000000u | (diffuseRadianceCacheHeader.y & 0x3fffffffu);
    uint slot = diffuseRadianceCacheHash(key) % entryCount;
    int coldReadyIndex = -1;
    uint coldReadyAge = 0u;
    for (uint probe = 0u; probe < 8u; probe++) {
        if (probe >= probeCount) break;
        uint index = (slot + probe) % entryCount;
        uint state = atomicAdd(diffuseRadianceCacheEntries[index].payload.y, 0u);
        if (state == readyState && all(equal(diffuseRadianceCacheEntries[index].key, key))) {
            atomicMax(diffuseRadianceCacheEntries[index].payload.z, pc.frameIndex);
            return -1;
        }
        if (state == readyState) {
            uint age = pc.frameIndex - diffuseRadianceCacheEntries[index].payload.z;
            if (age >= 120u && (coldReadyIndex < 0 || age > coldReadyAge)) {
                coldReadyIndex = int(index);
                coldReadyAge = age;
            }
            continue;
        }
        if (state == fillState) {
            continue;
        }
        if (atomicCompSwap(diffuseRadianceCacheEntries[index].payload.y, state, fillState) == state) {
            diffuseRadianceCacheEntries[index].key = key;
            diffuseRadianceCacheEntries[index].payload.x = 0u;
            diffuseRadianceCacheEntries[index].payload.z = 0u;
            diffuseRadianceCacheEntries[index].payload.w = 0u;
            return int(index);
        }
    }

    // Visible cache-on-hit publication refreshes payload.z. Replace only a
    // genuinely cold candidate so hot entries remain stable.
    if (coldReadyIndex >= 0
            && atomicCompSwap(
                diffuseRadianceCacheEntries[coldReadyIndex].payload.y,
                readyState,
                fillState) == readyState) {
        diffuseRadianceCacheEntries[coldReadyIndex].key = key;
        diffuseRadianceCacheEntries[coldReadyIndex].payload.x = 0u;
        diffuseRadianceCacheEntries[coldReadyIndex].payload.z = 0u;
        diffuseRadianceCacheEntries[coldReadyIndex].payload.w = 0u;
        return coldReadyIndex;
    }
    return -1;
}

void publishDiffuseRadianceCache(ivec4 key, vec3 radiance, float hitDistance) {
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        return;
    }
    int entryIndex = claimDiffuseRadianceCacheEntry(key);
    if (entryIndex < 0) {
        return;
    }
    diffuseRadianceCacheEntries[entryIndex].payload.x =
        packSectionLightProbeRgb9E5(max(radiance, vec3(0.0)));
    diffuseRadianceCacheEntries[entryIndex].payload.z = pc.frameIndex;
    diffuseRadianceCacheEntries[entryIndex].payload.w =
        floatBitsToUint(max(hitDistance, 0.0));
    memoryBarrierBuffer();
    uint readyState = 0x80000000u | (diffuseRadianceCacheHeader.y & 0x3fffffffu);
    atomicExchange(diffuseRadianceCacheEntries[entryIndex].payload.y, readyState);
}

void populateRequestedDiffuseRadianceCache(vec3 sunDirection, vec3 sunRadiance) {
    uint requestIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    uint requestCount = min(diffuseRadianceFillRequestHeader.x, diffuseRadianceFillRequestHeader.z);
    if (requestIndex >= requestCount
            || diffuseRadianceFillRequestHeader.y != diffuseRadianceCacheHeader.y) {
        return;
    }

    DiffuseRadianceFillRequest request = diffuseRadianceFillRequests[requestIndex];
    ivec4 key = request.key;
    if (key.w < 0 || key.w > 5) {
        return;
    }
    int entryIndex = claimDiffuseRadianceCacheEntry(key);
    if (entryIndex < 0) {
        return;
    }

    vec3 normal = diffuseRadianceNormal(key.w);
    // World-cache samples must not depend on whichever screen pixel won the
    // request race. Sample the deterministic center of the keyed block face;
    // deferred resolve blends neighboring compatible face entries.
    vec3 rayOrigin = vec3(key.xyz) + vec3(0.5) + normal * 0.52;
    vec3 radiance = vec3(0.0);
    float hitDistance = 10000.0;
    const uint raysPerFill = 8u;
    for (uint sampleIndex = 0u; sampleIndex < raysPerFill; sampleIndex++) {
        uint seed = diffuseRadianceCacheHash(key)
            ^ diffuseRadianceHashMix((sampleIndex + 1u) * 0x9e3779b9u);
        vec3 rayDirection = cosineWeightedHemisphere(normal, seed);
        float sampleHitDistance;
        radiance += traceSimpleRadiance(
            rayOrigin,
            rayDirection,
            sunDirection,
            sunRadiance,
            0.0,
            true,
            sampleHitDistance);
        hitDistance = min(hitDistance, sampleHitDistance);
    }
    radiance /= float(raysPerFill);

    diffuseRadianceCacheEntries[entryIndex].payload.x = packSectionLightProbeRgb9E5(radiance);
    diffuseRadianceCacheEntries[entryIndex].payload.z = pc.frameIndex;
    diffuseRadianceCacheEntries[entryIndex].payload.w = floatBitsToUint(hitDistance);
    memoryBarrierBuffer();
    uint readyState = 0x80000000u | (diffuseRadianceCacheHeader.y & 0x3fffffffu);
    atomicExchange(diffuseRadianceCacheEntries[entryIndex].payload.y, readyState);
}

uint specularTransportCacheHash(ivec4 key, uint family, uint detail) {
    uint value = uint(key.x) * 0x9e3779b9u;
    value ^= uint(key.y) * 0x85ebca6bu;
    value ^= uint(key.z) * 0xc2b2ae35u;
    value ^= uint(key.w) * 0x27d4eb2du;
    value ^= family * 0x165667b1u;
    value ^= detail * 0xd3a2646cu;
    return diffuseRadianceHashMix(value);
}

vec2 specularTransportSignNotZero(vec2 value) {
    return vec2(value.x >= 0.0 ? 1.0 : -1.0, value.y >= 0.0 ? 1.0 : -1.0);
}

vec3 specularTransportDirection(int bucket) {
    ivec2 quantized = ivec2(bucket & 7, (bucket >> 3) & 7);
    vec2 oct = vec2(quantized) / 7.0 * 2.0 - 1.0;
    vec3 direction = vec3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    if (direction.z < 0.0) {
        direction.xy = (vec2(1.0) - abs(direction.yx))
            * specularTransportSignNotZero(direction.xy);
    }
    return normalize(direction);
}

int specularTransportDirectionBucket(vec3 direction) {
    direction = normalize(direction);
    vec2 oct = direction.xy / max(abs(direction.x) + abs(direction.y) + abs(direction.z), 1e-6);
    if (direction.z < 0.0) {
        oct = (vec2(1.0) - abs(oct.yx)) * specularTransportSignNotZero(oct);
    }
    ivec2 quantized = clamp(ivec2(round((oct * 0.5 + 0.5) * 7.0)), ivec2(0), ivec2(7));
    return quantized.x | (quantized.y << 3);
}

int specularTransportNormalBucket(vec3 normal) {
    return specularTransportDirectionBucket(normal);
}

int specularTransportMaterialBucket(float metallic, float roughness, float blockId, float surfaceAlpha) {
    int bucket = int(round(clamp(roughness, 0.0, 1.0) * 31.0));
    if (metallic > 0.5) bucket |= 32;
    if (blockId > 0.0) bucket |= 64;
    if (surfaceAlpha < 0.98 && !isFoliageMaterial(blockId)) bucket |= 128;
    return clamp(bucket, 0, 255);
}

ivec4 specularTransportKey(
    vec3 worldPosition,
    vec3 normal,
    float roughness,
    float metallic,
    float blockId,
    float surfaceAlpha
) {
    int variant = specularTransportNormalBucket(normal)
        | (int(round(clamp(roughness, 0.0, 1.0) * 15.0)) << 8)
        | (specularTransportMaterialBucket(metallic, roughness, blockId, surfaceAlpha) << 16);
    return ivec4(ivec3(floor(worldPosition)), variant);
}

int specularTransportMedium(float blockId) {
    if (isWaterMaterial(blockId)) return 1;
    if (isGlassMaterial(blockId)) return 2;
    if (isIceMaterial(blockId)) return 3;
    if (isCrystalMaterial(blockId)) return 4;
    return 0;
}

float specularTransportMediumBlockId(int medium) {
    if (medium == 1) return 1000.0;
    if (medium == 2) return 1001.0;
    if (medium == 3) return 1012.0;
    if (medium == 4) return 1103.0;
    return 0.0;
}

int claimSpecularTransportCacheEntry(ivec4 key, uint family, uint detail) {
    uint entryCount = specularTransportCacheHeader.x;
    uint probeCount = min(specularTransportCacheHeader.z, 8u);
    if (entryCount == 0u || probeCount == 0u) {
        return -1;
    }

    uint readyState = 0x80000000u | (specularTransportCacheHeader.y & 0x3fffffffu);
    uint fillState = 0x40000000u | (specularTransportCacheHeader.y & 0x3fffffffu);
    uint slot = specularTransportCacheHash(key, family, detail) % entryCount;
    int coldReadyIndex = -1;
    uint coldReadyAge = 0u;
    for (uint probe = 0u; probe < 8u; probe++) {
        if (probe >= probeCount) break;
        uint index = (slot + probe) % entryCount;
        uint state = atomicAdd(specularTransportCacheEntries[index].metadata.w, 0u);
        if (state == readyState
                && all(equal(specularTransportCacheEntries[index].key, key))
                && specularTransportCacheEntries[index].metadata.x == family
                && specularTransportCacheEntries[index].metadata.y == detail) {
            atomicMax(specularTransportCacheEntries[index].metadata.z, pc.frameIndex);
            return -1;
        }
        if (state == readyState) {
            uint age = pc.frameIndex - specularTransportCacheEntries[index].metadata.z;
            if (age >= 120u && (coldReadyIndex < 0 || age > coldReadyAge)) {
                coldReadyIndex = int(index);
                coldReadyAge = age;
            }
            continue;
        }
        if (state == fillState) {
            continue;
        }
        if (atomicCompSwap(specularTransportCacheEntries[index].metadata.w, state, fillState) == state) {
            specularTransportCacheEntries[index].key = key;
            specularTransportCacheEntries[index].metadata.xyz = uvec3(family, detail, pc.frameIndex);
            specularTransportCacheEntries[index].payload = uvec4(0u);
            return int(index);
        }
    }
    if (coldReadyIndex >= 0
            && atomicCompSwap(
                specularTransportCacheEntries[coldReadyIndex].metadata.w,
                readyState,
                fillState) == readyState) {
        specularTransportCacheEntries[coldReadyIndex].key = key;
        specularTransportCacheEntries[coldReadyIndex].metadata.xyz =
            uvec3(family, detail, pc.frameIndex);
        specularTransportCacheEntries[coldReadyIndex].payload = uvec4(0u);
        return coldReadyIndex;
    }
    return -1;
}

void publishSpecularTransportCache(
    ivec4 key,
    uint family,
    uint detail,
    vec3 reflectedRadiance,
    vec3 refractedRadiance,
    float reflectionDistance,
    float refractionDistance
) {
    if (any(isnan(reflectedRadiance)) || any(isinf(reflectedRadiance))
            || any(isnan(refractedRadiance)) || any(isinf(refractedRadiance))) {
        return;
    }
    int entryIndex = claimSpecularTransportCacheEntry(key, family, detail);
    if (entryIndex < 0) {
        return;
    }
    specularTransportCacheEntries[entryIndex].payload = uvec4(
        packSectionLightProbeRgb9E5(max(reflectedRadiance, vec3(0.0))),
        packSectionLightProbeRgb9E5(max(refractedRadiance, vec3(0.0))),
        floatBitsToUint(max(reflectionDistance, 0.0)),
        floatBitsToUint(max(refractionDistance, 0.0)));
    memoryBarrierBuffer();
    uint readyState = 0x80000000u | (specularTransportCacheHeader.y & 0x3fffffffu);
    atomicExchange(specularTransportCacheEntries[entryIndex].metadata.w, readyState);
}

bool readSpecularTransportCache(
    ivec4 key,
    uint family,
    uint detail,
    out vec3 reflectedRadiance,
    out vec3 refractedRadiance,
    out float reflectionDistance,
    out float refractionDistance
) {
    reflectedRadiance = vec3(0.0);
    refractedRadiance = vec3(0.0);
    reflectionDistance = 10000.0;
    refractionDistance = 10000.0;
    uint entryCount = specularTransportCacheHeader.x;
    uint probeCount = min(specularTransportCacheHeader.z, 8u);
    if (entryCount == 0u || probeCount == 0u) {
        return false;
    }

    uint readyState = 0x80000000u | (specularTransportCacheHeader.y & 0x3fffffffu);
    uint slot = specularTransportCacheHash(key, family, detail) % entryCount;
    for (uint probe = 0u; probe < 8u; probe++) {
        if (probe >= probeCount) break;
        uint index = (slot + probe) % entryCount;
        SpecularTransportCacheEntry entry = specularTransportCacheEntries[index];
        if (entry.metadata.w == readyState
                && entry.metadata.x == family
                && entry.metadata.y == detail
                && all(equal(entry.key, key))) {
            reflectedRadiance = unpackSectionLightProbeRgb9E5(entry.payload.x);
            refractedRadiance = unpackSectionLightProbeRgb9E5(entry.payload.y);
            reflectionDistance = uintBitsToFloat(entry.payload.z);
            refractionDistance = uintBitsToFloat(entry.payload.w);
            return true;
        }
    }
    return false;
}

void populateRequestedSpecularTransportCache(vec3 sunDirection, vec3 sunRadiance) {
    uint requestIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    uint requestCount = min(specularTransportFillRequestHeader.x, specularTransportFillRequestHeader.z);
    if (requestIndex >= requestCount
            || specularTransportFillRequestHeader.y != specularTransportCacheHeader.y) {
        return;
    }

    SpecularTransportFillRequest request = specularTransportFillRequests[requestIndex];
    uint family = uint(request.metadata.x);
    uint detail = uint(request.metadata.y);
    if (family > 1u) {
        return;
    }
    int entryIndex = claimSpecularTransportCacheEntry(request.key, family, detail);
    if (entryIndex < 0) {
        return;
    }

    int normalBucket = request.key.w & 0xff;
    vec3 normal = specularTransportDirection(normalBucket);
    vec3 surfaceOrigin = request.rayOrigin.xyz;
    vec3 reflectedRadiance = vec3(0.0);
    vec3 refractedRadiance = vec3(0.0);
    float reflectionDistance = 10000.0;
    float refractionDistance = 10000.0;

    if (family == 0u) {
        vec3 reflectionDirection = specularTransportDirection(int(detail & 0xffu));
        reflectedRadiance = traceSimpleRadiance(
            surfaceOrigin + normal * 0.02,
            reflectionDirection,
            sunDirection,
            sunRadiance,
            0.0,
            false,
            reflectionDistance);
    } else {
        int medium = int(detail & 0xffu);
        vec3 reflectionDirection = specularTransportDirection(int((detail >> 8u) & 0xffu));
        vec3 refractionDirection = specularTransportDirection(int((detail >> 16u) & 0xffu));
        float ignoredBlockId = specularTransportMediumBlockId(medium);
        reflectedRadiance = traceSimpleRadiance(
            surfaceOrigin + normal * 0.02,
            reflectionDirection,
            sunDirection,
            sunRadiance,
            ignoredBlockId,
            false,
            reflectionDistance);
        refractedRadiance = traceSimpleRadiance(
            surfaceOrigin - normal * 0.02,
            refractionDirection,
            sunDirection,
            sunRadiance,
            ignoredBlockId,
            false,
            refractionDistance);
    }

    specularTransportCacheEntries[entryIndex].payload = uvec4(
        packSectionLightProbeRgb9E5(reflectedRadiance),
        packSectionLightProbeRgb9E5(refractedRadiance),
        floatBitsToUint(reflectionDistance),
        floatBitsToUint(refractionDistance));
    memoryBarrierBuffer();
    uint readyState = 0x80000000u | (specularTransportCacheHeader.y & 0x3fffffffu);
    atomicExchange(specularTransportCacheEntries[entryIndex].metadata.w, readyState);
}

uint surfaceDirectLightCacheHash(ivec4 key) {
    uint value = uint(key.x) * 0x9e3779b9u;
    value ^= uint(key.y) * 0x85ebca6bu;
    value ^= uint(key.z) * 0xc2b2ae35u;
    value ^= uint(key.w) * 0x27d4eb2du;
    return diffuseRadianceHashMix(value ^ 0x6d2b79f5u);
}

uint surfaceDirectLightGeneration() {
    return surfaceDirectLightCacheHeader.y & 0x1fffffffu;
}

uint surfaceDirectLightReadyState() {
    return 0x80000000u | surfaceDirectLightGeneration();
}

uint surfaceDirectLightFillState() {
    return 0x40000000u | surfaceDirectLightGeneration();
}

uint surfaceDirectLightPartialState() {
    return 0x20000000u | surfaceDirectLightGeneration();
}

vec3 surfaceDirectLightSunDirection() {
    vec3 sunDirWorld = vec3(pc.sunDirX, pc.sunDirY, pc.sunDirZ);
    if (dot(sunDirWorld, sunDirWorld) < 0.000001) {
        sunDirWorld = vec3(0.5, 1.0, 0.2);
    }
    sunDirWorld = normalize(sunDirWorld);
    return sunDirWorld;
}

uint surfaceDirectLightSunSignature(vec3 direction) {
    ivec3 quantized = ivec3(round(normalize(direction) * 32.0));
    uint value = uint(quantized.x) * 0x9e3779b9u;
    value ^= uint(quantized.y) * 0x85ebca6bu;
    value ^= uint(quantized.z) * 0xc2b2ae35u;
    return diffuseRadianceHashMix(value ^ 0x51ed270bu);
}

int claimSurfaceDirectLightCacheEntry(
    ivec4 key,
    uint sunSignature,
    uvec2 dependencyVersion
) {
    uint entryCount = surfaceDirectLightCacheHeader.x;
    uint probeCount = min(surfaceDirectLightCacheHeader.z, 8u);
    if (entryCount == 0u || probeCount == 0u) return -1;

    uint readyState = surfaceDirectLightReadyState();
    uint fillState = surfaceDirectLightFillState();
    uint partialState = surfaceDirectLightPartialState();
    uint slot = surfaceDirectLightCacheHash(key) % entryCount;
    int coldReadyIndex = -1;
    uint coldReadyAge = 0u;
    for (uint probe = 0u; probe < 8u; probe++) {
        if (probe >= probeCount) break;
        uint index = (slot + probe) % entryCount;
        uint state = atomicAdd(surfaceDirectLightCacheEntries[index].metadata.y, 0u);
        bool keyMatches = all(equal(surfaceDirectLightCacheEntries[index].key, key));
        bool dependencyMatches = all(equal(
            surfaceDirectLightCacheEntries[index].dependencyVersion.xy,
            dependencyVersion));
        if (keyMatches && !dependencyMatches
                && (state == readyState || state == partialState)) {
            if (atomicCompSwap(
                    surfaceDirectLightCacheEntries[index].metadata.y,
                    state,
                    fillState) == state) {
                surfaceDirectLightCacheEntries[index].metadata.x = 0u;
                surfaceDirectLightCacheEntries[index].metadata.z = pc.frameIndex;
                surfaceDirectLightCacheEntries[index].metadata.w = 0u;
                surfaceDirectLightCacheEntries[index].directionalVisibility = uvec4(0u);
                surfaceDirectLightCacheEntries[index].dependencyVersion =
                    uvec4(dependencyVersion, 0u, 0u);
                return int(index);
            }
            return -1;
        }
        if (state == readyState && keyMatches) {
            atomicMax(surfaceDirectLightCacheEntries[index].metadata.z, pc.frameIndex);
            uint sunState = atomicAdd(
                surfaceDirectLightCacheEntries[index].directionalVisibility.y, 0u);
            uint storedSunSignature = surfaceDirectLightCacheEntries[index].directionalVisibility.z;
            return sunState == readyState && storedSunSignature == sunSignature
                ? -1
                : int(index);
        }
        if (state == partialState && keyMatches) {
            if (atomicCompSwap(
                    surfaceDirectLightCacheEntries[index].metadata.y,
                    partialState,
                    fillState) == partialState) {
                return int(index);
            }
            return -1;
        }
        if (state == readyState) {
            uint age = pc.frameIndex - surfaceDirectLightCacheEntries[index].metadata.z;
            if (age >= 120u && (coldReadyIndex < 0 || age > coldReadyAge)) {
                coldReadyIndex = int(index);
                coldReadyAge = age;
            }
            continue;
        }
        if (state == fillState || state == partialState) continue;
        if (atomicCompSwap(surfaceDirectLightCacheEntries[index].metadata.y, state, fillState) == state) {
            surfaceDirectLightCacheEntries[index].key = key;
            surfaceDirectLightCacheEntries[index].metadata.x = 0u;
            surfaceDirectLightCacheEntries[index].metadata.z = pc.frameIndex;
            surfaceDirectLightCacheEntries[index].metadata.w = 0u;
            surfaceDirectLightCacheEntries[index].directionalVisibility = uvec4(0u);
            surfaceDirectLightCacheEntries[index].dependencyVersion =
                uvec4(dependencyVersion, 0u, 0u);
            return int(index);
        }
    }

    if (coldReadyIndex >= 0
            && atomicCompSwap(
                surfaceDirectLightCacheEntries[coldReadyIndex].metadata.y,
                readyState,
                fillState) == readyState) {
        surfaceDirectLightCacheEntries[coldReadyIndex].key = key;
        surfaceDirectLightCacheEntries[coldReadyIndex].metadata.x = 0u;
        surfaceDirectLightCacheEntries[coldReadyIndex].metadata.z = pc.frameIndex;
        surfaceDirectLightCacheEntries[coldReadyIndex].metadata.w = 0u;
        surfaceDirectLightCacheEntries[coldReadyIndex].directionalVisibility = uvec4(0u);
        surfaceDirectLightCacheEntries[coldReadyIndex].dependencyVersion =
            uvec4(dependencyVersion, 0u, 0u);
        return coldReadyIndex;
    }
    return -1;
}

float evaluateSurfaceDirectLightVisibility(
    GpuSectionLight light,
    vec3 worldPos,
    vec3 normal
) {
    vec3 lightColor = vec3(light.colorEmission.rgb) * (1.0 / 255.0);
    float emission = sectionLightNormalizedEmission(light);
    if (emission <= 0.0
            || dot(lightColor, vec3(0.2126, 0.7152, 0.0722)) <= 0.0001) {
        return 0.0;
    }

    float radius = max(float(light.posRadiusFlags.w & 0xFFFF), 1.0);
    vec3 lightPos = vec3(light.posRadiusFlags.xyz) + vec3(0.5);
    vec3 toLight = lightPos - worldPos;
    float dist2 = dot(toLight, toLight);
    float maxDistance = sectionLightBlocklightMaxDistance(radius);
    if (dist2 <= 0.0001 || dist2 > maxDistance * maxDistance) return 0.0;

    float distance = sqrt(dist2);
    // Visibility is geometry-only. IRLights shares one shadow result between
    // diffuse and specular and applies the actual per-pixel normal afterward.
    // Baking N.L from the representative block face makes normal-mapped pixels
    // inherit the wrong light direction.
    vec3 rayOrigin = worldPos + normal * 0.025;
    vec3 rayToLight = lightPos - rayOrigin;
    float rayDistance = length(rayToLight);
    float visibility = rayDistance > 0.0001
        ? alphaAwareVisibility(
            rayOrigin,
            rayToLight / rayDistance,
            sectionLightVisibilityDistanceToSource(rayDistance, rayToLight / rayDistance))
        : 1.0;
    return visibility;
}

bool surfaceDirectLightCanAffectFace(
    GpuSectionLight light,
    ivec3 surfaceCell,
    vec3 normal
) {
    vec3 lightColor = vec3(light.colorEmission.rgb) * (1.0 / 255.0);
    float emission = sectionLightNormalizedEmission(light);
    if (emission <= 0.0
            || dot(lightColor, vec3(0.2126, 0.7152, 0.0722)) <= 0.0001) {
        return false;
    }

    float radius = max(float(light.posRadiusFlags.w & 0xFFFF), 1.0);
    vec3 faceCenter = vec3(surfaceCell) + vec3(0.5) + normal * 0.5;
    vec3 lightPos = vec3(light.posRadiusFlags.xyz) + vec3(0.5);
    vec3 delta = lightPos - faceCenter;
    float normalDistance = dot(delta, normal);
    // A point behind the owning face cannot contribute to that face's diffuse
    // or GGX response. Keeping it in the finite coverage list wastes one of
    // the 96 local-light slots and can omit the actual nearby emitter.
    if (normalDistance <= 0.0) {
        return false;
    }

    vec3 tangentU;
    vec3 tangentV;
    if (abs(normal.x) > 0.5) {
        tangentU = vec3(0.0, 1.0, 0.0);
        tangentV = vec3(0.0, 0.0, 1.0);
    } else if (abs(normal.y) > 0.5) {
        tangentU = vec3(1.0, 0.0, 0.0);
        tangentV = vec3(0.0, 0.0, 1.0);
    } else {
        tangentU = vec3(1.0, 0.0, 0.0);
        tangentV = vec3(0.0, 1.0, 0.0);
    }

    const float faceHalfExtent = 0.75;
    float tangentDistanceU = max(abs(dot(delta, tangentU)) - faceHalfExtent, 0.0);
    float tangentDistanceV = max(abs(dot(delta, tangentV)) - faceHalfExtent, 0.0);
    float closestDistance2 =
        normalDistance * normalDistance
        + tangentDistanceU * tangentDistanceU
        + tangentDistanceV * tangentDistanceV;
    return closestDistance2 <= radius * radius;
}

void storeSurfaceDirectLightVisibility(
    int entryIndex,
    int coverageIndex,
    ivec3 surfaceCell,
    GpuSectionLight light,
    int sampleIndex,
    float visibility
) {
    uint quantizedVisibility = uint(round(clamp(visibility, 0.0, 1.0) * 3.0));
    int identityScalar = coverageIndex * 3;
    int identityVector = identityScalar >> 2;
    int identityComponent = identityScalar & 3;
    int payloadScalar = identityScalar + 1;
    int payloadVector = payloadScalar >> 2;
    int payloadComponent = payloadScalar & 3;
    int visibilityScalar = identityScalar + 2;
    int visibilityVector = visibilityScalar >> 2;
    int visibilityComponent = visibilityScalar & 3;
    if (sampleIndex == 0) {
        ivec3 relativePosition = clamp(
            light.posRadiusFlags.xyz - surfaceCell,
            ivec3(-64),
            ivec3(63));
        uint packedRadius = uint(clamp(light.posRadiusFlags.w & 0xFFFF, 1, 127));
        uint packedIdentity = uint(relativePosition.x + 64)
            | (uint(relativePosition.y + 64) << 7u)
            | (uint(relativePosition.z + 64) << 14u)
            | ((light.colorEmission.a & 15u) << 21u)
            | (packedRadius << 25u);
        surfaceDirectLightCacheEntries[entryIndex]
            .lightRecords[identityVector][identityComponent] = packedIdentity;
        surfaceDirectLightCacheEntries[entryIndex]
            .lightRecords[payloadVector][payloadComponent] =
                (light.colorEmission.r & 255u)
                | ((light.colorEmission.g & 255u) << 8u)
                | ((light.colorEmission.b & 255u) << 16u);
        surfaceDirectLightCacheEntries[entryIndex]
            .lightRecords[visibilityVector][visibilityComponent] = 0u;
    }
    uint packed = surfaceDirectLightCacheEntries[entryIndex]
        .lightRecords[visibilityVector][visibilityComponent];
    uint shift = uint(sampleIndex & 15) * 2u;
    packed = (packed & ~(3u << shift)) | (quantizedVisibility << shift);
    surfaceDirectLightCacheEntries[entryIndex]
        .lightRecords[visibilityVector][visibilityComponent] = packed;
}

vec3 surfaceDirectLightSamplePosition(
    ivec3 surfaceCell,
    vec3 normal,
    int sampleIndex
) {
    vec3 tangentU;
    vec3 tangentV;
    if (abs(normal.x) > 0.5) {
        tangentU = vec3(0.0, 1.0, 0.0);
        tangentV = vec3(0.0, 0.0, 1.0);
    } else if (abs(normal.y) > 0.5) {
        tangentU = vec3(1.0, 0.0, 0.0);
        tangentV = vec3(0.0, 0.0, 1.0);
    } else {
        tangentU = vec3(1.0, 0.0, 0.0);
        tangentV = vec3(0.0, 1.0, 0.0);
    }
    int sampleX = sampleIndex & 3;
    int sampleY = (sampleIndex >> 2) & 3;
    float u = (float(sampleX) + 0.5) * 0.25 - 0.5;
    float v = (float(sampleY) + 0.5) * 0.25 - 0.5;
    return vec3(surfaceCell) + vec3(0.5) + normal * 0.5
        + tangentU * u + tangentV * v;
}

bool claimSurfaceDirectionalVisibility(int entryIndex, uint sunSignature) {
    uint readyState = surfaceDirectLightReadyState();
    uint fillState = surfaceDirectLightFillState();
    uint state = atomicAdd(
        surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.y, 0u);
    uint storedSignature = surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.z;
    if ((state == readyState || state == fillState)
            && storedSignature == sunSignature) {
        return false;
    }
    if (state == fillState
            || atomicCompSwap(
                surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.y,
                state,
                fillState) != state) {
        return false;
    }
    surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.x = 0u;
    surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.z = sunSignature;
    surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.w = pc.frameIndex;
    return true;
}

void populateSurfaceDirectionalVisibility(
    int entryIndex,
    ivec3 surfaceCell,
    vec3 normal,
    vec3 sunDirection,
    uint sunSignature
) {
    if (!claimSurfaceDirectionalVisibility(entryIndex, sunSignature)) return;

    uint packedVisibility = 0u;
    for (int sampleIndex = 0; sampleIndex < 4; sampleIndex++) {
        vec3 samplePosition = surfaceDirectLightSamplePosition(
            surfaceCell, normal, sampleIndex);
        float visibility = alphaAwareVisibility(
            samplePosition + normal * 0.025,
            sunDirection,
            10000.0);
        uint quantized = uint(round(clamp(visibility, 0.0, 1.0) * 255.0));
        packedVisibility |= quantized << (uint(sampleIndex) * 8u);
    }
    surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.x = packedVisibility;
    surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.w = pc.frameIndex;
    memoryBarrierBuffer();
    atomicExchange(
        surfaceDirectLightCacheEntries[entryIndex].directionalVisibility.y,
        surfaceDirectLightReadyState());
}

void processSurfaceDirectLightRange(
    int entryIndex,
    int firstLight,
    int rangeCount,
    int cursor,
    ivec3 surfaceCell,
    vec3 normal,
    inout int coverageCount,
    inout int processedCount
) {
    const int coverageLimit = 96;
    const int raysPerFill = 20;
    for (int rangeIndex = 0; rangeIndex < rangeCount; rangeIndex++) {
        if (coverageCount >= coverageLimit) break;
        int lightIndex = firstLight + rangeIndex;
        GpuSectionLight light = sectionLightRecords[lightIndex];
        if (!surfaceDirectLightCanAffectFace(light, surfaceCell, normal)) {
            continue;
        }
        for (int sampleIndex = 0; sampleIndex < 16; sampleIndex++) {
            int sampleCursor = coverageCount * 16 + sampleIndex;
            if (sampleCursor >= cursor && processedCount < raysPerFill) {
                vec3 samplePosition = surfaceDirectLightSamplePosition(
                    surfaceCell, normal, sampleIndex);
                float visibility = evaluateSurfaceDirectLightVisibility(
                    light, samplePosition, normal);
                storeSurfaceDirectLightVisibility(
                    entryIndex,
                    coverageCount,
                    surfaceCell,
                    light,
                    sampleIndex,
                    visibility);
                processedCount++;
            }
        }
        coverageCount++;
    }
}

void populateRequestedSurfaceDirectLightCache() {
    uint requestIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    uint requestCount = min(
        surfaceDirectLightFillRequestHeader.x,
        surfaceDirectLightFillRequestHeader.z);
    if (requestIndex >= requestCount
            || surfaceDirectLightFillRequestHeader.y != surfaceDirectLightCacheHeader.y) {
        return;
    }

    SurfaceDirectLightFillRequest request = surfaceDirectLightFillRequests[requestIndex];
    if (request.key.w < 0 || request.key.w > 5) return;
    vec3 normal = diffuseRadianceNormal(request.key.w);
    // Trace a deterministic representative point for the owning block face.
    // The cached payload is visibility only; resolve evaluates lighting at the
    // exact G-buffer position, so it no longer produces one RGB value per block.
    ivec3 surfaceCell = request.key.xyz;
    vec3 worldPos = vec3(surfaceCell) + vec3(0.5) + normal * 0.5;
    uvec2 dependencyVersion;
    vec3 ownerCellCenter = vec3(surfaceCell) + vec3(0.5);
    if (!findSurfaceDependencyVersion(ownerCellCenter, dependencyVersion)) return;
    vec3 sunDirection = surfaceDirectLightSunDirection();
    uint sunSignature = surfaceDirectLightSunSignature(sunDirection);
    int entryIndex = claimSurfaceDirectLightCacheEntry(
        request.key, sunSignature, dependencyVersion);
    if (entryIndex < 0) return;

    populateSurfaceDirectionalVisibility(
        entryIndex, surfaceCell, normal, sunDirection, sunSignature);
    if (atomicAdd(surfaceDirectLightCacheEntries[entryIndex].metadata.y, 0u)
            == surfaceDirectLightReadyState()) {
        return;
    }

    int cursor = int(surfaceDirectLightCacheEntries[entryIndex].metadata.w);
    int coverageCount = 0;
    int processedCount = 0;
    bool usedLightDirectory = false;

#if SECTION_LIGHT_GRID_ENABLE != 0
    if (sectionLightHeader.w > 0u) {
        usedLightDirectory = true;
        ivec3 baseSectionOrigin = ivec3(floor(ownerCellCenter / 16.0)) * 16;
        for (int manhattan = 0; manhattan <= SECTION_LIGHT_GRID_SEARCH_RADIUS * 3; manhattan++) {
            for (int dz = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dz <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dz++) {
                for (int dy = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dy <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dy++) {
                    for (int dx = -SECTION_LIGHT_GRID_SEARCH_RADIUS; dx <= SECTION_LIGHT_GRID_SEARCH_RADIUS; dx++) {
                        if (abs(dx) + abs(dy) + abs(dz) != manhattan || coverageCount >= 96) continue;
                        int firstLight;
                        int rangeCount;
                        if (!findSectionLightGridRange(
                                baseSectionOrigin + ivec3(dx, dy, dz) * 16,
                                firstLight,
                                rangeCount)) {
                            continue;
                        }
                        processSurfaceDirectLightRange(
                            entryIndex,
                            firstLight,
                            rangeCount,
                            cursor,
                            surfaceCell,
                            normal,
                            coverageCount,
                            processedCount);
                    }
                }
            }
        }
    }
#endif

    // Only old/no-directory layouts use the global fallback. An empty local
    // group is genuinely dark; borrowing unrelated world emitters produces
    // rotating, physically impossible light directions.
    if (!usedLightDirectory) {
        int totalLightCount = min(int(sectionLightHeader.x), 96);
        processSurfaceDirectLightRange(
            entryIndex,
            0,
            totalLightCount,
            cursor,
            surfaceCell,
            normal,
            coverageCount,
            processedCount);
    }

    int totalSampleCount = coverageCount * 16;
    int nextCursor = min(cursor + processedCount, totalSampleCount);
    surfaceDirectLightCacheEntries[entryIndex].metadata.x = uint(coverageCount);
    surfaceDirectLightCacheEntries[entryIndex].metadata.z = pc.frameIndex;
    surfaceDirectLightCacheEntries[entryIndex].metadata.w = uint(nextCursor);
    memoryBarrierBuffer();
    atomicExchange(
        surfaceDirectLightCacheEntries[entryIndex].metadata.y,
        nextCursor >= totalSampleCount
            ? surfaceDirectLightReadyState()
            : surfaceDirectLightPartialState());
}

// ============================================================================
// DLSS Debug Cell Content Helper
// ============================================================================

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

// Returns the debug visualization for a specific DLSS cell
// cellIndex: 0=Albedo, 1=Normals, 2=Depth, 3=Motion, 4=Roughness, 5=Specular F0, 6=Jitter Viewer, 7=Final Color, 8=Extras
vec4 getDLSSDebugCellContent(int cellIndex, bool hit, vec3 albedo, vec3 normal, vec3 worldPos, vec3 origin, float roughness, vec3 F0, bool cameraRelativePos, vec2 cellUV, vec2 motionVec, vec3 finalLighting, vec2 launchSize, vec4 gExtraRaw) {
	if (cellIndex == 0) {
		// Cell 0: Albedo (Diffuse Color)
		if (hit) {
			return vec4(albedo, 1.0);
		} else {
			return vec4(0.0, 1.0, 1.0, 1.0); // Cyan for sky
		}
	} else if (cellIndex == 1) {
		// Cell 1: Normals (World-Space)
		if (hit) {
			vec3 normalColor = normal * 0.5 + 0.5;
			return vec4(normalColor, 1.0);
		} else {
			return vec4(1.0, 0.0, 1.0, 1.0); // Magenta for sky
		}
	} else if (cellIndex == 2) {
		// Cell 2: Linear Depth
		if (hit) {
			float linearDepth = cameraRelativePos ? length(worldPos) : length(worldPos - origin);
			float normalizedDepth = clamp(linearDepth / 100.0, 0.0, 1.0);
			float depthValue = 1.0 - normalizedDepth;
			return vec4(depthValue * 0.5, depthValue * 0.8, depthValue, 1.0);
		} else {
			return vec4(1.0, 0.0, 0.0, 1.0); // Red for sky (far)
		}
	} else if (cellIndex == 3) {
		// Cell 3: Motion Vectors (Optical Flow Visualization)
		#if ENABLE_DLSS_RR
		float magnitude = length(motionVec);
        if (magnitude < 0.001) {
            return vec4(0.0, 0.0, 0.0, 1.0);
        }
        float angle = atan(motionVec.y, motionVec.x);
        float hue = angle / (2.0 * 3.14159265) + 0.5;
        float value = clamp(magnitude / 10.0, 0.0, 1.0);
        value = pow(value, 0.5); 
		return vec4(hsv2rgb(vec3(hue, 1.0, value)), 1.0);
		#else
		return vec4(0.1, 0.1, 0.1, 1.0);
		#endif
	} else if (cellIndex == 4) {
		// Cell 4: Roughness
		if (hit) {
			float roughnessVis = (roughness - 0.04) / 0.96;
			return vec4(vec3(roughnessVis), 1.0);
		} else {
			return vec4(0.0, 0.0, 0.0, 1.0); // Black for sky
		}
	} else if (cellIndex == 5) {
		// Cell 5: Specular Albedo (F0)
		if (hit) {
			vec3 f0Vis = F0 * 2.0;
			return vec4(f0Vis, 1.0);
		} else {
			return vec4(0.0, 0.0, 0.5, 1.0); // Dark blue for sky
		}
	} else if (cellIndex == 6) {
		// Cell 6: Jitter Viewer
		vec2 center = vec2(0.5);
		vec2 jitterOffset = cam.jitterData.xy * 0.8; 
		vec2 targetPos = center + jitterOffset;
		float dist = length(cellUV - targetPos);
		
        float rx = clamp(cam.jitterData.x + 0.5, 0.0, 1.0);
        float ry = clamp(cam.jitterData.y + 0.5, 0.0, 1.0);
		vec4 finalColor = vec4(rx * 0.2, ry * 0.2, 0.1, 1.0);
		
		if (fract(cellUV.x * 10.0) < 0.05 || fract(cellUV.y * 10.0) < 0.05) {
            finalColor = vec4(0.2, 0.2, 0.2, 1.0);
        }
		if (abs(cellUV.x - 0.5) < 0.005 || abs(cellUV.y - 0.5) < 0.005) {
			finalColor = vec4(0.5, 0.5, 0.5, 1.0);
		}
		if (dist < 0.03) {
			finalColor = vec4(1.0, 0.5, 0.0, 1.0);
		}
		
		return finalColor;
	} else if (cellIndex == 7) {
        // Cell 7: Final Noisy Lighting
        return vec4(finalLighting, 1.0);
    } else {
        // Cell 8: G-buffer Extras (Blocklight, Skylight, AO)
        return vec4(clamp(gExtraRaw.rgb, 0.0, 1.0), 1.0);
	}
}

#if ENABLE_DLSS_RR
// Vulkanite's DLSS/RR guide contract stores normalized world-space normals in
// UNORM-style [0, 1] RGB even though the backing image is floating point.
vec3 encodeDlssNormalGuide(vec3 worldNormal) {
    return normalize(worldNormal) * 0.5 + 0.5;
}

void writeRadianceDlssSidecars(
    ivec2 pixel,
    vec3 diffuseAlbedo,
    float metallic,
    vec3 specularAlbedo,
    vec3 normal,
    float roughness,
    float firstHitDepth,
    float specularHitDepth
) {
    imageStore(DiffuseAlbedoMetallic, pixel,
        vec4(clamp(diffuseAlbedo, vec3(0.0), vec3(1.0)), clamp(metallic, 0.0, 1.0)));
    imageStore(SpecularAlbedo, pixel,
        vec4(clamp(specularAlbedo, vec3(0.0), vec3(1.0)), 1.0));
    imageStore(NormalRoughness, pixel,
        vec4(encodeDlssNormalGuide(normal), clamp(roughness, 0.04, 1.0)));
    imageStore(FirstHitDepth, pixel, vec4(max(firstHitDepth, 0.0)));
    imageStore(SpecularHitDepth, pixel, vec4(max(specularHitDepth, 0.0)));
}

void writeSkyDlssSidecars(ivec2 pixel) {
    imageStore(DiffuseAlbedoMetallic, pixel, vec4(0.0));
    imageStore(SpecularAlbedo, pixel, vec4(0.0));
    imageStore(NormalRoughness, pixel, vec4(0.5, 1.0, 0.5, 1.0));
    imageStore(FirstHitDepth, pixel, vec4(10000.0));
    imageStore(SpecularHitDepth, pixel, vec4(10000.0));
}
#endif

// ============================================================================
// Main
// ============================================================================

void main() {
#if VULKANITE_COMPILE_DIAGNOSTICS
comparisonPixelFlags = 0u;
reflectionComparisonFlags = 0u;
reflectionComparisonSampled = false;
reflectionComparisonTint = vec3(0.0);
#endif
// A negative mode is a bounded request-only dispatch. It fills cache misses and
// exits before any full-frame visibility or lighting work.
if (pc.cacheOnHit < 0) {
    populateRequestedSectionLightProbeRtCacheCell();
    uint cacheRequestIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    bool hasSurfaceDirectRequest =
        surfaceDirectLightFillRequestHeader.y == surfaceDirectLightCacheHeader.y
        && cacheRequestIndex < min(
            surfaceDirectLightFillRequestHeader.x,
            surfaceDirectLightFillRequestHeader.z);
    if (hasSurfaceDirectRequest) {
        populateRequestedSurfaceDirectLightCache();
    }
    bool hasDiffuseRequest =
        diffuseRadianceFillRequestHeader.y == diffuseRadianceCacheHeader.y
        && cacheRequestIndex < min(
            diffuseRadianceFillRequestHeader.x,
            diffuseRadianceFillRequestHeader.z);
    bool hasSpecularRequest =
        specularTransportFillRequestHeader.y == specularTransportCacheHeader.y
        && cacheRequestIndex < min(
            specularTransportFillRequestHeader.x,
            specularTransportFillRequestHeader.z);
    if (!hasDiffuseRequest && !hasSpecularRequest) {
        return;
    }
    vec3 cacheSunDirWorld = vec3(pc.sunDirX, pc.sunDirY, pc.sunDirZ);
    if (dot(cacheSunDirWorld, cacheSunDirWorld) < 0.000001) {
        cacheSunDirWorld = vec3(0.5, 1.0, 0.2);
    }
    vec3 cacheLightDir = normalize(cacheSunDirWorld);
    vec3 cacheBaseSunColor = vec3(pc.sunColorR, pc.sunColorG, pc.sunColorB) * SUN_INTENSITY;
    vec3 cacheSunColor = getSunColorFromElevation(cacheLightDir, cacheBaseSunColor);
    populateRequestedDiffuseRadianceCache(cacheLightDir, cacheSunColor);
    populateRequestedSpecularTransportCache(cacheLightDir, cacheSunColor);
    return;
}

vec2 launchSize = vec2(gl_LaunchSizeEXT.xy);
ivec2 screenCoord = ivec2(gl_LaunchIDEXT.xy);
imageStore(blocklightDetailImage, screenCoord, vec4(0.0));
#if ENABLE_DLSS_RR
writeSkyDlssSidecars(screenCoord);
#endif
vec2 p = (vec2(screenCoord) + 0.5) / launchSize;

// Store original values before any remapping
vec2 originalP = p;
ivec2 originalPixelCoord = screenCoord;

// Determine which quadrant/cell we're in (for debug mode)
// Debug mode 1 (DLSS): 2x3 grid showing DLSSD inputs
// Debug mode 2 (BUFFERS): 2x2 quadrant layout
//
// DLSS Layout (3x3 grid):
// +-----------+-----------+-----------+
// | Cell 0    | Cell 1    | Cell 2    |
// | Albedo    | Normals   | Depth     |
// +-----------+-----------+-----------+
// | Cell 3    | Cell 4    | Cell 5    |
// | Motion Vec| Roughness | Spec F0   |
// +-----------+-----------+-----------+
// | Cell 6    | Blank     | Blank     |
// | Jitter    |           |           |
// +-----------+-----------+-----------+
//
// BUFFERS Layout (2x2 quadrants):
// Q2 (normals) | Q3 (final)
// -----------------|------------------
// Q0 (depth) | Q1 (motion vec)
int quadrant = 0;
int dlssCell = 0;
if (pc.debugMode == 1) {
    // DLSS debug mode: 3x3 grid (3 columns, 3 rows)
    int cellX = int(p.x * 3.0);
    int cellY = int(p.y * 3.0);
    cellX = clamp(cellX, 0, 2);
    cellY = clamp(cellY, 0, 2);
    dlssCell = cellY * 3 + cellX;
} else if (pc.debugMode == 2) {
    // BUFFERS debug mode: 2x2 quadrants
    // Note: In Vulkan, Y is inverted, but we're working in UV space which is [0,1]
    if (p.x >= 0.5) quadrant += 1; // Right half
    if (p.y >= 0.5) quadrant += 2; // Bottom half (in Vulkan Y-down)
}

  vec3 origin = cam.viewInverse[3].xyz;
  vec3 corner0 = cam.corners[0];
  vec3 corner1 = cam.corners[1];
  vec3 corner2 = cam.corners[2];
  vec3 corner3 = cam.corners[3];
  
  // In debug mode, we need to render the full scene for quadrant 3 (final lighting)
  // For other quadrants, we still need to trace rays to get valid data
  // So we always use the original UV for ray tracing
 vec2 rayP = originalP;

 // Corners from the UBO are unjittered; apply the current subpixel jitter once,
 // matching Radiance's pixelCenter += cameraJitter path.
 vec2 jitteredPixelCenter = vec2(originalPixelCoord) + vec2(0.5) + cam.jitterData.xy;
 vec2 rayUv = jitteredPixelCenter / launchSize;
  
 vec3 target = mix(mix(corner0, corner2, rayUv.y), mix(corner1, corner3, rayUv.y), rayUv.x);
  vec3 direction = normalize((cam.viewInverse * vec4(target, 0.0)).xyz);
  
  ivec2 pixelCoord = ivec2(rayP * launchSize);

#if VULKANITE_COMPILE_DIAGNOSTICS
  if (pc.debugMode >= 3 && pc.debugMode <= 6) {
    vec3 debugColor = traceProceduralDebug(origin, direction, pc.debugMode);
    imageStore(outputImage, originalPixelCoord, vec4(debugColor, 1.0));
    return;
  }
#endif

  // Initialize payload
  resetMaterialPayload();

#if VULKANITE_COMPILE_DIAGNOSTICS
  if (shouldCompareReflectionPrimary()) {
    reflectionComparisonSampled = true;

    // The material TLAS is forced to its complete triangle layout by Java while
    // mode 11 is active. Save this payload so the diagnostic trace cannot alter
    // the triangle-owned rendering path that follows below.
    traceRayEXT(
        acc,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        0,
        0,
        origin,
        0.001,
        direction,
        10000.0,
        0);
    Payload trianglePayload = payload;

    resetMaterialPayload();
    // Standalone procedural instances select record 2. The trace-time offset
    // of 4 therefore selects the material-capable procedural record 6.
    traceRayEXT(
        proceduralDebugAcc,
        gl_RayFlagsOpaqueEXT,
        0x02,
        4,
        0,
        0,
        origin,
        0.001,
        direction,
        10000.0,
        0);

    bool triangleHit = trianglePayload.hitData.w >= 0.0;
    bool proceduralHit = payload.hitData.w >= 0.0;
    if (triangleHit != proceduralHit) {
        // Red is triangle-only coverage; blue is procedural-only coverage.
        reflectionComparisonTint = triangleHit
            ? vec3(1.0, 0.01, 0.0)
            : vec3(0.0, 0.35, 1.0);
    } else if (!triangleHit) {
        reflectionComparisonTint = vec3(0.04, 0.42, 0.12);
    } else {
        if (abs(trianglePayload.hitData.w - payload.hitData.w)
                > pc.shadowComparisonDistanceTolerance) {
            reflectionComparisonFlags |= REFLECTION_COMPARISON_DISTANCE;
        }

        vec3 triangleGeometryNormal = normalize(trianglePayload.geometryNormal);
        vec3 proceduralGeometryNormal = normalize(payload.geometryNormal);
        if (dot(triangleGeometryNormal, proceduralGeometryNormal) < 0.995) {
            reflectionComparisonFlags |= REFLECTION_COMPARISON_GEOMETRY_NORMAL;
        }

        if (any(notEqual(
                ivec2(trianglePayload.material.block_id),
                ivec2(payload.material.block_id)))) {
            reflectionComparisonFlags |= REFLECTION_COMPARISON_MATERIAL_ID;
        }

        vec3 albedoDifference = abs(
            trianglePayload.material.albedo - payload.material.albedo);
        if (max(max(albedoDifference.x, albedoDifference.y), albedoDifference.z) > 0.04) {
            // This sampled-color check also exposes most atlas-UV mismatches;
            // the shared Payload ABI does not carry raw atlas UV coordinates.
            reflectionComparisonFlags |= REFLECTION_COMPARISON_ALBEDO;
        }

        vec3 emissionDifference = abs(
            trianglePayload.material.emission - payload.material.emission);
        if (max(max(emissionDifference.x, emissionDifference.y), emissionDifference.z) > 0.02) {
            reflectionComparisonFlags |= REFLECTION_COMPARISON_EMISSION;
        }

        vec3 f0Difference = abs(trianglePayload.material.F0 - payload.material.F0);
        float maxF0Difference = max(max(f0Difference.x, f0Difference.y), f0Difference.z);
        if (abs(trianglePayload.material.roughness - payload.material.roughness) > 0.03
                || abs(trianglePayload.material.metallic - payload.material.metallic) > 0.03
                || maxF0Difference > 0.04) {
            reflectionComparisonFlags |= REFLECTION_COMPARISON_PBR;
        }

        // Priority makes one mismatch class unambiguous per pixel. The thin
        // legend strip at output time shows the complete color ordering.
        reflectionComparisonTint = (reflectionComparisonFlags & REFLECTION_COMPARISON_DISTANCE) != 0u
            ? vec3(1.0, 0.48, 0.0)
            : ((reflectionComparisonFlags & REFLECTION_COMPARISON_GEOMETRY_NORMAL) != 0u
                ? vec3(1.0, 0.0, 0.8)
                : ((reflectionComparisonFlags & REFLECTION_COMPARISON_MATERIAL_ID) != 0u
                    ? vec3(1.0, 0.92, 0.0)
                    : ((reflectionComparisonFlags & REFLECTION_COMPARISON_ALBEDO) != 0u
                        ? vec3(0.0, 0.9, 1.0)
                        : ((reflectionComparisonFlags & REFLECTION_COMPARISON_EMISSION) != 0u
                            ? vec3(0.62, 0.1, 1.0)
                            : ((reflectionComparisonFlags & REFLECTION_COMPARISON_PBR) != 0u
                                ? vec3(0.55, 1.0, 0.05)
                                : vec3(0.04, 0.72, 0.16))))));
    }

    payload = trianglePayload;
  }
#endif
  
  vec3 albedo;
  vec3 normal;
  vec3 worldPos;
  vec3 directEmission = vec3(0.0);
  float roughness = 1.0;
  float metallic = 0.0;
  float ao = 1.0;
  vec3 F0 = vec3(0.04);
  float blockId = 0.0;
  float surfaceAlpha = 1.0;
  bool hit = false;
  bool cameraRelativePos = false;
  
  // Declare G-buffer variables outside the conditional block so they're accessible throughout the shader
  // These will be populated by HYBRID_RENDERING or remain as default values
  vec4 gExtraRaw = vec4(0.0); // Blocklight (R), Skylight (G), AO (B), encoded emission (A)
  
  #if HYBRID_RENDERING
  // Retain the G-buffer resources in the full-reference permutation. Deferred
  // cache-fill dispatches exit above and cache-hit frames use compute resolve.
  if (pc.cacheOnHit < 0) {
  // Force sampling of all G-buffers to ensure bindings are active
  // This prevents the compiler from optimizing them out if HYBRID_RENDERING logic is conditional
  // Use original UV coordinates for G-buffer sampling (not remapped quadrant coordinates)
  //
  // G-buffer layout (updated for proper PBR):
  // colortex1 (gbufferAlbedo): Albedo RGB, Alpha in A
  // colortex2 (gbufferMaterial): F0 reflectance RGB, roughness in A
  // colortex3 (gbufferNormal): Signed unit normal RGB, roughness packed in A
  // colortex4 (gbufferWorldPos): World position RGB, metallic flag in A
  // colortex5 (gbufferExtra): Blocklight (R), Skylight (G), AO (B), encoded emission (A)
  // These textures encode one discrete first-hit surface per pixel. Filtering
  // across silhouettes mixes unrelated normals, materials, and positions.
  // Iris keeps its G-buffer at output resolution while RT/DLSS can dispatch at
  // a lower render resolution. Use normalized screen coordinates so the two
  // images remain aligned instead of stretching the upper-left G-buffer area.
  ivec2 gPosPixel = clamp(ivec2(originalP * vec2(textureSize(gbufferWorldPos, 0))),
      ivec2(0), textureSize(gbufferWorldPos, 0) - 1);
  vec4 gPos = texelFetch(gbufferWorldPos, gPosPixel, 0);
  vec4 gNormalRaw = texelFetch(gbufferNormal,
      clamp(ivec2(originalP * vec2(textureSize(gbufferNormal, 0))), ivec2(0), textureSize(gbufferNormal, 0) - 1), 0);
  vec4 gAlbedoRaw = texelFetch(gbufferAlbedo,
      clamp(ivec2(originalP * vec2(textureSize(gbufferAlbedo, 0))), ivec2(0), textureSize(gbufferAlbedo, 0) - 1), 0);
  vec4 gMaterialRaw = texelFetch(gbufferMaterial,
      clamp(ivec2(originalP * vec2(textureSize(gbufferMaterial, 0))), ivec2(0), textureSize(gbufferMaterial, 0) - 1), 0);
  gExtraRaw = texelFetch(gbufferExtra,
      clamp(ivec2(originalP * vec2(textureSize(gbufferExtra, 0))), ivec2(0), textureSize(gbufferExtra, 0) - 1), 0);

    // Use the sampled values (even if trivially) to ensure they contribute to the output
    // In a real scenario, these would be used for shading.
    // Here we use them to populate the payload if a valid hit is found.
    if (validHybridSample(gPos, gNormalRaw, gAlbedoRaw, gMaterialRaw, gExtraRaw)) {
        worldPos = gPos.xyz;
        cameraRelativePos = true;
        normal = normalize(gNormalRaw.xyz);
        
        blockId = decodeGbufferBlockId(gPos.w);
        metallic = blockId > 0.0 ? 0.0 : clamp(gPos.w, 0.0, 1.0);
        
        // Read F0 reflectance
        F0 = clamp(gMaterialRaw.rgb, vec3(0.0), vec3(1.0));
        roughness = clamp(gMaterialRaw.a, 0.04, 1.0);

        // For metals: albedo is used as base color, combined with F0 for colored metals
        // For dielectrics: albedo is the diffuse color
        // The PBR shader handles this properly via the (1.0 - metallic) term in diffuse
        albedo = max(gAlbedoRaw.rgb, vec3(0.0));
        surfaceAlpha = clamp(gAlbedoRaw.a, 0.0, 1.0);

        // AO from colortex5.b
        ao = clamp(gExtraRaw.b, 0.0, 1.0);

        applyBlockMaterialOverrides(blockId, albedo, F0, metallic, roughness);
        directEmission = hasEncodedLabPbrEmission(gExtraRaw.a)
            ? visibleEmissionRadiance(
                albedo
                * decodeEncodedLabPbrEmission(gExtraRaw.a)
                * EMISSION_INTENSITY
                * EMISSIVE_SURFACE_INTENSITY)
            : vec3(0.0);

        hit = true;
    }
  }
#endif

  if (!hit) {
    traceRayEXT(acc, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, origin, 0.001, direction, 10000.0, 0);
    if (payload.hitData.w >= 0.0) {
      worldPos = payload.hitData.xyz;
      cameraRelativePos = false;
      normal = normalize(payload.material.normal);
      albedo = payload.material.albedo;
      directEmission = payload.material.emission;
      roughness = payload.material.roughness;
      metallic = payload.material.metallic;
      ao = payload.material.ambientOcclusion;
      F0 = payload.material.F0;
      blockId = float(payload.material.block_id.x);
      surfaceAlpha = clamp(payload.material.translucent, 0.0, 1.0);
      applyBlockMaterialOverrides(blockId, albedo, F0, metallic, roughness);
      hit = true;
    }
  }

  // Calculate sun direction and color globally for sky and lighting
  vec3 sunDirWorld = vec3(pc.sunDirX, pc.sunDirY, pc.sunDirZ);
  if (dot(sunDirWorld, sunDirWorld) < 0.000001) sunDirWorld = vec3(0.5, 1.0, 0.2); // Default
  vec3 lightDir = normalize(sunDirWorld);
  // Apply sun elevation-based color temperature for natural lighting
  // Low sun = warm orange (sunset/sunrise), high sun = neutral white
  vec3 baseSunColor = vec3(pc.sunColorR, pc.sunColorG, pc.sunColorB) * SUN_INTENSITY;
  vec3 sunColor = getSunColorFromElevation(lightDir, baseSunColor);

  vec4 color;
  vec2 motionVec = vec2(0.0);
#if SECTION_LIGHT_PROBE_DEBUG_MODE != 0
  vec3 sectionLightProbeDebugOutput = vec3(0.015, 0.02, 0.035);
  bool sectionLightProbeDebugHasSurface = false;
#endif
  if (!hit) {
#if RESTIR_SUN_SHADOWS == 1
    clearSunShadowHistory(originalPixelCoord);
#endif
    // Sky color with procedural gradient and sun glow
    uint volumeSeed = hashUint(
        uint(originalPixelCoord.x + originalPixelCoord.y * int(launchSize.x)),
        0x68bc21ebu);
    vec4 volume = integrateVolumetrics(
        origin,
        direction,
        VOLUMETRIC_DISTANCE,
        lightDir,
        sunColor,
        volumeSeed);
    vec3 moonDir = normalize(cam.moonPosition.xyz);
    color = vec4(getSkyColor(
        direction,
        lightDir,
        moonDir,
        sunColor,
        float(cam.frameId) * 0.016) * volume.a + volume.rgb, 1.0);
    
#if ENABLE_DLSS_RR
    // Treat sky as infinitely distant for DLSS/RR guide buffers. Reprojecting a
    // finite far point injects huge motion into the history, especially at distance.
    motionVec = vec2(0.0);
    imageStore(motionVectors, originalPixelCoord, vec4(motionVec, 0.0, 0.0));
    imageStore(linearDepthImage, originalPixelCoord, vec4(10000.0)); // Sky depth should be far away, not 0.0
    writeSkyDlssSidecars(originalPixelCoord);
#endif
  } else {
    // Keep all secondary-ray work in absolute world space. The hybrid G-buffer
    // stores camera-relative positions, while the TLAS and camera origin are absolute.
    vec3 shadingWorldPos = cameraRelativePos ? (worldPos + origin) : worldPos;
    bool waterSurface = isWaterMaterial(blockId);
    bool glassSurface = isGlassMaterial(blockId);
    bool iceSurface = isIceMaterial(blockId);
    bool crystalSurface = isCrystalMaterial(blockId);
    bool thinTransparentSurface = surfaceAlpha < 0.98
        && !isFoliageMaterial(blockId)
        && !waterSurface
        && !glassSurface
        && !iceSurface;
    bool refractiveSurface = waterSurface || glassSurface || iceSurface || crystalSurface
        || thinTransparentSurface;
    float diffuseOpacity = waterSurface
        ? 0.08
        : (glassSurface
            ? max(1.0 - GLASS_TRANSMISSION, 0.06)
            : (iceSurface
                ? max(1.0 - ICE_TRANSMISSION, 0.18)
                : (crystalSurface
                    ? max(1.0 - CRYSTAL_TRANSMISSION, 0.25)
                    : (thinTransparentSurface ? surfaceAlpha : 1.0))));
    vec3 diffuseAlbedo = albedo * diffuseOpacity;

    // --- Calculate motion vectors FIRST for ReSTIR temporal reuse ---
    vec2 shadowHistoryPrevPixel = jitteredPixelCenter;
    bool shadowHistoryHasPrev = false;

#if ENABLE_DLSS_RR
    // Match the jittered primary sample used for ray generation. NGX receives
    // the same jitter at the evaluate boundary, with the sign converted there.
    vec2 currentPixel = jitteredPixelCenter;
    vec2 currentUV = currentPixel / launchSize;

    // 2. Previous frame position via world-space reprojection.
    // CRITICAL FIX: worldPos from G-buffer is camera-relative (Player Space).
    // To get the equivalent position in Absolute World Space, we just add the absolute
    // camera position. Using viewInverse is incorrect here since worldPos is NOT in View Space.
    vec3 absWorldPos = cameraRelativePos ? (worldPos + origin) : worldPos;
    vec4 prevClipPos = cam.prevViewProj * vec4(absWorldPos, 1.0);
    vec2 prevUV = currentUV;
    bool hasValidPrevProjection = prevClipPos.w > 1e-5
        && !any(isnan(prevClipPos))
        && !any(isinf(prevClipPos));
    if (hasValidPrevProjection) {
        vec3 prevNDC = prevClipPos.xyz / prevClipPos.w;
        hasValidPrevProjection = all(lessThanEqual(abs(prevNDC.xy), vec2(1.25)));
        if (hasValidPrevProjection) {
            prevUV = prevNDC.xy * 0.5 + 0.5;
            shadowHistoryPrevPixel = prevUV * launchSize;
            shadowHistoryHasPrev = true;
        }
        // NOTE: No Y-flip here — prevViewProj already produces UVs in the same
        // coordinate space as currentUV (matching the sky path which also has no Y-flip).
    }

    // DLSSD Motion Vector Calculation:
    // - DLSSD expects motion vectors in PIXEL SPACE representing pure GEOMETRIC displacement.
    // - prevViewProj is UNJITTERED (passed from Java) - pure geometric motion.
    // - DLSS receives jitter offsets separately and handles jitter compensation internally.
    motionVec = hasValidPrevProjection
        ? clamp(prevUV * launchSize - currentPixel, -launchSize, launchSize)
        : vec2(0.0);

    // Store motion vectors for DLSS (pixel space, RGBA16F)
    imageStore(motionVectors, originalPixelCoord, vec4(motionVec, 0.0, 0.0));

    // Write linear depth (distance from camera) for DLSS Ray Reconstruction.
    vec3 cameraForward = -normalize(cam.viewInverse[2].xyz);
    float linearDepth = cameraRelativePos ? max(dot(worldPos, cameraForward), 0.0) : max(dot(worldPos - origin, cameraForward), 0.0);
    imageStore(linearDepthImage, originalPixelCoord, vec4(linearDepth));
    writeRadianceDlssSidecars(
        originalPixelCoord,
        albedo,
        metallic,
        F0,
        normal,
        roughness,
        linearDepth,
        linearDepth);
#endif
    
    // --- Direct Lighting ---
    vec3 viewDir = normalize(origin - shadingWorldPos);

    // Keep the receiver fixed while the camera moves. Bias depends only on
    // surface/light geometry, not view distance.
    float viewDist = length(shadingWorldPos - origin);
    float specularHitDistanceGuide = viewDist;
    float grazing = 1.0 - max(dot(normal, lightDir), 0.0);
    float adaptiveBias = mix(0.003, 0.009, grazing);
    vec3 rayOrigin = shadingWorldPos + normal * adaptiveBias;

    float finalShadow = 0.0;
    uint seed = hashUint(uint(originalPixelCoord.x + originalPixelCoord.y * int(launchSize.x)), cam.frameId);
    uint stableSeed = hashUint(uint(originalPixelCoord.x + originalPixelCoord.y * int(launchSize.x)), 0x9e3779b9u);
    // Never rotate the sun disk by pixel, frame, or surface position. Adjacent
    // rotations turn camera motion into visible penumbra noise.
    uvec3 lightingCell = floatBitsToUint(floor(shadingWorldPos));
    uint worldLightingSeed = hashUint(hashUint(lightingCell.x, lightingCell.y), lightingCell.z);
    float stableLightRotation = float(cam.frameId & 3u) * 0.25;

    vec3 baseLightDir = lightDir;
    float baseNdotL = max(dot(normal, baseLightDir), 0.0);

    // Build tangent/bitangent for sun disk jittering
    vec3 tangent, bitangent;
    createOrthonormalBasis(baseLightDir, tangent, bitangent);

#if RESTIR_SUN_SHADOWS == 1
    // Check if ReSTIR is enabled via push constant
    if (pc.enableReSTIR == 1 && ENABLE_RESTIR == 1) {
        // --- ReSTIR DI ---
        RestirReservoir r;
        initReservoir(r);
    
        float sunRadius = PENUMBRA_RADIUS;
        float frameRotation = stableLightRotation;
    
        // 1. Initial Sampling (Stochastic Sun — 2 candidates)
        for (int i = 0; i < 4; i++) {
            float rSun = sunRadius * sqrt(rand(stableSeed));
            float thetaSun = TWO_PI * fract(rand(stableSeed) + frameRotation);
            vec2 sunOffset = vec2(rSun * cos(thetaSun), rSun * sin(thetaSun));
            vec3 jitteredLightDir = normalize(baseLightDir + (tangent * sunOffset.x + bitangent * sunOffset.y));
    
            // ReSTIR optimization: Do not trace visibility rays for initial candidates!
            // The unshadowed target function is sufficient for importance sampling the sun disk.
            // A single visibility ray will be traced for the final chosen sample.
            float pHat = getPHat(worldPos, normal, worldPos + jitteredLightDir * 100.0, sunColor);
            updateReservoir(r, pHat, sunOffset, rand(seed));
        }
    
        // 2. Temporal Reuse with proper motion vector reprojection
#if ENABLE_RESTIR_TEMPORAL_REUSE
    // Use motion vectors to find the previous frame's pixel coordinate
    ivec2 prevCoord = originalPixelCoord;
    bool hasTemporalSample = false;

    #if ENABLE_DLSS_RR
    // ReSTIR reads from the previous frame's reservoir buffer.
    // prevUV from prevViewProj is UNJITTERED (pure geometric motion),
    // matching the previous frame's reservoir buffer coordinates.
    // So we can use prevUV directly without adding jitter again.
    vec2 exactPrevCoord = prevUV * launchSize;
    hasTemporalSample = hasValidPrevProjection
        && all(greaterThanEqual(exactPrevCoord, vec2(0.0)))
        && all(lessThan(exactPrevCoord, launchSize));
	if (hasTemporalSample) {
	prevCoord = clamp(ivec2(exactPrevCoord), ivec2(0), ivec2(launchSize) - ivec2(1));
	}
    #endif
        
        if (hasTemporalSample) {
            RestirReservoir prevR = unpackReservoir(imageLoad(prevReservoirImage, prevCoord));
            clampReservoir(prevR, float(RESTIR_MAX_HISTORY));
        
            vec3 prevJitteredDir = normalize(baseLightDir + (tangent * prevR.offset.x + bitangent * prevR.offset.y));
            float pHatPrev = getPHat(worldPos, normal, worldPos + prevJitteredDir * 100.0, sunColor);
            
            if (pHatPrev > 0.0) {
                combineReservoir(r, prevR, pHatPrev, rand(seed));
            }
        }
#endif
    
        // 3. Spatial Reuse using injected settings
        #if HYBRID_RENDERING
            spatialReuse(r, gbufferNormal, gbufferWorldPos, originalPixelCoord, worldPos, normal, baseLightDir, sunColor, float(RESTIR_SPATIAL_RADIUS), rand(seed), int(RESTIR_SPATIAL_SAMPLES));
        #endif
    
        // Selected sample direction
        vec3 finalLightDir = normalize(baseLightDir + (tangent * r.offset.x + bitangent * r.offset.y));
        float finalPHat = getPHat(worldPos, normal, worldPos + finalLightDir * 100.0, sunColor);
    
        finalizeReservoir(r, finalPHat);
        imageStore(reservoirImage, originalPixelCoord, packReservoir(r));
    
        // Final Shadow Ray for the selected sample
        if (r.W > 0.0) {
            finalShadow = alphaAwareVisibility(rayOrigin, finalLightDir, 10000.0)
                * clamp(r.W, 0.0, 2.0);
        }

        lightDir = finalLightDir;
    } else
#endif
    {
        float sunRadius = PENUMBRA_RADIUS;
#if SUN_SHADOW_MODE == 0
        // Off/lightmap mode keeps direct sun unshadowed and avoids RT visibility.
        finalShadow = baseNdotL > 0.0 ? 1.0 : 0.0;
#elif SUN_SHADOW_MODE == 1
        // Single deterministic sun-disk sample. DLSS/RR or later history passes
        // can accumulate the frame-indexed sequence without stochastic shimmer.
        if (baseNdotL > 0.0) {
            uint pixelSeed = uint(originalPixelCoord.x + originalPixelCoord.y * int(launchSize.x));
            vec2 diskOffset = deterministicSunDiskOffset(pixelSeed, cam.frameId, sunRadius);
            vec3 jitteredLightDir = normalize(baseLightDir + tangent * diskOffset.x + bitangent * diskOffset.y);
            finalShadow = alphaAwareVisibility(rayOrigin, jitteredLightDir, 10000.0);
        }
#elif SUN_SHADOW_MODE == 2
        // Placeholder checkerboard mode: trace half the pixels each frame. A
        // dedicated sun history/resolve pass should replace the untraced fallback.
        bool tracePixel = ((originalPixelCoord.x + originalPixelCoord.y + int(cam.frameId & 1u)) & 1) == 0;
        if (baseNdotL > 0.0) {
            if (tracePixel) {
                uint pixelSeed = uint(originalPixelCoord.x + originalPixelCoord.y * int(launchSize.x));
                vec2 diskOffset = deterministicSunDiskOffset(pixelSeed, cam.frameId, sunRadius);
                vec3 jitteredLightDir = normalize(baseLightDir + tangent * diskOffset.x + bitangent * diskOffset.y);
                finalShadow = alphaAwareVisibility(rayOrigin, jitteredLightDir, 10000.0);
            } else {
                finalShadow = 1.0;
            }
        }
#else
        // High-quality fallback: multi-sample soft shadows with proper penumbra.
        // Use stratified sampling across the sun disk for smooth penumbra.
        const int SHADOW_SAMPLES = PENUMBRA_SAMPLES;
        const int SHADOW_SAMPLE_PAIRS = (SHADOW_SAMPLES + 1) / 2;
        
        float shadowAccum = 0.0;
        if (baseNdotL > 0.0) {
            for (int s = 0; s < SHADOW_SAMPLES; s++) {
                int pairIndex = s / 2;
                float pairSide = (s & 1) == 0 ? 1.0 : -1.0;
                float theta = float(pairIndex) * 2.39996323;
                float r = sunRadius * sqrt((float(pairIndex) + 0.5) / float(SHADOW_SAMPLE_PAIRS));
                vec2 diskOffset = pairSide * r * vec2(cos(theta), sin(theta));

                vec3 jitteredLightDir = normalize(baseLightDir + tangent * diskOffset.x + bitangent * diskOffset.y);
                shadowAccum += alphaAwareVisibility(rayOrigin, jitteredLightDir, 10000.0);
            }

            finalShadow = shadowAccum / float(SHADOW_SAMPLES);
        }
#endif
#if RESTIR_SUN_SHADOWS == 1
        finalShadow = resolveSunShadowHistory(
            originalPixelCoord,
            shadowHistoryPrevPixel,
            shadowHistoryHasPrev,
            shadingWorldPos,
            normal,
            viewDist,
            finalShadow);
#endif
        // The disk samples estimate visibility only. Shading against the final
        // random sample moves highlights and changes energy between frames.
        lightDir = baseLightDir;
    }

    float hardShadow = finalShadow;
    float diffuseShadow = mix(hardShadow, finalShadow, PENUMBRA_DIFFUSE_BLEND);
    float specularShadow = finalShadow;

    vec3 directDiffuse;
    vec3 directSpecular;
    evaluatePBRSplit(diffuseAlbedo, normal, viewDir, lightDir, sunColor, F0, roughness, metallic, SPECULAR_INTENSITY, directDiffuse, directSpecular);
    vec3 directSunLighting = directDiffuse * diffuseShadow + directSpecular * specularShadow;

    // --- Indirect diffuse GI path ---
    vec3 indirectContrib = vec3(0.0);
    vec3 indirectOrigin = rayOrigin;
    vec3 indirectNormal = normal;
    vec3 indirectThroughput = vec3(1.0);
    vec3 firstBounceIncidentRadiance = vec3(0.0);
    float firstBounceHitDistance = 10000.0;
    bool firstBounceSampled = false;
    int indirectBounceCount = clamp(INDIRECT_BOUNCES, 1, 3);

    for (int bounce = 0; bounce < 3; bounce++) {
        if (bounce >= indirectBounceCount) {
            break;
        }

        vec3 bounceDir = cosineWeightedHemisphere(indirectNormal, seed);
        payload.hitData = vec4(0.0, 0.0, 0.0, -1.0);
        payload.material.emission = vec3(0.0);
        payload.material.albedo = vec3(0.0);
        payload.material.F0 = vec3(0.04);
        payload.material.metallic = 0.0;
        payload.material.roughness = 1.0;
        payload.material.normal = vec3(0.0, 1.0, 0.0);
        payload.material.ambientOcclusion = 1.0;
        traceRayEXT(
            acc,
            gl_RayFlagsNoneEXT,
            0xFF,
            0,
            0,
            0,
            indirectOrigin,
            0.01,
            bounceDir,
            100.0,
            0);

        if (payload.hitData.w < 0.0) {
            if (bounce == 0) {
                firstBounceIncidentRadiance = max(payload.hitData.xyz, vec3(0.0));
                firstBounceSampled = true;
            }
            float skyBounceScale = bounce == 0 ? 0.5 : 0.22;
            indirectContrib += indirectThroughput
                * max(payload.hitData.xyz, vec3(0.0))
                * skyBounceScale;
            break;
        }

        vec3 hitNormal = normalize(payload.material.normal);
        vec3 hitAlbedo = max(payload.material.albedo, vec3(0.0));
        float bounceHitDistance = payload.hitData.w;
        float hitAo = clamp(payload.material.ambientOcclusion, 0.0, 1.0);
        float hitNdotL = max(dot(hitNormal, lightDir), 0.0);
        float hitShadow = 0.0;
        if (hitNdotL > 0.0) {
            hitShadow = alphaAwareVisibility(
                payload.hitData.xyz + hitNormal * 0.05,
                lightDir,
                10000.0);
        }

        vec3 hitAmbient = hitAlbedo
            * (vec3(0.025, 0.03, 0.04) + sunColor * 0.018)
            * AMBIENT_FACTOR
            * (0.12 + 0.38 * hitAo);
        vec3 hitRadiance = payload.material.emission
            + hitAlbedo * sunColor * hitNdotL * hitShadow
            + hitAmbient;
        if (bounce == 0) {
            firstBounceIncidentRadiance = max(hitRadiance, vec3(0.0));
            firstBounceHitDistance = bounceHitDistance;
            firstBounceSampled = true;
        }
        float bounceScale = bounce == 0 ? INDIRECT_SCALE : INDIRECT_SCALE * 0.55;
        indirectContrib += indirectThroughput * hitRadiance * bounceScale;

        indirectThroughput *= hitAlbedo * min(INDIRECT_SCALE * 0.55, 0.72);
        if (dot(indirectThroughput, vec3(0.2126, 0.7152, 0.0722)) < 0.003) {
            break;
        }

        indirectOrigin = payload.hitData.xyz + hitNormal * 0.035;
        indirectNormal = hitNormal;
    }
    if (pc.cacheOnHit != 0 && firstBounceSampled) {
        ivec4 diffuseKey = ivec4(
            ivec3(floor(shadingWorldPos)),
            diffuseRadianceNormalBucket(normal));
        publishDiffuseRadianceCache(
            diffuseKey,
            firstBounceIncidentRadiance,
            firstBounceHitDistance);
    }
    // --- Specular Environment Reflections with GGX Importance Sampling ---
// Both metals and non-metals benefit from environment reflections.
// Metals: F0 determines reflection color (colored metals like gold, copper)
// Non-metals: Dim reflections at grazing angles (F0 ~0.04 for dielectrics)
// 
// For metals, we use multi-bounce reflections with Russian Roulette termination
// to properly capture inter-reflections between metal surfaces.
vec3 specularEnvContrib = vec3(0.0);

// Only trace reflection rays for surfaces with noticeable reflectivity
// Skip for very rough surfaces (roughness > 0.85) as they scatter too much
float reflectionRoughnessLimit = mix(REFLECTION_MAX_ROUGHNESS, 0.88, metallic);
float surfaceFresnelLuma = dot(
    fresnelSchlick(max(dot(normal, viewDir), 0.0), F0),
    vec3(0.2126, 0.7152, 0.0722));
if (!refractiveSurface
        && roughness < reflectionRoughnessLimit
        && (metallic > 0.5 || surfaceFresnelLuma > 0.025)) {
    if (pc.cacheOnHit < 0) {
        vec3 reflectionDirection = normalize(reflect(-viewDir, normal));
        ivec4 transportKey = specularTransportKey(
            shadingWorldPos, normal, roughness, metallic, blockId, surfaceAlpha);
        uint transportDetail = uint(specularTransportDirectionBucket(reflectionDirection));
        vec3 cachedReflection;
        vec3 unusedRefraction;
        float cachedReflectionDistance;
        float unusedRefractionDistance;
        bool transportHit = readSpecularTransportCache(
            transportKey,
            0u,
            transportDetail,
            cachedReflection,
            unusedRefraction,
            cachedReflectionDistance,
            unusedRefractionDistance);
        if (transportHit) {
            vec3 fresnel = fresnelSchlick(max(dot(normal, viewDir), 0.0), F0);
            float baseReflectionStrength = mix(DIELECTRIC_REFLECTION_SCALE, 1.0, metallic);
            float roughnessAttenuation = 1.0 - roughness * roughness;
            float envBrightness = dot(cachedReflection, vec3(0.299, 0.587, 0.114));
            float envScale = 0.2 + 0.8 * smoothstep(0.0, 0.3, envBrightness);
            specularEnvContrib = cachedReflection
                * fresnel
                * baseReflectionStrength
                * roughnessAttenuation
                * envScale
                * METAL_REFLECTION_SCALE
                * SPECULAR_INTENSITY;
            specularHitDistanceGuide = cachedReflectionDistance;
        } else {
            specularHitDistanceGuide = 10000.0;
        }
    } else {
    // Initial path throughput - tracks accumulated reflection color
    vec3 throughput = vec3(1.0);
    vec3 reflectionAccum = vec3(0.0);
    
    // Current ray state
    vec3 currentOrigin = rayOrigin;
    vec3 currentNormal = normal;
    vec3 currentViewDir = viewDir;
    vec3 currentF0 = F0;
    float currentRoughness = roughness;
    float currentMetallic = metallic;
    
    // Multi-bounce reflection loop
    for (int bounce = 0; bounce < METAL_MAX_BOUNCES; bounce++) {
        // Skip if throughput is negligible
        float throughputLuma = dot(throughput, vec3(0.299, 0.587, 0.114));
        if (throughputLuma < 0.001) break;
        
        // Russian Roulette termination after minimum bounces
        if (bounce >= METAL_RR_MIN_BOUNCE) {
            float rrProb = russianRouletteProb(throughput);
            if (rand(seed) > rrProb) break;
            throughput /= rrProb; // Compensate for terminated paths
        }
        
        // Sample reflection direction using GGX importance sampling
        vec3 reflectDir;
        float pdf;
        
        #if METAL_GGX_IMPORTANCE
            // GGX importance sampling - physically correct for metals
            reflectDir = sampleGGXReflection(currentViewDir, currentNormal, currentRoughness, seed, pdf);
        #else
            // Fallback: simple reflection with roughness jittering
            vec3 perfectReflect = reflect(-currentViewDir, currentNormal);
            float roughnessJitter = currentRoughness * 0.5;
            reflectDir = normalize(perfectReflect +
                (vec3(rand(seed), rand(seed), rand(seed)) * 2.0 - 1.0) * roughnessJitter);
            pdf = 1.0; // Uniform sampling
        #endif
        
        // Check if reflection direction is valid (above surface)
        float NdotReflect = dot(currentNormal, reflectDir);
        if (NdotReflect <= 0.0 || pdf <= 1e-6 ||
            any(isnan(reflectDir)) || any(isinf(reflectDir))) {
            // Reflection goes below surface - skip this bounce
            break;
        }
        
        // Trace reflection ray
        payload.hitData = vec4(0, 0, 0, -1);
        payload.material.emission = vec3(0.0);
        payload.material.albedo = vec3(0.0);
        traceRayEXT(acc, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0,
                    currentOrigin + currentNormal * 0.01, 0.001, reflectDir,
                    REFLECTION_RAY_DISTANCE, 0);
        float reflectionTransportDistance = payload.hitData.w < 0.0
            ? 10000.0
            : payload.hitData.w;
        if (bounce == 0) {
            specularHitDistanceGuide = reflectionTransportDistance;
        }
        
        vec3 envColor;
        float envBrightness = 0.0;
        
        if (payload.hitData.w < 0.0) {
            // Miss — use sky color from miss shader
            envColor = payload.hitData.xyz;
            envBrightness = dot(envColor, vec3(0.299, 0.587, 0.114));
        } else {
            // Hit — check if the hit surface is lit by the sun
            vec3 hitNormal = normalize(payload.material.normal);
            vec3 hitPos = payload.hitData.xyz;
            float hitNdotL = max(dot(hitNormal, lightDir), 0.0);
            float hitShadow = 0.0;
            
            if (hitNdotL > 0.0) {
                hitShadow = alphaAwareVisibility(
                    hitPos + hitNormal * 0.02,
                    lightDir,
                    10000.0);
            }
            
            // Calculate lit color of hit surface
            vec3 hitLitColor = payload.material.albedo * sunColor * hitNdotL * hitShadow * 0.5
                + payload.material.emission;
            
            // Add ambient contribution
            float hitAO = clamp(payload.material.ambientOcclusion, 0.0, 1.0);
            vec3 simpleAmbient = vec3(0.05) * (0.3 + 0.7 * hitAO);
            hitLitColor += payload.material.albedo * simpleAmbient;
            
            envColor = max(hitLitColor, vec3(0.0));
            envBrightness = dot(envColor, vec3(0.299, 0.587, 0.114));
        }

        if (pc.cacheOnHit != 0 && bounce == 0) {
            ivec4 transportKey = specularTransportKey(
                shadingWorldPos, normal, roughness, metallic, blockId, surfaceAlpha);
            uint transportDetail = uint(specularTransportDirectionBucket(reflectDir));
            publishSpecularTransportCache(
                transportKey,
                0u,
                transportDetail,
                envColor,
                vec3(0.0),
                reflectionTransportDistance,
                10000.0);
        }
        
        // Calculate Fresnel for this bounce
        float NdotV = max(dot(currentNormal, currentViewDir), 0.0);
        vec3 F = fresnelSchlick(NdotV, currentF0);
        
        // Base reflection strength: metals reflect fully, dielectrics get dimmer
        float baseReflectionStrength = mix(
            DIELECTRIC_REFLECTION_SCALE,
            1.0,
            currentMetallic);
        
        // Roughness attenuation (GGX-style)
        float roughnessAttenuation = (1.0 - currentRoughness * currentRoughness);
        
        // Environment brightness scaling
        float envScale = 0.2 + 0.8 * smoothstep(0.0, 0.3, envBrightness);
        
        // Combine factors
        float reflectionStrength = baseReflectionStrength * roughnessAttenuation * envScale;
        
        // GGX BRDF weight for importance sampling
        #if METAL_GGX_IMPORTANCE
            // BRDF * cos(theta) / PDF for NDF-sampled GGX. The previous
            // NdotL/PDF term omitted the GGX distribution/geometry factors and
            // produced enormous low-PDF fireflies.
            vec3 H = normalize(currentViewDir + reflectDir);
            float NdotH = max(dot(currentNormal, H), 1e-4);
            float HdotV = max(dot(H, currentViewDir), 1e-4);
            float NdotVSafe = max(dot(currentNormal, currentViewDir), 1e-4);
            float G = geometrySmith(NdotVSafe, NdotReflect, max(currentRoughness, 0.04));
            vec3 brdfWeight = F * (G * HdotV / (NdotVSafe * NdotH));
            brdfWeight = clamp(brdfWeight, vec3(0.0), vec3(4.0));
        #else
            vec3 brdfWeight = F;
        #endif
        
        // Accumulate reflection contribution
        vec3 reflectionSample = throughput * envColor * brdfWeight
            * reflectionStrength * METAL_REFLECTION_SCALE;
        if (!any(isnan(reflectionSample)) && !any(isinf(reflectionSample))) {
            reflectionAccum += min(reflectionSample, vec3(16.0));
        }
        
        // Update throughput for next bounce (only for metals)
        if (currentMetallic < 0.5) break; // Dielectrics only get one bounce
        
        // Update path state for next bounce
        throughput *= F * reflectionStrength;
        currentOrigin = payload.hitData.w < 0.0 ? vec3(0.0) : payload.hitData.xyz;
        currentNormal = payload.hitData.w < 0.0 ? vec3(0.0) : normalize(payload.material.normal);
        currentViewDir = -reflectDir;
        currentF0 = payload.hitData.w < 0.0 ? vec3(0.04) : payload.material.F0;
        currentRoughness = payload.hitData.w < 0.0 ? 0.5 : payload.material.roughness;
        currentMetallic = payload.hitData.w < 0.0 ? 0.0 : payload.material.metallic;
        
        // Stop if we hit sky or invalid surface
        if (payload.hitData.w < 0.0) break;
    }
    
    specularEnvContrib = reflectionAccum * SPECULAR_INTENSITY;
    }
}

if (refractiveSurface) {
    if (pc.cacheOnHit < 0) {
        vec3 incident = -viewDir;
        vec3 reflectionDirection = normalize(reflect(incident, normal));
        float ior = waterSurface ? 1.333 : (iceSurface ? 1.31 : (crystalSurface ? 2.20 : 1.50));
        vec3 refractionDirection = refract(incident, normal, 1.0 / ior);
        if (dot(refractionDirection, refractionDirection) <= 1e-6) {
            refractionDirection = reflectionDirection;
        } else {
            refractionDirection = normalize(refractionDirection);
        }
        uint transportDetail = uint(specularTransportMedium(blockId))
            | (uint(specularTransportDirectionBucket(reflectionDirection)) << 8u)
            | (uint(specularTransportDirectionBucket(refractionDirection)) << 16u);
        ivec4 transportKey = specularTransportKey(
            shadingWorldPos, normal, roughness, metallic, blockId, surfaceAlpha);
        vec3 reflectedRadiance;
        vec3 refractedRadiance;
        float reflectionDistance;
        float refractionDistance;
        bool transportHit = readSpecularTransportCache(
            transportKey,
            1u,
            transportDetail,
            reflectedRadiance,
            refractedRadiance,
            reflectionDistance,
            refractionDistance);
        if (transportHit) {
            vec3 fresnel = fresnelSchlick(max(dot(normal, viewDir), 0.0), F0);
            if (waterSurface) {
                fresnel = clamp(fresnel * WATER_REFLECTION_STRENGTH, vec3(0.0), vec3(1.0));
                vec3 waterTint = waterTintColor(albedo);
                vec3 absorption = waterAbsorption(refractionDistance);
                refractedRadiance = refractedRadiance * absorption
                    + waterTint * (1.0 - absorption);
            } else if (glassSurface) {
                refractedRadiance *= mix(vec3(1.0), max(albedo, vec3(0.2)), 0.28)
                    * GLASS_TRANSMISSION;
            } else if (iceSurface) {
                vec3 iceTint = iceTintColor(albedo);
                vec3 absorption = iceAbsorption(refractionDistance);
                refractedRadiance = refractedRadiance * absorption * iceTint
                    + iceTint * (1.0 - absorption) * 0.18;
            } else if (crystalSurface) {
                refractedRadiance *= mix(vec3(1.0), max(albedo, vec3(0.12)), 0.55)
                    * CRYSTAL_TRANSMISSION;
            } else {
                refractedRadiance *= mix(vec3(1.0), max(albedo, vec3(0.1)), 0.35)
                    * surfaceAlpha;
            }
            specularEnvContrib = mix(refractedRadiance, reflectedRadiance, fresnel)
                * SPECULAR_INTENSITY;
            specularHitDistanceGuide = min(reflectionDistance, refractionDistance);
        } else {
            specularHitDistanceGuide = 10000.0;
        }
    } else {
    vec3 incident = -viewDir;
    vec3 reflectionDirection = normalize(reflect(incident, normal));
    float reflectionDistance;
    vec3 reflectedRadiance = traceSimpleRadiance(
        shadingWorldPos + normal * 0.025,
        reflectionDirection,
        lightDir,
        sunColor,
        blockId,
        false,
        reflectionDistance);

    float ior = waterSurface ? 1.333 : (iceSurface ? 1.31 : (crystalSurface ? 2.20 : 1.50));
    vec3 refractionDirection = refract(incident, normal, 1.0 / ior);
    vec3 cachedRefractionDirection = dot(refractionDirection, refractionDirection) > 1e-6
        ? normalize(refractionDirection)
        : reflectionDirection;
    float refractionDistance = 10000.0;
    vec3 refractedRadiance = reflectedRadiance;
    if (dot(refractionDirection, refractionDirection) > 1e-6) {
        refractedRadiance = traceSimpleRadiance(
            shadingWorldPos - normal * 0.025,
            cachedRefractionDirection,
            lightDir,
            sunColor,
            blockId,
            false,
            refractionDistance);
    }

    if (pc.cacheOnHit != 0) {
        uint transportDetail = uint(specularTransportMedium(blockId))
            | (uint(specularTransportDirectionBucket(reflectionDirection)) << 8u)
            | (uint(specularTransportDirectionBucket(cachedRefractionDirection)) << 16u);
        ivec4 transportKey = specularTransportKey(
            shadingWorldPos, normal, roughness, metallic, blockId, surfaceAlpha);
        publishSpecularTransportCache(
            transportKey,
            1u,
            transportDetail,
            reflectedRadiance,
            refractedRadiance,
            reflectionDistance,
            refractionDistance);
    }

    vec3 fresnel = fresnelSchlick(max(dot(normal, viewDir), 0.0), F0);
    if (waterSurface) {
        fresnel = clamp(fresnel * WATER_REFLECTION_STRENGTH, vec3(0.0), vec3(1.0));
        vec3 waterTint = waterTintColor(albedo);
        vec3 absorption = waterAbsorption(refractionDistance);
        refractedRadiance = refractedRadiance * absorption
            + waterTint * (1.0 - absorption);
    } else if (glassSurface) {
        refractedRadiance *= mix(vec3(1.0), max(albedo, vec3(0.2)), 0.28)
            * GLASS_TRANSMISSION;
    } else if (iceSurface) {
        vec3 iceTint = iceTintColor(albedo);
        vec3 absorption = iceAbsorption(refractionDistance);
        refractedRadiance = refractedRadiance * absorption * iceTint
            + iceTint * (1.0 - absorption) * 0.18;
    } else if (crystalSurface) {
        refractedRadiance *= mix(vec3(1.0), max(albedo, vec3(0.12)), 0.55)
            * CRYSTAL_TRANSMISSION;
    } else {
        refractedRadiance *= mix(vec3(1.0), max(albedo, vec3(0.1)), 0.35)
            * surfaceAlpha;
    }

    specularEnvContrib = mix(refractedRadiance, reflectedRadiance, fresnel)
        * SPECULAR_INTENSITY;
    specularHitDistanceGuide = min(reflectionDistance, refractionDistance);
    }
}

    // --- Ambient (sky-based hemisphere lighting) ---
    // Natural ambient responds to sun elevation for time-of-day variation
    float sunElev = lightDir.y;
    float dayAmount = smoothstep(-0.1, 0.3, sunElev);
    
    // Sky hemisphere: upper sky contributes more to upward-facing surfaces
    float skyVisibility = max(normal.y * 0.5 + 0.5, 0.15);
    
    // Ambient color varies with time of day
    vec3 ambientDay   = mix(vec3(0.35, 0.45, 0.6), vec3(0.5, 0.6, 0.8), skyVisibility);
    vec3 ambientDusk  = mix(vec3(0.2, 0.12, 0.08), vec3(0.35, 0.2, 0.15), skyVisibility);
    vec3 ambientNight = mix(vec3(0.01, 0.015, 0.025), vec3(0.02, 0.03, 0.06), skyVisibility);
    
    float duskAmount = smoothstep(-0.15, 0.05, sunElev) * (1.0 - smoothstep(0.05, 0.25, sunElev));
    vec3 ambientColor = mix(ambientNight, ambientDay, dayAmount) + ambientDusk * duskAmount;
    
    // Stronger ambient for more natural fill light (shadows shouldn't be pitch black)
    vec3 ambient = diffuseAlbedo * ambientColor * AMBIENT_FACTOR * (0.3 + 0.7 * ao);

    // --- Local block lighting ---
// gExtraRaw.r remains the Minecraft blocklight value as a guide/debug signal,
// but it is no longer a lighting source. Local lighting should come from the
// explicit section-light table/probe cache, not from OpenGL's scalar lightmap.
float blocklightRaw = clamp(gExtraRaw.r, 0.0, 1.0);

vec3 blocklightRt = vec3(0.0);
vec3 sectionLightProbeIncident = vec3(0.0);
vec3 sectionLightProbe = vec3(0.0);
float sectionLightProbeConfidence = 0.0;
vec3 sectionLightTable = vec3(0.0);
vec3 sectionLightDirectional = vec3(0.0);
bool sectionLightSurfaceRtResolved = false;
float directEmissionLuma = dot(directEmission, vec3(0.2126, 0.7152, 0.0722));
bool emissiveFirstHitSurface = directEmissionLuma > 0.0001;
vec3 sectionLightProbeNormal = normalizeSectionLightProbeNormal(normal);
if (dot(sectionLightProbeNormal, viewDir) < 0.0) {
    sectionLightProbeNormal = -sectionLightProbeNormal;
}
vec3 sectionLightProbeSamplePos = shadingWorldPos;

#if RT_BLOCKLIGHT_PROBES != 0 && BLOCKLIGHT_SAMPLES > 0
if (!emissiveFirstHitSurface) {
    uint blocklightRtSeed = hashUint(worldLightingSeed, 0x51ed270bu);
    blocklightRt = sampleBlockLightRT(
        shadingWorldPos,
        normal,
        diffuseAlbedo,
        F0,
        roughness,
        metallic,
        viewDir,
        SPECULAR_INTENSITY,
        BLOCKLIGHT_SAMPLES,
        blocklightRtSeed);
}
#endif

if (!emissiveFirstHitSurface) {
#if SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0
    float probeSurfaceOffset = min(max(SECTION_LIGHT_PROBE_SURFACE_OFFSET, 0.35), 0.75);
#else
    float probeSurfaceOffset = min(max(SECTION_LIGHT_PROBE_SURFACE_OFFSET, 0.0), 0.75);
#endif
    sectionLightProbeSamplePos = shadingWorldPos + sectionLightProbeNormal * probeSurfaceOffset;

#if SECTION_LIGHT_PROBE_RT_SURFACE_CACHE != 0 && SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0 && SECTION_LIGHT_TABLE_ENABLE != 0 && SECTION_LIGHT_SPARSE_RT_SAMPLES > 0
    sectionLightSurfaceRtResolved = sampleSectionLightSurfaceRt(
        shadingWorldPos,
        sectionLightProbeNormal,
        sectionLightProbeIncident);
    if (sectionLightSurfaceRtResolved) {
        sectionLightProbeConfidence = 1.0;
    }
#else
    populateSectionLightProbeRtCacheCorners(sectionLightProbeSamplePos);
    sampleSectionLightProbeVolumeData(
        sectionLightProbeSamplePos,
        sectionLightProbeNormal,
        sectionLightProbeIncident,
        sectionLightProbeConfidence);
#endif

    vec3 sectionLightProbeDiffuse = sectionLightProbeDiffuseResponse(diffuseAlbedo, F0, metallic);
    sectionLightProbe = max(sectionLightProbeIncident * sectionLightProbeDiffuse, vec3(0.0));
    float sectionLightProbeLuma = dot(sectionLightProbe, vec3(0.2126, 0.7152, 0.0722));

#if SECTION_LIGHT_PROBE_RT_SURFACE_CACHE != 0 && SECTION_LIGHT_PROBE_RT_CACHE_ENABLE != 0 && SECTION_LIGHT_TABLE_ENABLE != 0 && SECTION_LIGHT_TABLE_FALLBACK_ENABLE != 0 && SECTION_LIGHT_SPARSE_RT_SAMPLES > 0
    float sectionLightRtFallbackLumaFloor = max(
        float(SECTION_LIGHT_PROBE_SURFACE_VALIDATION_LUMA),
        float(SECTION_LIGHT_SPARSE_RT_LEAK_LUMA));
    bool sectionLightRtCacheNeedsFallback =
        !sectionLightSurfaceRtResolved
        || sectionLightProbeLuma <= sectionLightRtFallbackLumaFloor;
    if (sectionLightRtCacheNeedsFallback) {
        vec3 sectionLightTableFallback = sampleSectionLightTable(
            shadingWorldPos,
            sectionLightProbeNormal,
            diffuseAlbedo,
            F0,
            roughness,
            metallic,
            viewDir,
            SPECULAR_INTENSITY);
        float sectionLightTableFallbackLuma =
            dot(sectionLightTableFallback, vec3(0.2126, 0.7152, 0.0722));
        if (!sectionLightSurfaceRtResolved) {
            sectionLightTable = sectionLightTableFallback;
        } else if (sectionLightTableFallbackLuma > max(
                sectionLightProbeLuma * 1.25,
                sectionLightRtFallbackLumaFloor)) {
            sectionLightTable = max(sectionLightTableFallback - sectionLightProbe, vec3(0.0));
        }
    }
#endif

#if SECTION_LIGHT_PROBE_SURFACE_VALIDATION != 0 && SECTION_LIGHT_PROBE_RT_SURFACE_CACHE == 0 && SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0 && SECTION_LIGHT_TABLE_ENABLE != 0 && SECTION_LIGHT_SPARSE_RT_SAMPLES > 0
    bool validateCachedProbeSurface =
        sectionLightProbeLuma > float(SECTION_LIGHT_PROBE_SURFACE_VALIDATION_LUMA);
    bool fallbackSparseSurface =
        SECTION_LIGHT_PROBE_SURFACE_FALLBACK != 0
        && sectionLightProbeLuma <= float(SECTION_LIGHT_PROBE_SURFACE_VALIDATION_LUMA)
        && blocklightRaw > float(SECTION_LIGHT_PROBE_SURFACE_FALLBACK_BLOCKLIGHT);
    if (validateCachedProbeSurface || fallbackSparseSurface) {
        vec3 surfaceVisibleIncidentRadiance;
        float surfaceVisibilityRatio = sampleSectionLightSparseRt(
            shadingWorldPos,
            sectionLightProbeNormal,
            surfaceVisibleIncidentRadiance);
        if (surfaceVisibilityRatio >= 0.0) {
            vec3 surfaceVisibleProbe = max(surfaceVisibleIncidentRadiance * sectionLightProbeDiffuse, vec3(0.0));
            float surfaceVisibleLuma = dot(surfaceVisibleProbe, vec3(0.2126, 0.7152, 0.0722));

            if (validateCachedProbeSurface) {
                float validationRatio = clamp(
                    float(SECTION_LIGHT_PROBE_SURFACE_VALIDATION_RATIO),
                    1.0,
                    4.0);
                float maxSurfaceValidatedLuma = surfaceVisibleLuma * validationRatio;
                if (sectionLightProbeLuma > maxSurfaceValidatedLuma && sectionLightProbeLuma > 0.0001) {
                    sectionLightProbe *= maxSurfaceValidatedLuma / sectionLightProbeLuma;
                    sectionLightProbeLuma = dot(sectionLightProbe, vec3(0.2126, 0.7152, 0.0722));
                }
            }

            if (fallbackSparseSurface && surfaceVisibleLuma > sectionLightProbeLuma) {
                sectionLightProbe = surfaceVisibleProbe;
                sectionLightProbeLuma = surfaceVisibleLuma;
            }
        }
    }
#endif

#if SECTION_LIGHT_SPARSE_RT_CORRECTION != 0 && SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0 && SECTION_LIGHT_SPARSE_RT_SAMPLES > 0
    float sparseVisibilityRatio = -1.0;
    float probeConfidenceThreshold = clamp(SECTION_LIGHT_SPARSE_RT_CONFIDENCE_THRESHOLD, 0.0, 1.0);
    float probeConfidenceDeficit = 1.0 - smoothstep(
        probeConfidenceThreshold * 0.55,
        max(probeConfidenceThreshold, 0.0001),
        sectionLightProbeConfidence);
    float darkBlocklightGuide = 1.0 - smoothstep(0.035, 0.16, blocklightRaw);
    bool sparseRtCorrectionCandidate =
        sectionLightProbeLuma > SECTION_LIGHT_SPARSE_RT_LEAK_LUMA
        && probeConfidenceDeficit > 0.0
        && (darkBlocklightGuide > 0.45 || refractiveSurface || surfaceFresnelLuma > 0.12);

    if (sparseRtCorrectionCandidate) {
        sparseVisibilityRatio = sampleSectionLightSparseVisibilityRatio(
            shadingWorldPos,
            sectionLightProbeNormal);
        if (sparseVisibilityRatio >= 0.0) {
            float correctionBlend = clamp(
                probeConfidenceDeficit * (0.35 + 0.65 * darkBlocklightGuide),
                0.0,
                0.82);
            sectionLightProbe *= mix(1.0, sparseVisibilityRatio, correctionBlend);
        }
    }
#endif

#if SECTION_LIGHT_TABLE_FALLBACK_ENABLE != 0 && SECTION_LIGHT_PROBE_RT_CACHE_ENABLE == 0
    if (dot(abs(sectionLightProbeIncident), vec3(1.0)) <= 0.0001) {
        sectionLightTable = sampleSectionLightTable(
            shadingWorldPos,
            sectionLightProbeNormal,
            diffuseAlbedo,
            F0,
            roughness,
            metallic,
            viewDir,
            SPECULAR_INTENSITY);
    }
#endif

#if SECTION_LIGHT_PROBE_RT_SURFACE_CACHE != 0 && SECTION_LIGHT_TABLE_FALLBACK_ENABLE == 0
    // Exact surface RT already applies source falloff and visibility. The probe-only
    // source guide uses a separate candidate sample and can introduce false seams.
    sectionLightDirectional = sectionLightProbe;
#else
    sectionLightDirectional = clampSectionLightToSourceShape(
        shadingWorldPos,
        sectionLightProbe + sectionLightTable);
#endif
}

imageStore(blocklightDetailImage, screenCoord,
    vec4(
        blocklightRt + sectionLightDirectional + directEmission,
        max(max(clamp(length(sectionLightDirectional) / max(SECTION_LIGHT_PROBE_INTENSITY, 0.001), 0.0, 1.0),
                clamp(length(blocklightRt) / EMISSIVE_SURFACE_INTENSITY, 0.0, 1.0)),
            clamp(length(directEmission) / EMISSIVE_SURFACE_INTENSITY, 0.0, 1.0))));

    // --- Minimum lighting floor (prevents pitch black shadows) ---
    vec3 minLight = diffuseAlbedo * MIN_LIGHTING * (0.2 + 0.8 * ao) * 0.08;
   
    // --- Final Compositing ---
    vec3 finalLighting = directEmission
        + directSunLighting
        + indirectContrib * diffuseAlbedo
        + ambient
        + blocklightRt + sectionLightDirectional
        + specularEnvContrib // Environment reflections for metals
        + minLight;

    vec4 volume = integrateVolumetrics(
        origin,
        direction,
        viewDist,
        lightDir,
        sunColor,
        hashUint(worldLightingSeed, 0x68bc21ebu));
    finalLighting = finalLighting * volume.a + volume.rgb;

    // Firefly clamp — NO tone mapping or gamma here!
    // DLSS Ray Reconstruction needs linear HDR input.
    // Tone mapping + gamma are applied AFTER DLSS in the composite/blit pass.
    finalLighting = clampFirefly(applyLinearColorGrade(finalLighting));

#if ENABLE_DLSS_RR
    imageStore(SpecularHitDepth, originalPixelCoord, vec4(specularHitDistanceGuide));
#endif

    color = vec4(finalLighting, 1.0);
#if SECTION_LIGHT_PROBE_DEBUG_MODE != 0
    sectionLightProbeDebugOutput = debugSectionLightProbeVolume(
        sectionLightProbeSamplePos,
        sectionLightProbeNormal,
        diffuseAlbedo,
        F0,
        roughness,
        metallic,
        viewDir,
        SPECULAR_INTENSITY,
        blocklightRaw);
    sectionLightProbeDebugHasSurface = true;
#endif
  }

  if (pc.debugMode == 1) {
	// DLSS Debug Mode: Show DLSSD inputs
	// debugCellIndex: -1 = grid view (2x3), 0-5 = full-screen single cell
	// Cell index: 0=Albedo, 1=Normals, 2=Depth, 3=Motion, 4=Roughness, 5=Specular F0, 6=Jitter Viewer
	
	// Determine if we're in grid view or full-screen mode
	bool isGridView = (pc.debugCellIndex < 0);
	
	// Cell label colors (unique color for each cell type to identify them)
	// 0: Albedo - Red, 1: Normals - Green, 2: Depth - Blue
	// 3: Motion - Yellow, 4: Roughness - Magenta, 5: Specular F0 - Cyan, 6: Jitter - Orange
	// 7: Final - White, 8: Extras - Gray
	vec3 labelColors[9];
	labelColors[0] = vec3(1.0, 0.0, 0.0); // Albedo - Red
	labelColors[1] = vec3(0.0, 1.0, 0.0); // Normals - Green
	labelColors[2] = vec3(0.0, 0.0, 1.0); // Depth - Blue
	labelColors[3] = vec3(1.0, 1.0, 0.0); // Motion - Yellow
	labelColors[4] = vec3(1.0, 0.0, 1.0); // Roughness - Magenta
	labelColors[5] = vec3(0.0, 1.0, 1.0); // Specular F0 - Cyan
	labelColors[6] = vec3(1.0, 0.5, 0.0); // Jitter - Orange
	labelColors[7] = vec3(1.0, 1.0, 1.0); // Final - White
	labelColors[8] = vec3(0.5, 0.5, 0.5); // Extras - Gray
	
	// Determine which cell to display
	int activeCell;
	vec2 cellUV;
	if (isGridView) {
		// Grid view: determine cell from screen position (3x3 grid)
		int cellX = int(p.x * 3.0);
		int cellY = int(p.y * 3.0);
		cellX = clamp(cellX, 0, 2);
		cellY = clamp(cellY, 0, 2);
		activeCell = cellY * 3 + cellX;
		// Calculate UV within the cell
		cellUV = vec2(p.x * 3.0 - float(cellX), p.y * 3.0 - float(cellY));
	} else {
		// Full-screen mode: show the selected cell
		activeCell = clamp(pc.debugCellIndex, 0, 8);
		cellUV = p;
	}
	
	// Draw label bar at top-left corner of the cell
	float labelBarHeight = isGridView ? (15.0 / launchSize.y) : (30.0 / launchSize.y);
	float labelBarWidth = isGridView ? (75.0 / launchSize.x) : (150.0 / launchSize.x);
	float stripeWidth = isGridView ? (3.0 / launchSize.x) : (5.0 / launchSize.x);
	
	// Adjust for grid view
	if (isGridView) {
		// Calculate position within the cell
		vec2 cellPos = vec2(p.x * 3.0, p.y * 3.0);
		vec2 cellOffset = vec2(float(int(cellPos.x)), float(int(cellPos.y)));
		vec2 localP = cellPos - cellOffset;
		
		bool inStripe = (localP.y < labelBarHeight * 3.0) && (localP.x < stripeWidth * 3.0);
		bool inLabelBg = (localP.y < labelBarHeight * 3.0) && (localP.x < labelBarWidth * 3.0);
		
		if (inStripe) {
			color = vec4(labelColors[activeCell], 1.0);
		} else if (inLabelBg) {
			color = vec4(0.1, 0.1, 0.1, 1.0);
		} else {
			// Display the actual cell content
			color = getDLSSDebugCellContent(activeCell, hit, albedo, normal, worldPos, origin, roughness, F0, cameraRelativePos, cellUV, motionVec, color.rgb, launchSize, gExtraRaw);
		}
	} else {
	// Full-screen mode
	bool inLabelBg = (p.y < labelBarHeight) && (p.x < labelBarWidth);
	bool inStripe = (p.y < labelBarHeight) && (p.x < stripeWidth);

	if (inStripe) {
		color = vec4(labelColors[activeCell], 1.0);
	} else if (inLabelBg) {
		color = vec4(0.1, 0.1, 0.1, 1.0);
	} else {
	// Display the actual cell content
	color = getDLSSDebugCellContent(activeCell, hit, albedo, normal, worldPos, origin, roughness, F0, cameraRelativePos, cellUV, motionVec, color.rgb, launchSize, gExtraRaw);
	}
	}
} else if (pc.debugMode == 2) {
	// BUFFERS Debug Mode: Show 4 quadrants with different debug visualizations
	// debugCellIndex: -1 = grid view (2x2), 0-3 = full-screen single quadrant
	// Layout (in UV space, origin at top-left):
	// Q2 (normals) | Q3 (final lighting)
	// -----------------|------------------
	// Q0 (depth) | Q1 (motion vectors)
	
	// Determine if we're in grid view or full-screen mode
	bool isGridView = (pc.debugCellIndex < 0);
	
	// Determine which quadrant to display
	int activeQuadrant;
	if (isGridView) {
		// Grid view: use the precomputed quadrant
		activeQuadrant = quadrant;
	} else {
		// Full-screen mode: show the selected quadrant
		activeQuadrant = clamp(pc.debugCellIndex, 0, 3);
	}
	
	// Display the quadrant content
	if (activeQuadrant == 0) { // Bottom-Left - Linear Depth
		if (hit) {
			float linearDepth = cameraRelativePos ? length(worldPos) : length(worldPos - origin);
			float normalizedDepth = clamp(linearDepth / 100.0, 0.0, 1.0);
			float depthValue = 1.0 - normalizedDepth;
			color = vec4(depthValue * 0.5, depthValue * 0.8, depthValue, 1.0);
		} else {
			color = vec4(1.0, 0.0, 0.0, 1.0);
		}
	} else if (activeQuadrant == 1) { // Bottom-Right - Motion Vectors
		#if ENABLE_DLSS_RR
		vec2 motionVec = imageLoad(motionVectors, originalPixelCoord).rg;
		float magnitude = length(motionVec);
		vec2 normalizedMV = motionVec / max(launchSize.x, launchSize.y);
		color = vec4(normalizedMV * 0.5 + 0.5, magnitude * 0.1, 1.0);
		#else
		color = vec4(0.0, 1.0, 0.0, 1.0);
		#endif
	} else if (activeQuadrant == 2) { // Top-Left - Blocklight visualization
		if (hit) {
			float bl = gExtraRaw.r;
			color = vec4(bl, bl * 0.5, 1.0 - bl, 1.0);
		} else {
			color = vec4(0.0, 1.0, 1.0, 1.0);
		}
	} else { // quadrant == 3: Top-Right - Final Lighting (noisy output)
		// Show the actual noisy output that DLSSD receives
		// This is what we computed above - just use the color as-is
	}
}
#if VULKANITE_COMPILE_DIAGNOSTICS
else if (pc.debugMode >= 7 && pc.debugMode <= 9) {
    bool dangerousMiss = (comparisonPixelFlags & COMPARISON_FLAG_DANGEROUS_MISS) != 0u;
    bool extraHit = (comparisonPixelFlags & COMPARISON_FLAG_EXTRA_HIT) != 0u;
    bool distanceMismatch = (comparisonPixelFlags & COMPARISON_FLAG_DISTANCE_MISMATCH) != 0u;
    if (pc.debugMode == 8) {
        color.rgb = dangerousMiss ? vec3(1.0, 0.02, 0.0) : color.rgb * 0.16;
    } else if (pc.debugMode == 9) {
        color.rgb = extraHit ? vec3(0.0, 0.45, 1.0) : color.rgb * 0.16;
    } else {
        if (dangerousMiss) {
            color.rgb = mix(color.rgb, vec3(1.0, 0.0, 0.0), 0.85);
        } else if (extraHit) {
            color.rgb = mix(color.rgb, vec3(0.0, 0.4, 1.0), 0.8);
        } else if (distanceMismatch) {
            color.rgb = mix(color.rgb, vec3(1.0, 0.75, 0.0), 0.75);
        }

        // Two compact cumulative-total bars. The first partitions all four hit
        // outcomes; the second partitions agreeing and differing hit distances.
        // Counters persist across frames, so the bars stabilize even though ray
        // invocations within the current dispatch have no global barrier.
        float pixelY = float(originalPixelCoord.y);
        float normalizedX = (float(originalPixelCoord.x) + 0.5) / launchSize.x;
        if (pixelY < 10.0) {
            float total = max(float(atomicAdd(shadowComparisonWords[COMPARISON_TOTAL], 0u)), 1.0);
            float bothEnd = float(atomicAdd(shadowComparisonWords[COMPARISON_BOTH_HIT], 0u)) / total;
            float dangerousEnd = bothEnd
                + float(atomicAdd(shadowComparisonWords[COMPARISON_DANGEROUS_MISS], 0u)) / total;
            float extraEnd = dangerousEnd
                + float(atomicAdd(shadowComparisonWords[COMPARISON_EXTRA_HIT], 0u)) / total;
            color.rgb = normalizedX < bothEnd
                ? vec3(0.05, 0.8, 0.18)
                : (normalizedX < dangerousEnd
                    ? vec3(1.0, 0.0, 0.0)
                    : (normalizedX < extraEnd ? vec3(0.0, 0.4, 1.0) : vec3(0.08)));
        } else if (pixelY < 20.0) {
            float distanceTotal = max(
                float(atomicAdd(shadowComparisonWords[COMPARISON_DISTANCE_AGREE], 0u))
                + float(atomicAdd(shadowComparisonWords[COMPARISON_DISTANCE_MISMATCH], 0u)), 1.0);
            float agreeEnd = float(atomicAdd(
                shadowComparisonWords[COMPARISON_DISTANCE_AGREE], 0u)) / distanceTotal;
            color.rgb = normalizedX < agreeEnd
                ? vec3(0.1, 0.65, 0.22)
                : vec3(1.0, 0.72, 0.0);
        }
    }
} else if (pc.debugMode == 11) {
    if (reflectionComparisonSampled) {
        color.rgb = mix(color.rgb * 0.18, reflectionComparisonTint, 0.82);
    } else {
        // Make a reduced sampling rate visually explicit instead of implying
        // that untraced pixels agree.
        float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
        color.rgb = vec3(luma) * 0.22;
    }

    // Compact color key, left-to-right: triangle-only, procedural-only,
    // distance, geometric normal, material id, sampled albedo, emission, PBR, agree.
    if (originalPixelCoord.y < 6) {
        int key = clamp(int(originalP.x * 9.0), 0, 8);
        color.rgb = key == 0 ? vec3(1.0, 0.01, 0.0)
            : (key == 1 ? vec3(0.0, 0.35, 1.0)
            : (key == 2 ? vec3(1.0, 0.48, 0.0)
            : (key == 3 ? vec3(1.0, 0.0, 0.8)
            : (key == 4 ? vec3(1.0, 0.92, 0.0)
            : (key == 5 ? vec3(0.0, 0.9, 1.0)
            : (key == 6 ? vec3(0.62, 0.1, 1.0)
            : (key == 7 ? vec3(0.55, 1.0, 0.05)
            : vec3(0.04, 0.72, 0.16))))))));
    }
}
#endif
  // When debug mode is off, we just output the computed color

#if SECTION_LIGHT_PROBE_DEBUG_MODE != 0
  color = vec4(sectionLightProbeDebugHasSurface
      ? sectionLightProbeDebugOutput
      : vec3(0.015, 0.02, 0.035), 1.0);
#endif

  imageStore(outputImage, screenCoord, color);
  }
