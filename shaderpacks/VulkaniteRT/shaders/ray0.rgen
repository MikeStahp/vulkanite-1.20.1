layout(binding = 12, rgba16f) uniform image2D outputImage;
layout(binding = 21, rgba16f) uniform image2D blocklightDetailImage;

struct GpuSectionLight {
    ivec4 posRadiusFlags;
    uvec4 colorEmission;
};

layout(binding = 22, std430) readonly buffer SectionLightTableBuffer {
    uvec4 sectionLightHeader; // x=light count, y=active sections, z=version
    GpuSectionLight sectionLightRecords[];
};

layout(binding = 23, std430) readonly buffer SectionLightProbeBuffer {
    ivec4 sectionLightProbeHeader; // x=active pages, y=slot limit, z=version, w=dirty pages at upload
    ivec4 sectionLightProbeRecords[]; // directory records first, then RGB9E5 radiance and R8 confidence pages
};

