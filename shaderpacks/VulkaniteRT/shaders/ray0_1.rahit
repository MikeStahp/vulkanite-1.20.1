#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "/lib/rt/payload.glsl"

layout(location = 0) rayPayloadInEXT Payload payload;
hitAttributeEXT vec2 baryCoord;

layout(set = 1, binding = 0, std430) readonly buffer EntityGeometry {
    uint words[];
} geometryBuffers[];

layout(set = 2, binding = 0) uniform sampler2D entityTextures[256];

const uint WORDS_PER_VERTEX = 16u;
const uint WORDS_PER_QUAD = WORDS_PER_VERTEX * 4u;

uint vertexBase(uint vertexIndex) {
    return uint(gl_PrimitiveID >> 1) * WORDS_PER_QUAD + vertexIndex * WORDS_PER_VERTEX;
}

vec2 vertexUv(uint vertexIndex) {
    uint geometryIndex = nonuniformEXT(gl_InstanceCustomIndexEXT + gl_GeometryIndexEXT);
    uint base = vertexBase(vertexIndex);
    return vec2(
        uintBitsToFloat(geometryBuffers[geometryIndex].words[base + 8u]),
        uintBitsToFloat(geometryBuffers[geometryIndex].words[base + 9u]));
}

void main() {
    uint geometryIndex = nonuniformEXT(gl_InstanceCustomIndexEXT + gl_GeometryIndexEXT);
    uvec2 other = (gl_PrimitiveID & 1) == 0 ? uvec2(1u, 2u) : uvec2(2u, 3u);
    vec3 bary = vec3(1.0 - baryCoord.x - baryCoord.y, baryCoord.x, baryCoord.y);
    vec2 uv = vertexUv(0u) * bary.x
        + vertexUv(other.x) * bary.y
        + vertexUv(other.y) * bary.z;
    uint textureIndex = geometryBuffers[geometryIndex].words[vertexBase(0u) + 11u];
    uint alphaMode = geometryBuffers[geometryIndex].words[vertexBase(0u) + 14u];
    float alpha = texture(entityTextures[nonuniformEXT(textureIndex)], uv).a;

    float threshold = alphaMode == 1u ? 0.1 : 0.01;
    if (alphaMode != 0u && alpha < threshold) {
        ignoreIntersectionEXT;
    }
}
