#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

// Reflection traversal uses the same AABB/occupancy contract as groups 2 and
// 5, but accepts a hit only when the version-2 material tables contain the
// exact cell face needed by the closest-hit shader. Keeping this stage
// separate leaves the version-1 shadow/debug path backward compatible.
layout(set = 1, binding = 0, std430) readonly buffer ProceduralGeometry {
    uint words[];
} geometryBuffers[];

// xyz = object-space face normal, w = uintBitsToFloat(brick-local cell index)
hitAttributeEXT vec4 proceduralHitAttribute;

const uint VOXEL_BRICK_MAGIC = 0x5642524bu;
const uint VOXEL_BRICK_MATERIAL_VERSION = 2u;
const uint INVALID_CELL_MATERIAL = 0xffffu;
const uint INVALID_FACE_MATERIAL = 0xffffffffu;
const uint CELL_REFERENCE_BYTES = 8192u;
const uint CELL_MATERIAL_RECORD_BYTES = 48u;
const uint FACE_MATERIAL_RECORD_BYTES = 32u;
const uint FACE_LAYER_RECORD_BYTES = 48u;
const float DIRECTION_EPSILON = 1.0e-8;
const float BOUNDARY_EPSILON = 1.0e-5;
const float MAX_T = 3.402823e38;

uint geometryIndex() {
    return nonuniformEXT(uint(gl_InstanceCustomIndexEXT) + uint(gl_GeometryIndexEXT));
}

uint payloadWord(uint wordIndex) {
    return geometryBuffers[geometryIndex()].words[wordIndex];
}

uint payloadWordCount() {
    return uint(geometryBuffers[geometryIndex()].words.length());
}

bool tableFits(uint offsetBytes, uint recordCount, uint recordBytes, uint totalBytes) {
    return recordBytes != 0u
        && (offsetBytes & 3u) == 0u
        && offsetBytes <= totalBytes
        && recordCount <= (totalBytes - offsetBytes) / recordBytes;
}

vec3 axisNormal(int axis, float value) {
    vec3 normal = vec3(0.0);
    normal[axis] = value;
    return normal;
}

vec3 fallbackInsideNormal(vec3 direction) {
    vec3 magnitude = abs(direction);
    if (magnitude.x >= magnitude.y && magnitude.x >= magnitude.z) {
        return axisNormal(0, direction.x >= 0.0 ? -1.0 : 1.0);
    }
    if (magnitude.y >= magnitude.z) {
        return axisNormal(1, direction.y >= 0.0 ? -1.0 : 1.0);
    }
    return axisNormal(2, direction.z >= 0.0 ? -1.0 : 1.0);
}

bool faceIndexFromNormal(vec3 normal, out uint faceIndex) {
    if (normal.x > 0.5) {
        faceIndex = 0u;
    } else if (normal.x < -0.5) {
        faceIndex = 1u;
    } else if (normal.y > 0.5) {
        faceIndex = 2u;
    } else if (normal.y < -0.5) {
        faceIndex = 3u;
    } else if (normal.z > 0.5) {
        faceIndex = 4u;
    } else if (normal.z < -0.5) {
        faceIndex = 5u;
    } else {
        return false;
    }
    return true;
}

bool clipSlab(
    int axis,
    float origin,
    float direction,
    float minimum,
    float maximum,
    inout float enterT,
    inout float exitT,
    inout vec3 enterNormal
) {
    if (abs(direction) <= DIRECTION_EPSILON) {
        return origin >= minimum && origin <= maximum;
    }

    float first = (minimum - origin) / direction;
    float second = (maximum - origin) / direction;
    float nearT = min(first, second);
    float farT = max(first, second);
    vec3 nearNormal = axisNormal(axis, direction > 0.0 ? -1.0 : 1.0);
    if (nearT > enterT) {
        enterT = nearT;
        enterNormal = nearNormal;
    }
    exitT = min(exitT, farT);
    return enterT <= exitT + BOUNDARY_EPSILON;
}

bool occupied(uint recordWordBase, uint brickSize, ivec3 cell) {
    uint bitIndex = uint((cell.y * int(brickSize) + cell.z) * int(brickSize) + cell.x);
    uint occupancyWord = payloadWord(recordWordBase + 4u + (bitIndex >> 5u));
    return (occupancyWord & (1u << (bitIndex & 31u))) != 0u;
}

bool sectionOccupied(
    ivec3 sectionCell,
    uint brickSize,
    uint brickCount,
    uint recordOffsetBytes,
    uint recordStrideBytes
) {
    if (any(lessThan(sectionCell, ivec3(0)))
            || any(greaterThanEqual(sectionCell, ivec3(16)))) {
        return false;
    }
    for (uint brick = 0u; brick < brickCount; brick++) {
        uint candidateWordBase = (recordOffsetBytes
            + brick * recordStrideBytes) >> 2u;
        ivec3 candidateOrigin = ivec3(
            int(payloadWord(candidateWordBase + 0u)),
            int(payloadWord(candidateWordBase + 1u)),
            int(payloadWord(candidateWordBase + 2u)));
        ivec3 localCell = sectionCell - candidateOrigin;
        if (all(greaterThanEqual(localCell, ivec3(0)))
                && all(lessThan(localCell, ivec3(int(brickSize))))) {
            return occupied(candidateWordBase, brickSize, localCell);
        }
    }
    return false;
}

bool materialFaceExists(ivec3 sectionCell, vec3 normal) {
    if (any(lessThan(sectionCell, ivec3(0)))
            || any(greaterThanEqual(sectionCell, ivec3(16)))) {
        return false;
    }

    uint faceIndex;
    if (!faceIndexFromNormal(normal, faceIndex)) {
        return false;
    }

    uint cellReferenceOffset = payloadWord(8u);
    uint cellMaterialOffset = payloadWord(9u);
    uint faceMaterialOffset = payloadWord(10u);
    uint cellMaterialCount = payloadWord(12u);
    uint faceMaterialCount = payloadWord(13u);
    uint faceLayerCount = payloadWord(14u);
    uint sectionCellIndex = uint((sectionCell.y * 16 + sectionCell.z) * 16 + sectionCell.x);
    uint cellReferenceWord = payloadWord((cellReferenceOffset >> 2u) + (sectionCellIndex >> 1u));
    uint cellMaterialIndex = (sectionCellIndex & 1u) == 0u
        ? cellReferenceWord & 0xffffu
        : cellReferenceWord >> 16u;
    if (cellMaterialIndex == INVALID_CELL_MATERIAL || cellMaterialIndex >= cellMaterialCount) {
        return false;
    }

    uint cellMaterialWordBase = (cellMaterialOffset
        + cellMaterialIndex * CELL_MATERIAL_RECORD_BYTES) >> 2u;
    uint faceMaterialIndex = payloadWord(cellMaterialWordBase + 4u + faceIndex);
    if (faceMaterialIndex == INVALID_FACE_MATERIAL || faceMaterialIndex >= faceMaterialCount) {
        return false;
    }

    uint faceMaterialWordBase = (faceMaterialOffset
        + faceMaterialIndex * FACE_MATERIAL_RECORD_BYTES) >> 2u;
    uint firstLayer = payloadWord(faceMaterialWordBase + 0u);
    uint layerCount = payloadWord(faceMaterialWordBase + 1u);
    return layerCount != 0u
        && firstLayer <= faceLayerCount
        && layerCount <= faceLayerCount - firstLayer;
}

void reportMaterialHit(
    uint localCellIndex,
    ivec3 sectionCell,
    vec3 normal,
    float hitT
) {
    if (!materialFaceExists(sectionCell, normal)) {
        return;
    }
    proceduralHitAttribute = vec4(normal, uintBitsToFloat(localCellIndex));
    reportIntersectionEXT(hitT, 0u);
}

void main() {
    uint wordCount = payloadWordCount();
    if (wordCount < 16u
            || payloadWord(0u) != VOXEL_BRICK_MAGIC
            || payloadWord(1u) != VOXEL_BRICK_MATERIAL_VERSION) {
        return;
    }

    uint totalBytes = payloadWord(15u);
    uint availableBytes = wordCount * 4u;
    uint cellReferenceOffset = payloadWord(8u);
    uint cellMaterialOffset = payloadWord(9u);
    uint faceMaterialOffset = payloadWord(10u);
    uint faceLayerOffset = payloadWord(11u);
    uint cellMaterialCount = payloadWord(12u);
    uint faceMaterialCount = payloadWord(13u);
    uint faceLayerCount = payloadWord(14u);
    if (totalBytes < 64u || totalBytes > availableBytes
            || cellMaterialCount > INVALID_CELL_MATERIAL
            || cellReferenceOffset < 64u
            || (cellReferenceOffset & 15u) != 0u
            || (cellMaterialOffset & 15u) != 0u
            || (faceMaterialOffset & 15u) != 0u
            || (faceLayerOffset & 15u) != 0u
            || !tableFits(cellReferenceOffset, 1u, CELL_REFERENCE_BYTES, totalBytes)
            || !tableFits(cellMaterialOffset, cellMaterialCount,
                CELL_MATERIAL_RECORD_BYTES, totalBytes)
            || !tableFits(faceMaterialOffset, faceMaterialCount,
                FACE_MATERIAL_RECORD_BYTES, totalBytes)
            || !tableFits(faceLayerOffset, faceLayerCount,
                FACE_LAYER_RECORD_BYTES, totalBytes)
            || cellMaterialOffset < cellReferenceOffset + CELL_REFERENCE_BYTES
            || faceMaterialOffset < cellMaterialOffset
                + cellMaterialCount * CELL_MATERIAL_RECORD_BYTES
            || faceLayerOffset < faceMaterialOffset
                + faceMaterialCount * FACE_MATERIAL_RECORD_BYTES) {
        return;
    }

    uint brickSize = payloadWord(2u);
    uint brickCount = payloadWord(3u);
    uint occupancyWords64 = payloadWord(4u);
    uint recordOffsetBytes = payloadWord(6u);
    uint recordStrideBytes = payloadWord(7u);
    uint primitiveIndex = uint(gl_PrimitiveID);
    uint expectedOccupancyWords64 = brickSize * brickSize * brickSize / 64u;
    uint minimumRecordBytes = 16u + occupancyWords64 * 8u;
    if ((brickSize != 4u && brickSize != 8u && brickSize != 16u)
            || occupancyWords64 != expectedOccupancyWords64
            || primitiveIndex >= brickCount
            || recordOffsetBytes < 64u
            || (recordOffsetBytes & 3u) != 0u
            || (recordStrideBytes & 3u) != 0u
            || recordStrideBytes < minimumRecordBytes
            || !tableFits(recordOffsetBytes, brickCount, recordStrideBytes, totalBytes)
            || cellReferenceOffset < recordOffsetBytes + brickCount * recordStrideBytes) {
        return;
    }

    uint recordWordBase = (recordOffsetBytes + primitiveIndex * recordStrideBytes) >> 2u;
    ivec3 brickOrigin = ivec3(
        int(payloadWord(recordWordBase + 0u)),
        int(payloadWord(recordWordBase + 1u)),
        int(payloadWord(recordWordBase + 2u)));
    if (any(lessThan(brickOrigin, ivec3(0)))
            || any(greaterThan(brickOrigin + ivec3(int(brickSize)), ivec3(16)))) {
        return;
    }

    vec3 brickMinimum = vec3(brickOrigin);
    vec3 brickMaximum = brickMinimum + vec3(float(brickSize));
    vec3 rayOrigin = gl_ObjectRayOriginEXT;
    vec3 rayDirection = gl_ObjectRayDirectionEXT;
    float enterT = gl_RayTminEXT;
    float exitT = gl_RayTmaxEXT;
    vec3 enterNormal = vec3(0.0);
    if (!clipSlab(0, rayOrigin.x, rayDirection.x, brickMinimum.x, brickMaximum.x,
            enterT, exitT, enterNormal)
            || !clipSlab(1, rayOrigin.y, rayDirection.y, brickMinimum.y, brickMaximum.y,
            enterT, exitT, enterNormal)
            || !clipSlab(2, rayOrigin.z, rayDirection.z, brickMinimum.z, brickMaximum.z,
            enterT, exitT, enterNormal)
            || exitT < gl_RayTminEXT
            || enterT > gl_RayTmaxEXT) {
        return;
    }

    enterT = max(enterT, gl_RayTminEXT);
    exitT = min(exitT, gl_RayTmaxEXT);
    if (dot(enterNormal, enterNormal) < 0.5) {
        enterNormal = fallbackInsideNormal(rayDirection);
    }

    float sampleT = min(exitT, enterT + max(BOUNDARY_EPSILON, abs(enterT) * 1.0e-6));
    vec3 relativeSample = clamp(
        rayOrigin + rayDirection * sampleT - brickMinimum,
        vec3(0.0),
        vec3(float(brickSize) - BOUNDARY_EPSILON));
    ivec3 cell = ivec3(floor(relativeSample));
    ivec3 step = ivec3(0);
    vec3 nextBoundaryT = vec3(MAX_T);
    vec3 deltaT = vec3(MAX_T);
    for (int axis = 0; axis < 3; axis++) {
        if (rayDirection[axis] > DIRECTION_EPSILON) {
            step[axis] = 1;
            float boundary = brickMinimum[axis] + float(cell[axis] + 1);
            nextBoundaryT[axis] = (boundary - rayOrigin[axis]) / rayDirection[axis];
            deltaT[axis] = 1.0 / rayDirection[axis];
        } else if (rayDirection[axis] < -DIRECTION_EPSILON) {
            step[axis] = -1;
            float boundary = brickMinimum[axis] + float(cell[axis]);
            nextBoundaryT[axis] = (boundary - rayOrigin[axis]) / rayDirection[axis];
            deltaT[axis] = -1.0 / rayDirection[axis];
        }
    }

    float cellEnterT = enterT;
    vec3 cellEnterNormal = enterNormal;
    bool traversingFromInsideSolid = false;
    for (int iteration = 0; iteration < 64; iteration++) {
        if (occupied(recordWordBase, brickSize, cell)) {
            bool originInsideSolid = iteration == 0 && enterT == gl_RayTminEXT;
            if (originInsideSolid) {
                // Continue through a contiguous run of occupied voxels and
                // report its first outward boundary. Internal cube faces are
                // culled from the triangle reference and must not become
                // artificial procedural hits.
                traversingFromInsideSolid = true;
            }
            ivec3 sectionCell = brickOrigin + cell;
            ivec3 previousCell = sectionCell + ivec3(cellEnterNormal);
            if (!traversingFromInsideSolid
                    && sectionOccupied(previousCell, brickSize, brickCount,
                        recordOffsetBytes, recordStrideBytes)) {
                // This AABB begins in the middle of a contiguous solid run at
                // a macro-brick boundary. Let the DDA seek the outward face.
                traversingFromInsideSolid = true;
            }
            if (!traversingFromInsideSolid) {
                uint localCellIndex = uint(
                    (cell.y * int(brickSize) + cell.z) * int(brickSize) + cell.x);
                reportMaterialHit(
                    localCellIndex,
                    brickOrigin + cell,
                    cellEnterNormal,
                    cellEnterT);
                return;
            }
        }

        float nextT = min(nextBoundaryT.x, min(nextBoundaryT.y, nextBoundaryT.z));
        if (nextT > exitT + BOUNDARY_EPSILON || nextT == MAX_T) {
            return;
        }

        bvec3 tied = lessThanEqual(abs(nextBoundaryT - vec3(nextT)), vec3(BOUNDARY_EPSILON));
        int normalAxis = tied.x ? 0 : (tied.y ? 1 : 2);
        cellEnterNormal = axisNormal(normalAxis, float(-step[normalAxis]));
        cellEnterT = max(nextT, enterT);

        if (traversingFromInsideSolid) {
            ivec3 nextCell = cell;
            for (int axis = 0; axis < 3; axis++) {
                if (tied[axis]) {
                    nextCell[axis] += step[axis];
                }
            }
            bool leavesBrick = any(lessThan(nextCell, ivec3(0)))
                || any(greaterThanEqual(nextCell, ivec3(int(brickSize))));
            bool nextOccupied = leavesBrick
                ? sectionOccupied(brickOrigin + nextCell, brickSize, brickCount,
                    recordOffsetBytes, recordStrideBytes)
                : occupied(recordWordBase, brickSize, nextCell);
            if (!nextOccupied) {
                uint localCellIndex = uint(
                    (cell.y * int(brickSize) + cell.z) * int(brickSize) + cell.x);
                reportMaterialHit(
                    localCellIndex,
                    brickOrigin + cell,
                    axisNormal(normalAxis, float(step[normalAxis])),
                    cellEnterT);
                return;
            }
            if (leavesBrick) {
                // The adjacent macro brick owns the continuation candidate.
                // Its entry-cell check above suppresses the shared internal
                // face and continues toward the first exterior boundary.
                return;
            }
            cell = nextCell;
            for (int axis = 0; axis < 3; axis++) {
                if (tied[axis]) {
                    nextBoundaryT[axis] += deltaT[axis];
                }
            }
            continue;
        }

        // Preserve the triangle-equivalent edge/corner conservatism of the
        // shared shadow DDA by testing every cell touched at a tied boundary.
        uint tiedMask = (tied.x ? 1u : 0u) | (tied.y ? 2u : 0u) | (tied.z ? 4u : 0u);
        for (uint subset = 1u; subset < 8u; subset++) {
            if ((subset & ~tiedMask) != 0u) {
                continue;
            }
            ivec3 adjacentCell = cell;
            int adjacentNormalAxis = -1;
            for (int axis = 0; axis < 3; axis++) {
                if ((subset & (1u << uint(axis))) != 0u) {
                    adjacentCell[axis] += step[axis];
                    if (adjacentNormalAxis < 0) {
                        adjacentNormalAxis = axis;
                    }
                }
            }
            if (any(lessThan(adjacentCell, ivec3(0)))
                    || any(greaterThanEqual(adjacentCell, ivec3(int(brickSize))))
                    || !occupied(recordWordBase, brickSize, adjacentCell)) {
                continue;
            }
            uint localCellIndex = uint(
                (adjacentCell.y * int(brickSize) + adjacentCell.z)
                    * int(brickSize) + adjacentCell.x);
            reportMaterialHit(
                localCellIndex,
                brickOrigin + adjacentCell,
                axisNormal(adjacentNormalAxis, float(-step[adjacentNormalAxis])),
                cellEnterT);
            return;
        }

        for (int axis = 0; axis < 3; axis++) {
            if (tied[axis]) {
                cell[axis] += step[axis];
                nextBoundaryT[axis] += deltaT[axis];
            }
        }
        if (any(lessThan(cell, ivec3(0)))
                || any(greaterThanEqual(cell, ivec3(int(brickSize))))) {
            return;
        }
    }
}
