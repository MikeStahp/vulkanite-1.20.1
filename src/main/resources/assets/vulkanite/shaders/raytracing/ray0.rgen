#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

struct RayPayload {
    vec3 color;
    float hitDistance;
    int hitType;
};

layout(location = 6) rayPayloadEXT RayPayload payload;

layout(std140, binding = 0, set = 0) uniform CameraInfo {
    vec3 corners[4];
    mat4 viewInverse;
    vec4 sunPosition;
    vec4 moonPosition;
    uint frameId;
    uint flags;
    uint world_type;
    mat4 prevViewProj;
    vec4 jitter;
    mat4 curViewProj;
} cam;

layout(binding = 1, set = 0) uniform accelerationStructureEXT tlas;
layout(binding = 6, set = 0, rgba32f) uniform image2D reservoirImage;

layout(binding = 7, set = 0) uniform sampler2D colortex1;
layout(binding = 8, set = 0) uniform sampler2D colortex2;
layout(binding = 9, set = 0) uniform sampler2D colortex3;
layout(binding = 10, set = 0) uniform sampler2D colortex4;
layout(binding = 11, set = 0) uniform sampler2D colortex5;

layout(binding = 12, set = 0, rgba16f) uniform image2D RayTraceData[];
layout(binding = 13, set = 0, rg16f) uniform image2D MotionVectors;
layout(binding = 14, set = 0, r16f) uniform image2D LinearDepth;
layout(binding = 15, set = 0, rgba32f) uniform image2D prevReservoirImage;
layout(binding = 16, set = 0, rgba8) uniform image2D DiffuseAlbedoMetallic;
layout(binding = 17, set = 0, rgba8) uniform image2D SpecularAlbedo;
layout(binding = 18, set = 0, rgba16f) uniform image2D NormalRoughness;
layout(binding = 19, set = 0, r16f) uniform image2D SpecularHitDepth;
layout(binding = 20, set = 0, r16f) uniform image2D FirstHitDepth;
layout(binding = 21, set = 0, rgba16f) uniform image2D BlocklightDetail;

layout(push_constant) uniform PushConstant {
    uvec4 data0;
    uvec4 data1;
    uvec4 data2;
} pushConstants;

const float PI = 3.14159265359;
const float SUN_ANGULAR_RADIUS = 0.034;
const int SHADOW_SAMPLES = 12;
const float SHADOW_BIAS = 0.002;
const float MIN_ROUGHNESS = 0.04;
const float EMISSION_RADIANCE_SCALE = 10.0;

vec2 pixelUv(vec2 launchId, vec2 launchSize) {
    return (launchId + 0.5) / launchSize;
}

ivec2 sourceTexel(sampler2D textureRef, vec2 uv) {
    ivec2 size = textureSize(textureRef, 0);
    return clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
}

vec3 cameraPosition() {
    return cam.viewInverse[3].xyz;
}

bool normalizeSafe(vec3 value, out vec3 normalized) {
    float lengthSquared = dot(value, value);
    if (lengthSquared <= 1e-8 || any(isnan(value)) || any(isinf(value))) {
        normalized = vec3(0.0, 1.0, 0.0);
        return false;
    }
    normalized = value * inversesqrt(lengthSquared);
    return true;
}

vec3 rayDirectionFromUv(vec2 uv) {
    vec3 bottom = mix(cam.corners[0], cam.corners[1], uv.x);
    vec3 top = mix(cam.corners[2], cam.corners[3], uv.x);
    vec3 viewDir = normalize(mix(bottom, top, uv.y));
    return normalize((cam.viewInverse * vec4(viewDir, 0.0)).xyz);
}

bool isSkyPixel(vec3 normal, vec3 cameraRelativePos) {
    return any(isnan(normal)) || any(isinf(normal))
        || any(isnan(cameraRelativePos)) || any(isinf(cameraRelativePos))
        || dot(normal, normal) < 0.01
        || dot(cameraRelativePos, cameraRelativePos) < 1e-8
        || dot(cameraRelativePos, cameraRelativePos) > 100000000.0;
}

bool projectToPixel(mat4 viewProj, vec3 absWorldPos, vec2 launchSize, out vec2 projectedPixel) {
    vec4 clip = viewProj * vec4(absWorldPos, 1.0);
    if (clip.w <= 0.00001 || any(isnan(clip)) || any(isinf(clip))) {
        projectedPixel = vec2(0.0);
        return false;
    }
    vec3 ndc = clip.xyz / clip.w;
    if (any(greaterThan(abs(ndc.xy), vec2(1.25)))) {
        projectedPixel = vec2(0.0);
        return false;
    }
    projectedPixel = (ndc.xy * 0.5 + 0.5) * launchSize;
    return true;
}

vec2 motionPixels(vec2 currentPixel, vec2 previousPixel, vec2 launchSize) {
    return clamp(previousPixel - currentPixel, -launchSize, launchSize);
}

float shadowRayBias(vec3 normal, vec3 lightDir) {
    float grazing = 1.0 - max(dot(normal, lightDir), 0.0);
    return SHADOW_BIAS * mix(1.0, 3.0, grazing);
}

vec2 octEncode(vec3 normal) {
    normal /= max(abs(normal.x) + abs(normal.y) + abs(normal.z), 1e-8);
    vec2 encoded = normal.xy;
    if (normal.z < 0.0) {
        encoded = (1.0 - abs(encoded.yx)) * sign(encoded.xy);
    }
    return encoded;
}

vec3 octDecode(vec2 encoded) {
    vec3 normal = vec3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (normal.z < 0.0) {
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    }
    return normalize(normal);
}

float packShadowHistory(vec3 normal, float visibility, float historyLength) {
    vec4 packed = vec4(
        octEncode(normal) * 0.5 + 0.5,
        clamp(visibility, 0.0, 1.0),
        clamp(historyLength / 8.0, 0.0, 1.0));
    return uintBitsToFloat(packUnorm4x8(packed));
}

float resolveShadowHistory(
        ivec2 pixel,
        vec2 previousPixel,
        bool hasPreviousProjection,
        vec3 absoluteWorldPos,
        vec3 normal,
        float viewDistance,
        float currentVisibility) {
    ivec2 size = imageSize(reservoirImage);
    float visibility = clamp(currentVisibility, 0.0, 1.0);
    float historyLength = 1.0;

    if (hasPreviousProjection &&
            all(greaterThanEqual(previousPixel, vec2(0.0))) &&
            all(lessThan(previousPixel, vec2(size)))) {
        ivec2 previousCoord = clamp(ivec2(floor(previousPixel)), ivec2(0), size - 1);
        vec4 previousData = imageLoad(prevReservoirImage, previousCoord);
        vec4 packed = unpackUnorm4x8(floatBitsToUint(previousData.w));
        vec3 previousNormal = octDecode(packed.xy * 2.0 - 1.0);
        float previousVisibility = packed.z;
        float previousHistoryLength = packed.w * 8.0;

        if (previousHistoryLength >= 0.5 &&
                !any(isnan(previousData.xyz)) &&
                !any(isinf(previousData.xyz)) &&
                dot(previousNormal, normal) > 0.92) {
            vec3 positionDelta = previousData.xyz - absoluteWorldPos;
            float planeDistance = max(abs(dot(positionDelta, normal)),
                                      abs(dot(positionDelta, previousNormal)));
            vec3 tangentNormal = normalize(normal + previousNormal);
            vec3 tangentDelta = positionDelta - tangentNormal * dot(positionDelta, tangentNormal);
            float worldPerPixel = max(viewDistance, 1.0) * 2.0 / float(max(size.y, 1));

            if (planeDistance <= max(0.04, worldPerPixel * 1.5) &&
                    length(tangentDelta) <= max(0.12, worldPerPixel * 2.5)) {
                float retainedHistory = min(previousHistoryLength, 7.0);
                float historyWeight = retainedHistory / (retainedHistory + 1.0);
                float clampedHistory = clamp(previousVisibility, visibility - 0.35, visibility + 0.35);
                visibility = mix(visibility, clampedHistory, historyWeight);
                historyLength = retainedHistory + 1.0;
            }
        }
    }

    imageStore(reservoirImage, pixel, vec4(
        absoluteWorldPos,
        packShadowHistory(normal, visibility, historyLength)));
    return visibility;
}

vec3 sampleSunDisk(vec3 sunDir, int sampleIndex, float rotation) {
    // Opposite pairs cancel directional bias and stay identical across frames
    // and surfaces. Per-surface rotations sparkle as pixel coverage changes.
    const int PAIR_COUNT = SHADOW_SAMPLES / 2;
    int pairIndex = sampleIndex / 2;
    float pairSide = (sampleIndex & 1) == 0 ? 1.0 : -1.0;
    float radius = sqrt((float(pairIndex) + 0.5) / float(PAIR_COUNT)) * SUN_ANGULAR_RADIUS;
    float angle = float(pairIndex) * 2.39996323 + rotation;

    vec3 up = abs(sunDir.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, sunDir));
    vec3 bitangent = cross(sunDir, tangent);
    vec2 diskOffset = pairSide * radius * vec2(cos(angle), sin(angle));
    return normalize(sunDir + diskOffset.x * tangent + diskOffset.y * bitangent);
}

vec3 radianceBlockColorValue(vec3 albedo) {
    return max(albedo, vec3(0.0));
}

vec3 radianceEmitterContribution(vec3 albedo, float emission) {
    if (emission <= 1e-5) {
        return vec3(0.0);
    }
    return radianceBlockColorValue(albedo) * emission * EMISSION_RADIANCE_SCALE;
}

vec3 skyColor(vec3 rayDir) {
    vec3 sunDir;
    vec3 moonDir;
    normalizeSafe(cam.sunPosition.xyz, sunDir);
    normalizeSafe(cam.moonPosition.xyz, moonDir);
    float sunHeight = sunDir.y;
    float dayFactor = smoothstep(-0.1, 0.3, sunHeight);
    float horizon = clamp(rayDir.y * 0.5 + 0.5, 0.0, 1.0);

    vec3 daySky = mix(vec3(0.20, 0.30, 0.50), vec3(0.50, 0.70, 1.00), horizon);
    vec3 nightSky = mix(vec3(0.01, 0.01, 0.03), vec3(0.04, 0.05, 0.10), horizon);
    vec3 color = mix(nightSky, daySky, dayFactor);

    if (dot(rayDir, sunDir) > cos(SUN_ANGULAR_RADIUS)) {
        color += vec3(1.0, 0.95, 0.8) * 8.0;
    }
    if (dot(rayDir, moonDir) > cos(SUN_ANGULAR_RADIUS)) {
        color += vec3(0.8, 0.85, 1.0) * 0.5;
    }

    return color;
}

float hardShadow(vec3 origin, vec3 direction) {
    payload.color = vec3(1.0);
    payload.hitDistance = -1.0;
    payload.hitType = 0;

    traceRayEXT(
        tlas,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xFF,
        0,
        1,
        0,
        origin,
        0.001,
        direction,
        10000.0,
        6
    );

    return payload.hitType == 0 ? 1.0 : 0.0;
}

vec3 debugColor(int mode, vec3 finalColor, vec3 normal, vec2 motion, float depth) {
    if (mode == 1) {
        return vec3(abs(motion) / 16.0, 0.0);
    }
    if (mode == 2) {
        return normal * 0.5 + 0.5;
    }
    if (mode == 3) {
        float d = clamp(depth / 128.0, 0.0, 1.0);
        return vec3(d);
    }
    return finalColor;
}

vec3 pushedSunColor() {
    vec3 color = vec3(
        uintBitsToFloat(pushConstants.data1.y),
        uintBitsToFloat(pushConstants.data1.z),
        uintBitsToFloat(pushConstants.data1.w)
    );
    return length(color) > 0.001 ? color : vec3(1.0, 0.95, 0.8);
}

int pushedDebugMode() {
    return int(pushConstants.data2.y);
}

void writeRadianceDlssSidecars(
    ivec2 pixel,
    vec3 diffuseAlbedo,
    float metallic,
    vec3 specularAlbedo,
    vec3 normal,
    float roughness,
    vec2 motion,
    float firstDepth,
    float specularDepth
) {
    imageStore(DiffuseAlbedoMetallic, pixel, vec4(clamp(diffuseAlbedo, 0.0, 1.0), clamp(metallic, 0.0, 1.0)));
    imageStore(SpecularAlbedo, pixel, vec4(clamp(specularAlbedo, 0.0, 1.0), 1.0));
    imageStore(NormalRoughness, pixel, vec4(normalize(normal) * 0.5 + 0.5, clamp(roughness, MIN_ROUGHNESS, 1.0)));
    imageStore(MotionVectors, pixel, vec4(motion, 0.0, 0.0));
    imageStore(LinearDepth, pixel, vec4(firstDepth, 0.0, 0.0, 0.0));
    imageStore(SpecularHitDepth, pixel, vec4(specularDepth, 0.0, 0.0, 0.0));
    imageStore(FirstHitDepth, pixel, vec4(firstDepth, 0.0, 0.0, 0.0));
}

void main() {
    vec2 launchId = vec2(gl_LaunchIDEXT.xy);
    vec2 launchSize = vec2(gl_LaunchSizeEXT.xy);
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    imageStore(BlocklightDetail, pixel, vec4(0.0));
    vec2 pixelCenter = launchId + vec2(0.5);
    vec2 uv = pixelCenter / launchSize;

    // G-buffer values describe a discrete first-hit surface. Filtering across
    // triangle and sky edges corrupts normals, materials, and reprojection.
    ivec2 sourcePixel = sourceTexel(colortex1, uv);
    vec4 albedoSample = texelFetch(colortex1, sourcePixel, 0);
    vec4 materialSample = texelFetch(colortex2, sourceTexel(colortex2, uv), 0);
    vec4 normalSample = texelFetch(colortex3, sourceTexel(colortex3, uv), 0);
    vec4 worldPosSample = texelFetch(colortex4, sourceTexel(colortex4, uv), 0);
    vec4 extraSample = texelFetch(colortex5, sourceTexel(colortex5, uv), 0);

    vec3 cameraPos = cameraPosition();
    vec3 rawNormal = normalSample.xyz;
    vec3 cameraRelativePos = worldPosSample.xyz;
    vec3 absWorldPos = cameraRelativePos + cameraPos;
    vec3 rayDir = rayDirectionFromUv(uv + (cam.jitter.xy / launchSize));

    vec2 jitteredPixelCenter = pixelCenter + cam.jitter.xy;
    vec2 prevPixel;
    bool hasPreviousProjection = projectToPixel(cam.prevViewProj, absWorldPos, launchSize, prevPixel);
    vec2 motion = hasPreviousProjection
        ? motionPixels(jitteredPixelCenter, prevPixel, launchSize)
        : vec2(0.0);
    float linearDepth = max(dot(cameraRelativePos, -normalize(cam.viewInverse[2].xyz)), 0.0);

    if (isSkyPixel(rawNormal, cameraRelativePos)) {
        imageStore(reservoirImage, pixel, vec4(0.0));
        imageStore(RayTraceData[0], pixel, vec4(skyColor(rayDir), 1.0));
        // Sky/far pixels do not have stable geometric history. Keep them neutral
        // so temporal reconstruction cannot pull sky history across silhouettes.
        writeRadianceDlssSidecars(pixel, vec3(0.0), 0.0, vec3(0.0), vec3(0.0, 1.0, 0.0),
            1.0, vec2(0.0), 10000.0, 10000.0);
        return;
    }

    vec3 normal;
    vec3 viewDir;
    vec3 sunDir;
    if (!normalizeSafe(rawNormal, normal) || !normalizeSafe(-cameraRelativePos, viewDir)
            || !normalizeSafe(cam.sunPosition.xyz, sunDir)) {
        imageStore(reservoirImage, pixel, vec4(0.0));
        imageStore(RayTraceData[0], pixel, vec4(0.0, 0.0, 0.0, 1.0));
        writeRadianceDlssSidecars(pixel, vec3(0.0), 0.0, vec3(0.0), vec3(0.0, 1.0, 0.0),
            1.0, vec2(0.0), 10000.0, 10000.0);
        return;
    }
    if (dot(normal, viewDir) < 0.0) {
        normal = -normal;
    }

    float roughness = clamp(materialSample.a, MIN_ROUGHNESS, 1.0);
    float metallic = clamp(worldPosSample.a, 0.0, 1.0);
    float emission = extraSample.a < -0.5
        ? clamp(-extraSample.a - 1.0, 0.0, 1.0)
        : 0.0;
    float blockLight = clamp(extraSample.r, 0.0, 1.0);
    float nDotL = max(dot(normal, sunDir), 0.0);
    float sunVisibility = 0.0;
    if (nDotL > 0.0) {
        vec3 rayOrigin = cameraRelativePos + normal * shadowRayBias(normal, sunDir);
        float sampleRotation = float(cam.frameId & 3u) * (0.5 * PI);
        for (int sampleIndex = 0; sampleIndex < SHADOW_SAMPLES; sampleIndex++) {
            vec3 shadowDirection = sampleSunDisk(sunDir, sampleIndex, sampleRotation);
            sunVisibility += hardShadow(rayOrigin, shadowDirection);
        }
        sunVisibility /= float(SHADOW_SAMPLES);
    }
    sunVisibility = resolveShadowHistory(
        pixel,
        prevPixel,
        hasPreviousProjection,
        absWorldPos,
        normal,
        linearDepth,
        sunVisibility);

    vec3 albedo = max(albedoSample.rgb, vec3(0.0));
    vec3 sunTint = pushedSunColor();

    vec3 halfVec;
    normalizeSafe(viewDir + sunDir, halfVec);
    float nDotV = max(dot(normal, viewDir), 0.001);
    float nDotH = max(dot(normal, halfVec), 0.0);
    float vDotH = max(dot(viewDir, halfVec), 0.0);
    float alpha = roughness * roughness;
    float alphaSquared = alpha * alpha;
    float denominator = nDotH * nDotH * (alphaSquared - 1.0) + 1.0;
    float distribution = alphaSquared / max(PI * denominator * denominator, 1e-5);
    float geometryK = (roughness + 1.0) * (roughness + 1.0) * 0.125;
    float geometryV = nDotV / mix(nDotV, 1.0, geometryK);
    float geometryL = nDotL / mix(nDotL, 1.0, geometryK);
    vec3 f0 = clamp(materialSample.rgb, vec3(0.0), vec3(1.0));
    if (max(max(f0.r, f0.g), f0.b) <= 0.0001) {
        f0 = mix(vec3(0.04), albedo, metallic);
    }
    vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vDotH, 5.0);
    vec3 specularBrdf = distribution * geometryV * geometryL * fresnel
        / max(4.0 * nDotV * max(nDotL, 0.001), 1e-5);
    vec3 diffuseBrdf = (1.0 - fresnel) * (1.0 - metallic) * albedo / PI;

    float blocklightExtended = clamp(pow(blockLight, 0.72) * 1.45, 0.0, 1.0);
    float blocklightFloor = blockLight > 0.003 ? 0.08 : 0.0;
    vec3 emissiveContribution = radianceEmitterContribution(albedo, emission);
    vec3 blocklightContribution = albedo * max(blocklightExtended, blocklightFloor) * 1.15;
    imageStore(BlocklightDetail, pixel, vec4(blocklightContribution + emissiveContribution, blockLight));
    vec3 ambient = albedo * 0.08 * 0.35 + blocklightContribution;
    vec3 direct = (diffuseBrdf + specularBrdf) * sunTint * nDotL * sunVisibility;
    vec3 finalColor = ambient + direct + emissiveContribution;
    finalColor = min(finalColor, vec3(16.0));

    imageStore(RayTraceData[0], pixel, vec4(debugColor(pushedDebugMode(), finalColor, normal, motion, linearDepth), 1.0));
    writeRadianceDlssSidecars(pixel, albedo, metallic, f0, normal, roughness, motion, linearDepth, linearDepth);
}
