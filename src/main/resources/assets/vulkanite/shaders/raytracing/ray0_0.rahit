#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

// Ray payload
struct RayPayload {
    vec3 color;
    vec3 origin;
    vec3 direction;
    float distance;
    uint depth;
    uint seed;
};

layout(location = 0) rayPayloadInEXT RayPayload payload;
layout(location = 0) hitAttributeEXT vec2 attribs;

// Textures
layout(binding = 4, set = 0) uniform sampler2D gbufferAlbedo;
layout(binding = 11, set = 0) uniform sampler2D alphaTexture;

// Material data
layout(binding = 9, set = 0) uniform SceneData {
    uint indexOffset;
    uint vertexOffset;
    uint materialID;
} scene;

void main() {
    // Perform alpha testing
    vec4 alphaData = texture(alphaTexture, attribs);
    float alpha = alphaData.a;
    
    // If alpha is below threshold, ignore this hit
    if (alpha < 0.5) {
        ignoreIntersectionEXT;
    }
    
    // Otherwise, continue with normal processing
    // (closest hit shader will be called)
}