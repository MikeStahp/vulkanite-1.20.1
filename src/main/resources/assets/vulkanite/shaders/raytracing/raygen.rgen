#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

// ============================================================================
// Vulkanite RT - Ray Generation Shader with G-buffer Integration
// ============================================================================
// This shader orchestrates the hybrid rendering pipeline by:
// 1. Reading G-buffer data from the rasterization pass
// 2. Tracing primary rays for sky pixels
// 3. Tracing secondary rays for lighting on geometry pixels
// 4. Combining G-buffer data with RT lighting
//
// All descriptor bindings match VULKANITE_RT_SHADER_BINDING_SPECIFICATION.md
// ============================================================================

// Include utility libraries
#include "lib/utils.glsl"
#include "lib/lighting.glsl"

// ============================================================================
// Ray Payload Structure
// ============================================================================
// Uses location = 6 to match Java trace calls and closesthit.rchit
// The payload carries data between raygen, closesthit, and miss shaders

// Ray Payload Structure (Defined in lib/lighting.glsl)
// struct RayPayload { ... };

layout(location = 6) rayPayloadEXT RayPayload payload;

// ============================================================================
// Descriptor Bindings (Set 0) - Must match Java specification exactly
// ============================================================================
// Reference: VULKANITE_RT_SHADER_BINDING_SPECIFICATION.md Section 1.1

// Binding 0: CameraInfo UBO (Defined in lib/lighting.glsl)
// layout(std140, binding = 0, set = 0) uniform CameraInfo { ... } cam;

// Binding 1: Top-Level Acceleration Structure (TLAS)
layout(binding = 1, set = 0) uniform accelerationStructureEXT tlas;

// Binding 2: Reserved/Unused - DO NOT USE

// Binding 3: Block Atlas (Albedo)
layout(binding = 3, set = 0) uniform sampler2D blockAtlas0;

// Binding 4: Block Atlas (Normal/PBR)
layout(binding = 4, set = 0) uniform sampler2D blockAtlas1;

// Binding 5: Block Atlas (Specular/PBR)
layout(binding = 5, set = 0) uniform sampler2D blockAtlas2;

// Binding 6: Intermediate Render Target (storage image array)
layout(binding = 6, set = 0, rgba16f) uniform image2D RayTraceIntermediate[];

// Binding 7: G-Buffer colortex1 (Albedo)
layout(binding = 7, set = 0) uniform sampler2D colortex1;

// Binding 8: G-Buffer colortex2 (Material - Roughness, Metallic, Specular, Emission)
layout(binding = 8, set = 0) uniform sampler2D colortex2;

// Binding 9: G-Buffer colortex3 (Normal)
layout(binding = 9, set = 0) uniform sampler2D colortex3;

// Binding 10: G-Buffer colortex4 (World Position)
layout(binding = 10, set = 0) uniform sampler2D colortex4;

// Binding 11: G-Buffer colortex5 (Extra - Lightmap/AO)
layout(binding = 11, set = 0) uniform sampler2D colortex5;

// Binding 12: Final Output Target (storage image array)
layout(binding = 12, set = 0, rgba16f) uniform image2D RayTraceData[];

// Binding 13: Motion Vectors for DLSS (RG16F)
layout(binding = 13, set = 0, rg16f) uniform image2D MotionVectors;

// Binding 14: Linear Depth for DLSS (R32F)
layout(binding = 14, set = 0, r32f) uniform image2D LinearDepth;

// ============================================================================
// Constants
// ============================================================================

const float RAY_MISS_INDICATOR = -1.0;  // Indicates ray miss in payload
const float BIAS = 0.001;               // Ray origin bias to avoid self-intersection
const float SUN_ANGULAR_RADIUS = 0.0047; // Sun angular radius in radians (~0.27 degrees)

// ============================================================================
// Helper Functions
// ============================================================================

/// Calculates normalized screen-space UV coordinates from launch ID
/// @param launchID The current pixel coordinate (gl_LaunchIDEXT)
/// @param launchSize The total launch size (gl_LaunchSizeEXT)
/// @return Normalized UV coordinates in [0, 1] range
vec2 calculateUV(vec2 launchID, vec2 launchSize) {
    return (launchID + 0.5) / launchSize;
}

/// Calculates the primary ray direction from camera corners
/// Uses bilinear interpolation of the projection corners
/// @param uv Normalized screen-space UV coordinates
/// @return Ray direction in world space
vec3 calculateRayDirection(vec2 uv) {
    // Bilinear interpolation of the 4 corner vectors
    // corners[0] = top-left, corners[1] = top-right
    // corners[2] = bottom-left, corners[3] = bottom-right
    vec3 cornerTL = cam.corners[0];
    vec3 cornerTR = cam.corners[1];
    vec3 cornerBL = cam.corners[2];
    vec3 cornerBR = cam.corners[3];
    
    // Interpolate along top and bottom edges
    vec3 top = mix(cornerTL, cornerTR, uv.x);
    vec3 bottom = mix(cornerBL, cornerBR, uv.x);
    
    // Interpolate between top and bottom
    vec3 rayDir = mix(bottom, top, uv.y);
    
    return normalize(rayDir);
}

/// Extracts camera position from the viewInverse matrix
/// @return Camera position in world space
vec3 getCameraPosition() {
    return cam.viewInverse[3].xyz;
}

/// Checks if a pixel is sky/invalid based on G-buffer data
/// @param normal The surface normal from G-buffer
/// @param worldPos The world position from G-buffer
/// @return True if the pixel represents sky or invalid data
bool isSkyPixel(vec3 normal, vec3 worldPos) {
    // Sky pixels typically have zero or near-zero normal
    if (length(normal) < 0.1) return true;
    
    // Sky pixels may have extreme Y values or zero position
    if (length(worldPos) < EPSILON) return true;
    
    // Check for very far distances (sky box)
    if (length(worldPos) > 10000.0) return true;
    
    return false;
}



/// Calculates sky color for miss rays
/// @param rayDir The ray direction in world space
/// @return Sky color for the given direction
vec3 calculateSkyColor(vec3 rayDir) {
    // Simple sky gradient based on ray direction Y component
    float t = max(0.0, rayDir.y);
    
    // Horizon color (darker) to zenith color (lighter)
    vec3 horizonColor = vec3(0.2, 0.3, 0.5);
    vec3 zenithColor = vec3(0.4, 0.6, 1.0);
    
    vec3 skyColor = mix(horizonColor, zenithColor, t);
    
    // Check for sun disk
    vec3 sunDir = normalize(cam.sunPosition.xyz);
    float sunDot = max(dot(rayDir, sunDir), 0.0);
    
    if (sunDot > cos(SUN_ANGULAR_RADIUS)) {
        // Sun disk - bright yellowish-white
        return vec3(1.0, 0.95, 0.8) * 10.0;
    }
    
    // Check for moon disk
    vec3 moonDir = normalize(cam.moonPosition.xyz);
    float moonDot = max(dot(rayDir, moonDir), 0.0);
    
    if (moonDot > cos(SUN_ANGULAR_RADIUS)) {
        // Moon disk - dim bluish-white
        return vec3(0.9, 0.9, 1.0) * 0.5;
    }
    
    return skyColor;
}

// ============================================================================
// Ray Generation Entry Point
// ============================================================================

void main() {
    // =========================================================================
    // Step 1: Calculate pixel coordinates and UV
    // =========================================================================
    
    vec2 launchID = vec2(gl_LaunchIDEXT.xy);
    vec2 launchSize = vec2(gl_LaunchSizeEXT.xy);
    
    // Bounds check
    if (launchID.x >= launchSize.x || launchID.y >= launchSize.y) {
        return;
    }
    
    // Calculate normalized UV coordinates
    vec2 uv = calculateUV(launchID, launchSize);
    
    // =========================================================================
    // Step 2: Read G-buffer data for hybrid rendering
    // =========================================================================
    
    // Read G-buffer textures
    vec4 albedoSample = texture(colortex1, uv);
    vec4 materialSample = texture(colortex2, uv);
    vec4 normalSample = texture(colortex3, uv);
    vec4 worldPosSample = texture(colortex4, uv);
    vec4 extraSample = texture(colortex5, uv);
    
    vec3 albedo = albedoSample.rgb;
    vec3 normal = normalSample.rgb;
    vec3 worldPos = worldPosSample.rgb;
    vec2 lightmap = extraSample.rg;
    
    // Material properties from G-buffer
    // R = roughness, G = metallic, B = specular, A = emission
    float roughness = materialSample.r;
    float metallic = materialSample.g;
    float specular = materialSample.b;
    float emission = materialSample.a;
    
    // =========================================================================
    // Step 3: Check for sky/invalid pixels
    // =========================================================================
    
    bool isSky = isSkyPixel(normal, worldPos);
    
    if (isSky) {
        // =====================================================================
        // Sky Pixel: Trace primary ray for environment/sky color
        // =====================================================================
        
        // Get camera position and calculate ray direction
        vec3 cameraPos = getCameraPosition();
        vec3 rayDirection = calculateRayDirection(uv);
        
        // Trace primary ray (will hit miss shader for sky)
        payload.color = vec3(0.0);
        payload.hitDistance = RAY_MISS_INDICATOR;
        payload.hitType = 0;
        
        traceRayEXT(
            tlas,
            gl_RayFlagsNoneEXT,
            0xFF,
            0,
            1,
            0,
            cameraPos,
            0.001,
            rayDirection,
            10000.0,
            6
        );
        
        // Use miss shader result or fallback sky color
        vec3 skyColor = (payload.hitType == 0) ? payload.color : calculateSkyColor(rayDirection);
        
        // Apply tone mapping and gamma correction
        // vec3 finalColor = toneMapACES(skyColor); // DISABLE: Tone mapping is done after DLSS
        // finalColor = toGammaSpace(finalColor); // DISABLE: Gamma correction is done after DLSS
        vec3 finalColor = skyColor; // Pass linear color to DLSS
        
        // Write final color to output image
        // NOTE: Output to DLSS must be LINEAR space, not Gamma space!
        imageStore(RayTraceData[0], ivec2(launchID), vec4(finalColor, 1.0));
        
        // Calculate and write Motion Vectors for Sky
        // Use a far point in ray direction to simulate sky motion (rotation only)
        vec3 farPos = getCameraPosition() + rayDirection * 1000.0;
        vec4 prevClipSky = cam.prevViewProj * vec4(farPos, 1.0);
        vec3 prevNDCSky = prevClipSky.xyz / prevClipSky.w;
        vec2 prevUVSky = prevNDCSky.xy * 0.5 + 0.5;
        vec2 skyMotion = (uv - prevUVSky);
        
        // Store UV space difference (bridge wrapper scales to pixel space)
        imageStore(MotionVectors, ivec2(launchID), vec4(skyMotion, 0.0, 0.0));
        
        // Write Linear Depth for Sky (Far Plane)
        imageStore(LinearDepth, ivec2(launchID), vec4(10000.0, 0.0, 0.0, 0.0));
        
        return;
    }
    
    // =========================================================================
    // Step 4: Geometry Pixel - Hybrid Rendering with G-buffer
    // =========================================================================
    
    // For geometry pixels, we use G-buffer data directly and trace secondary rays
    // This is the hybrid rendering approach - skip primary ray trace
    
    // Ensure normal faces the camera
    vec3 cameraPos = getCameraPosition();
    vec3 viewDir = normalize(cameraPos - worldPos);
    
    if (dot(normal, viewDir) < 0.0) {
        normal = -normal;
    }
    
    // Clamp material properties
    roughness = clamp(roughness, 0.04, 1.0);
    metallic = clamp(metallic, 0.0, 1.0);
    
    // =========================================================================
    // Step 5: Calculate lighting layers
    // =========================================================================
    
    // Initialize random seed for this pixel (temporal variation)
    uint seed = hashUint(uint(launchID.x + launchID.y * launchSize.x), cam.frameId);
    
    // --- Layer 0: Unlit Base ---
    vec3 unlitBase = albedo;
    
    // --- Layer 1: Blocklight ---
    // Use lightmap UV from G-buffer extra channel
    vec3 blocklight = calculateBlocklight(lightmap);
    
    // --- Layer 2: Sunlight with Ray-Traced Shadows ---
    // Trace shadow ray toward sun
    vec3 sunDir = normalize(cam.sunPosition.xyz);
    vec3 rayOrigin = worldPos + normal * BIAS;
    
    // Use global payload for shadow ray
    payload.color = vec3(1.0);
    payload.hitDistance = 1000.0;
    payload.hitType = 1; // Assume hit (shadowed) initially
    
    traceRayEXT(
        tlas,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xFF,
        0,
        1,
        0,
        rayOrigin,
        0.001,
        sunDir,
        10000.0,
        6
    );
    
    float sunVisibility = (payload.hitType == 0) ? 1.0 : 0.0;
    vec3 sunlight = calculateSunlight(worldPos, normal, sunVisibility);
    
    // --- Layer 3: Specular (Cook-Torrance BRDF) ---
    vec3 specularContrib = calculateSpecular(albedo, roughness, normal, viewDir, sunDir);
    specularContrib *= sunVisibility;
    
    // --- Optional: GI Ray (cosine-weighted hemisphere sampling) ---
    // Trace one bounce GI ray for indirect diffuse
    vec3 giDir = cosineWeightedHemisphere(normal, seed);
    vec3 giOrigin = worldPos + normal * BIAS;
    
    // Use global payload for GI ray
    payload.color = vec3(0.0);
    payload.hitDistance = RAY_MISS_INDICATOR;
    payload.hitType = 0;
    
    traceRayEXT(
        tlas,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        1,
        0,
        giOrigin,
        0.001,
        giDir,
        10000.0,
        6
    );
    
    // GI contribution (scaled down for energy conservation)
    vec3 gi = payload.color * albedo * 0.5;
    
    // =========================================================================
    // Step 6: Combine all lighting layers
    // =========================================================================
    
    vec3 finalColor = combineLightingLayers(unlitBase, blocklight, sunlight, gi, specularContrib);
    
    // Add emission
    if (emission > 0.0) {
        finalColor += albedo * emission * 25.0; // Emission scale
    }
    
    // =========================================================================
    // Step 7: Apply post-processing and write output
    // =========================================================================
    
    // Apply firefly clamping
    finalColor = clampFirefly(finalColor);
    
    // Apply ACES tone mapping
    // finalColor = toneMapACES(finalColor); // DISABLE: Tone mapping is done after DLSS
    
    // Apply gamma correction (convert to sRGB)
    // finalColor = toGammaSpace(finalColor); // DISABLE: Gamma correction is done after DLSS
    
    // Write final color to output image
    // NOTE: Output to DLSS must be LINEAR space, not Gamma space!
    imageStore(RayTraceData[0], ivec2(launchID), vec4(finalColor, 1.0));
    
    // Calculate and write Motion Vectors for Geometry
    vec4 prevClip = cam.prevViewProj * vec4(worldPos, 1.0);
    vec3 prevNDC = prevClip.xyz / prevClip.w;
    vec2 prevUV = prevNDC.xy * 0.5 + 0.5;
    vec2 motion = (uv - prevUV);
    
    imageStore(MotionVectors, ivec2(launchID), vec4(motion, 0.0, 0.0));
    
    // Write Linear Depth for Geometry (Euclidean distance from camera)
    float dist = distance(worldPos, cameraPos);
    imageStore(LinearDepth, ivec2(launchID), vec4(dist, 0.0, 0.0, 0.0));
    
    // =========================================================================
    // Optional: Debug output to intermediate buffer
    // =========================================================================
    
    #ifdef DEBUG_OUTPUT
    if (RayTraceIntermediate.length() > 0) {
        imageStore(RayTraceIntermediate[0], ivec2(launchID), vec4(finalColor, 1.0));
    }
    #endif
}
