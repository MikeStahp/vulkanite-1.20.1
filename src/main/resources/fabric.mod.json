{
  "schemaVersion": 1,
  "id": "vulkanite",
  "version": "${version}",
  "name": "Vulkanite",
  "description": "A minecraft mod that brings hardware accelerated raytracing and other vulkan features to minecraft java edition",
  "authors": [
    "Cortex"
  ],
  "contact": {},
  "icon": "assets/vulkanite/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.cortex.vulkanite.client.VulkaniteInitializer"
    ]
  },
  "mixins": [
    "vulkanite.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.20.1",
    "java": ">=21",
    "iris": ">=1.7.5",
    "sodium": ">=0.5.11"
  }
}